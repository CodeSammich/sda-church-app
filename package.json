{
  "name": "sda-church-app",
  "main": "expo-router/entry",
  "version": "0.34.15",
  "homepage": "https://codesammich.github.io/sda-church-app",
  "scripts": {
    "build:web": "node scripts/ensure-build-dir.mjs && expo export --platform web --clear --output-dir build/web",
    "check": "npm run typecheck && npm test && npm run check:text-scale && npm run build:web",
    "check:text-scale": "node scripts/check-text-scale-coverage.mjs",
    "download:cuv-audio": "node scripts/download-cuv-audio.mjs",
    "extract:cuv-adventist-manifest": "node scripts/extract-cuv-adventist-audio-manifest.mjs",
    "sync-version": "node public/sync-version.js",
    "test": "jest --runInBand",
    "test:integration:bulletin": "node test/integration/bulletin-api.mjs",
    "test:integration:external": "node test/integration/external-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "deploy": "node public/deploy-web.js --quiet",
    "build:ios": "node scripts/ensure-build-dir.mjs && eas build --platform ios --profile production --local --output build/app-${npm_package_version}-build-$(date +%Y%m%d%H%M%S).ipa",
    "build:ios:eas": "eas build --platform ios --profile production",
    "build:android": "node scripts/ensure-build-dir.mjs && eas build --platform android --profile production --local --output build/app-${npm_package_version}-build-$(date +%Y%m%d%H%M%S).aab",
    "build:android:eas": "eas build --platform android --profile production",
    "build:android:apk": "node scripts/ensure-build-dir.mjs && eas build --platform android --profile preview --local --output build/app-${npm_package_version}-build-$(date +%Y%m%d%H%M%S).apk",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "57.0.20",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "opencc-js": "^1.4.1",
    "pinyin-pro": "^3.29.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^12.3.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eas-cli": "23.2.0",
    "gh-pages": "^6.3.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "clearMocks": true,
    "restoreMocks": true,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-paper|react-native-safe-area-context))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "overrides": {
    "postcss": "^8.5.1"
  },
  "private": true
}
