{
  "name": "sda-church-app",
  "main": "expo-router/entry",
  "version": "1.3.1",
  "homepage": "https://app.nyccsda.org",
  "scripts": {
    "build:web": "node scripts/ensure-build-dir.mjs && expo export --platform web --clear --output-dir build/web",
    "check": "npm run typecheck && npm test && npm run check:text-scale && npm run build:web",
    "check:text-scale": "node scripts/check-text-scale-coverage.mjs",
    "doctor": "expo-doctor",
    "docs:diagram": "node scripts/render-docs-diagrams.mjs",
    "download:cuv-audio": "node scripts/download-cuv-audio.mjs",
    "extract:cuv-adventist-manifest": "node scripts/extract-cuv-adventist-audio-manifest.mjs",
    "extract:cantonese-adventist-manifest": "node scripts/extract-wordproject-audio-manifest.mjs cantonese",
    "extract:rv1909-adventist-manifest": "node scripts/extract-wordproject-audio-manifest.mjs rv1909",
    "sync-version": "node public/sync-version.js",
    "generate:qr": "node scripts/generate-qr.mjs",
    "generate:qr:queens": "npm run generate:qr -- --output build/qr/queens_adventist_giving_qr_code_368x368.jpg",
    "generate:qr:brooklyn": "npm run generate:qr -- --output build/qr/brooklyn_adventist_giving_qr_code_368x368.jpg",
    "test": "jest --runInBand",
    "test:integration:bulletin": "node test/integration/bulletin-api.mjs",
    "test:integration:external": "node test/integration/external-dependencies.mjs",
    "apps-script:push": "node scripts/deploy-apps-script.mjs --push-only",
    "apps-script:deploy": "node scripts/deploy-apps-script.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "deploy": "node public/deploy-web.js --quiet",
    "deploy:dev": "node public/deploy-web.js --preview --quiet",
    "deploy:production": "node public/deploy-web.js --publish --quiet",
    "build:android": "node scripts/build-android-native.mjs",
    "build:android:apk": "node scripts/build-android-native.mjs --apk",
    "build:android:apk:debug": "node scripts/build-android-native.mjs --apk --debug",
    "build:android:apk:debug:arm": "node scripts/build-android-native.mjs --apk --debug --architectures arm",
    "build:android:apk:debug:intel": "node scripts/build-android-native.mjs --apk --debug --architectures intel",
    "build:ios:simulator": "node scripts/build-ios-simulator.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.4.1",
    "expo": "~58.0.16",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.6",
    "expo-doctor": "1.21.5",
    "gh-pages": "^6.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "native",
        "preset": "jest-expo",
        "clearMocks": true,
        "restoreMocks": true,
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        },
        "setupFilesAfterEnv": [
          "<rootDir>/test/setup.ts"
        ],
        "testMatch": [
          "<rootDir>/test/**/*.test.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "\\.web\\.test\\.ts$"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-paper|react-native-safe-area-context))",
          "/node_modules/react-native-reanimated/plugin/"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "clearMocks": true,
        "restoreMocks": true,
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        },
        "testMatch": [
          "<rootDir>/test/**/*.web.test.ts"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-paper|react-native-safe-area-context))",
          "/node_modules/react-native-reanimated/plugin/"
        ]
      }
    ]
  },
  "overrides": {
    "postcss": "^8.5.1",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "private": true
}
