{
  "name": "sda-church-app",
  "main": "expo-router/entry",
  "version": "0.35.0",
  "homepage": "https://codesammich.github.io/sda-church-app",
  "scripts": {
    "build:web": "node scripts/ensure-build-dir.mjs && expo export --platform web --clear --output-dir build/web",
    "check": "npm run typecheck && npm test && npm run check:text-scale && npm run build:web",
    "check:text-scale": "node scripts/check-text-scale-coverage.mjs",
    "download:cuv-audio": "node scripts/download-cuv-audio.mjs",
    "extract:cuv-adventist-manifest": "node scripts/extract-cuv-adventist-audio-manifest.mjs",
    "sync-version": "node public/sync-version.js",
    "test": "jest --runInBand",
    "test:integration:bulletin": "node test/integration/bulletin-api.mjs",
    "test:integration:external": "node test/integration/external-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "deploy": "node public/deploy-web.js --quiet",
    "build:ios": "node scripts/ensure-build-dir.mjs && npx eas-cli@23.2.0 build --platform ios --profile production --local --output build/app-${npm_package_version}-build-$(date +%Y%m%d%H%M%S).ipa",
    "build:ios:eas": "npx eas-cli@23.2.0 build --platform ios --profile production",
    "build:android": "node scripts/ensure-build-dir.mjs && npx expo prebuild --template expo-template-bare-minimum@58.0.0-canary-20260902-26df09e --platform android && npx eas-cli@23.2.0 build --platform android --profile production --local --output build/app-${npm_package_version}-build-$(date +%Y%m%d%H%M%S).aab",
    "build:android:eas": "npx eas-cli@23.2.0 build --platform android --profile production",
    "build:android:apk": "node scripts/ensure-build-dir.mjs && npx expo prebuild --template expo-template-bare-minimum@58.0.0-canary-20260902-26df09e --platform android && npx eas-cli@23.2.0 build --platform android --profile preview --local --output build/app-${npm_package_version}-build-$(date +%Y%m%d%H%M%S).apk",
    "submit:ios": "npx eas-cli@23.2.0 submit --platform ios",
    "submit:android": "npx eas-cli@23.2.0 submit --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.0-canary-20260902-26df09e",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "^58.0.0-canary-20260902-26df09e",
    "expo-asset": "58.0.0-canary-20260902-26df09e",
    "expo-audio": "^58.0.0-canary-20260902-26df09e",
    "expo-blur": "58.0.0-canary-20260902-26df09e",
    "expo-build-properties": "58.0.0-canary-20260902-26df09e",
    "expo-constants": "58.0.0-canary-20260902-26df09e",
    "expo-font": "58.0.0-canary-20260902-26df09e",
    "expo-linear-gradient": "58.0.0-canary-20260902-26df09e",
    "expo-linking": "58.0.0-canary-20260902-26df09e",
    "expo-localization": "58.0.0-canary-20260902-26df09e",
    "expo-router": "58.0.0-canary-20260902-26df09e",
    "expo-sensors": "58.0.0-canary-20260902-26df09e",
    "expo-splash-screen": "58.0.0-canary-20260902-26df09e",
    "expo-status-bar": "58.0.0-canary-20260902-26df09e",
    "expo-system-ui": "58.0.0-canary-20260902-26df09e",
    "expo-web-browser": "58.0.0-canary-20260902-26df09e",
    "opencc-js": "^1.4.1",
    "pinyin-pro": "^3.29.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.87.0",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "~4.27.0",
    "react-native-share": "^12.3.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.12.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "58.0.0-canary-20260902-26df09e",
    "gh-pages": "^6.3.0",
    "jest": "29.7.0",
    "jest-expo": "58.0.0-canary-20260902-26df09e",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "clearMocks": true,
    "restoreMocks": true,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^react-native/asset-registry$": "react-native/src/asset-registry.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-paper|react-native-safe-area-context))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "overrides": {
    "postcss": "^8.5.1"
  },
  "private": true
}
