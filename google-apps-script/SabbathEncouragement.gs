  '犹': { id: 'JUD', label: 'Jude' },
  '启': { id: 'REV', label: 'Revelation' },
});

function getSabbathEncouragementEnglishText_(date) {
  var pageNumber = getSabbathEncouragementPageNumber_(date);
  var cache = CacheService.getScriptCache();
  var cacheKey = "sabbath-encouragement-en-v2-bsb-" + pageNumber;
  var cached = cache.get(cacheKey);
  if (cached) {
    return cached;
  }
  var paragraphs = getSabbathEncouragementPageText_(date).split(/\n\n/);
  var translated = paragraphs.map(function (paragraph) {
    return translateSabbathEncouragementParagraph_(paragraph);
  }).join("\n\n");
  cache.put(cacheKey, translated, 21600);
  return translated;
}

function translateSabbathEncouragementParagraph_(paragraph) {
  var source = String(paragraph || '');
  var replacements = [];
  var withTokens = source;
  var quotePatterns = [
    /「([\s\S]*?)」\s*[（(]([^（）()]*\d+\s*:[^（）()]*)[）)]/g,
    /“([^“”]*?)”\s*[（(]([^（）()]*\d+\s*:[^（）()]*)[）)]/g,
  ];

  quotePatterns.forEach(function (pattern) {
    withTokens = withTokens.replace(pattern, function (match, quote, referenceGroup) {
      var references = parseSabbathBibleReferences_(referenceGroup);
      if (!references.length) {
        return match;
      }
      var token = 'SABBATH_BSB_TOKEN_' + replacements.length;
      replacements.push({ token: token, references: references });
      return token;
    });
  });

  var allReferences = parseSabbathBibleReferences_(source);
  var protectedReferenceCount = replacements.reduce(function (count, replacement) {
    return count + replacement.references.length;
  }, 0);

  // Never send a Bible quotation through LanguageApp. If a paragraph contains
  // a recognizable Bible reference that was not safely isolated by the quote
  // patterns above, return only the exact HelloAO/BSB text instead of risking
  // a mistranslated quotation. Losing machine-translated prose in this rare
  // fallback is intentional: Bible accuracy is more important.
  if (allReferences.length && protectedReferenceCount < allReferences.length) {
    var completeBsb = getSabbathBsbText_(allReferences);
    return completeBsb
      ? '“' + completeBsb + '” (' + formatSabbathBibleReferences_(allReferences) + ', BSB)'
      : '[BSB text unavailable: ' + formatSabbathBibleReferences_(allReferences) + ']';
  }

  // At this point every Bible quotation has been replaced with an opaque token;
  // LanguageApp is now permitted to translate prose only. The tokens are
  // restored with exact BSB text fetched from HelloAO after translation.
  var translated;
  try {
    translated = LanguageApp.translate(withTokens, 'zh', 'en');
  } catch (error) {
    Logger.log('Sabbath encouragement translation failed: ' + error);
    translated = 'English machine translation unavailable.';
  }

  replacements.forEach(function (replacement) {
    var bsb = getSabbathBsbText_(replacement.references);
    var replacementText = bsb
      ? '“' + bsb + '” (' + formatSabbathBibleReferences_(replacement.references) + ', BSB)'
      : '[BSB text unavailable: ' + formatSabbathBibleReferences_(replacement.references) + ']';
    if (translated.indexOf(replacement.token) >= 0) {
      translated = translated.split(replacement.token).join(replacementText);
    } else if (bsb) {
      translated += '\n\nBSB: ' + replacementText;
    }
  });

  if (!replacements.length && allReferences.length) {
    var directBsb = getSabbathBsbText_(allReferences);
    if (directBsb) {
      translated += '\n\nBSB: “' + directBsb + '” (' + formatSabbathBibleReferences_(allReferences) + ', BSB)';
    }
  }
  return translated;
}

function parseSabbathBibleReferences_(referenceGroup) {
  var source = String(referenceGroup || '')
    .replace(/[：]/g, ':')
    .replace(/[，]/g, ',')
    .replace(/[；]/g, ';')
    .replace(/[–—]/g, '-')
    .trim();
  if (!source) {
    return [];
  }

  var aliases = Object.keys(SABBATH_BIBLE_BOOKS_).sort(function (left, right) {
    return right.length - left.length;
  });
  var currentBook = null;
  var currentChapter = null;
  var references = [];
  source.split(';').forEach(function (segment) {
    segment = segment.trim();
    if (!segment) {
      return;
    }
    var bookName = aliases.find(function (alias) {
      return segment.indexOf(alias) === 0;
    });
    if (bookName) {
      currentBook = SABBATH_BIBLE_BOOKS_[bookName];
      segment = segment.substring(bookName.length).trim();
    }
    if (!currentBook) {
      return;
    }

    segment.split(',').forEach(function (part) {
      part = part.trim();
      if (!part) {
        return;
      }
      var withChapter = part.match(/^(\d+)\s*:\s*(\d+)(?:\s*-\s*(\d+))?$/);
      var verseOnly = part.match(/^(\d+)(?:\s*-\s*(\d+))?$/);
      var chapter = withChapter ? Number(withChapter[1]) : currentChapter;
      var verseStart = withChapter ? Number(withChapter[2]) : verseOnly ? Number(verseOnly[1]) : null;
      var verseEnd = withChapter
        ? Number(withChapter[3] || withChapter[2])
        : verseOnly
          ? Number(verseOnly[2] || verseOnly[1])
          : null;
      if (!chapter || !verseStart || !verseEnd || verseEnd < verseStart) {
        return;
      }
      currentChapter = chapter;
      // The source PDF has a confirmed typo, “帖后 2:34”: 2 Thessalonians
      // chapter 2 has no verse 34, so the intended reference is 2:3–4.
      if (currentBook.id === '2TH' && chapter === 2 && verseStart === 34) {
        verseStart = 3;
        verseEnd = 4;
      }
      references.push({
        bookId: currentBook.id,
        bookLabel: currentBook.label,
        chapter: chapter,
        verseStart: verseStart,
        verseEnd: verseEnd,
      });
    });
  });
  return references;
}

function formatSabbathBibleReferences_(references) {
  return references.map(function (reference) {
    var result = reference.bookLabel + ' ' + reference.chapter + ':' + reference.verseStart;
    if (reference.verseEnd !== reference.verseStart) {
      result += '-' + reference.verseEnd;
    }
    return result;
  }).join('; ');
}

function getSabbathBsbText_(references) {
  // Do not use LanguageApp here. This helper intentionally fetches the exact
  // Berean Standard Bible text from HelloAO for every quoted passage.
  if (typeof fetchPhysicalBibleChapter_ !== 'function' || typeof selectPhysicalBibleVerses_ !== 'function') {
    return '';
  }
  return references.map(function (reference) {
    try {
      var chapter = fetchPhysicalBibleChapter_('BSB', reference);
      return selectPhysicalBibleVerses_(chapter, reference).join(' ');
    } catch (error) {
      Logger.log('Sabbath Encouragement BSB lookup failed: ' + error);
      return '';
    }
  }).filter(Boolean).join(' ');
}

function appendBrooklynEncouragementPage_(body, bulletin) {
  appendBookletPage_(
    body,
    function (cell) {
      // Keep all Chinese in this panel regular: no bold and no underline.
      appendSabbathEncouragementColumn_(cell, "安息日勉勵", getSabbathEncouragementPageText_(bulletin.date), 10, false, false, false);
      appendSabbathEncouragementVerseColumn_(
        cell,
        bulletin.brooklyn,
        bulletin.physicalBibleTranslations,
        'chinese',
      );
    },
    function (cell) {
      appendSabbathEncouragementColumn_(cell, "SABBATH ENCOURAGEMENT", getSabbathEncouragementEnglishText_(bulletin.date), 10, true);
      appendSabbathEncouragementVerseColumn_(
        cell,
        bulletin.brooklyn,
        bulletin.physicalBibleTranslations,
        'english',
      );
    },
    false,
  );
}

function appendSabbathEncouragementVerseColumn_(cell, location, bibleTranslations, language) {
  var rule = cell.appendHorizontalRule();
  var ruleParent = rule.getParent();
  if (ruleParent && ruleParent.getType() === DocumentApp.ElementType.PARAGRAPH) {
    ruleParent.asParagraph().setLineSpacing(1);
    ruleParent.asParagraph().setSpacingBefore(0);
    ruleParent.asParagraph().setSpacingAfter(0);
  }

  var referenceLabels = formatPhysicalBibleReferenceLabels_(location, bibleTranslations);
  var verseText = location && location.bibleVerseText ? location.bibleVerseText : {};
  var isEnglish = language === 'english';
  var heading = isEnglish ? "TODAY'S VERSE" : '今日經文';
  var reference = referenceLabels[isEnglish ? 'english' : 'chinese'];
  var text = verseText[isEnglish ? 'english' : 'chinese'] || reference;

  appendSabbathEncouragementVerseText_(
    cell,
    heading,
    SABBATH_ENCOURAGEMENT_HEADING_SIZE,
    isEnglish,
    4,
    false,
  );
  appendSabbathEncouragementVerseText_(cell, reference, 10, true, 4);
  var paragraph = cell.appendParagraph(text);
  paragraph.setAlignment(DocumentApp.HorizontalAlignment.LEFT);
  paragraph.setLineSpacing(1.08);
  paragraph.setSpacingBefore(0);
  paragraph.setSpacingAfter(0);
  var verseTextParagraph = paragraph.editAsText();
  styleSabbathEncouragementText_(verseTextParagraph, 10, false);
}

function appendSabbathEncouragementVerseText_(cell, text, size, bold, spacingAfter, underline) {
  var paragraph = cell.appendParagraph(String(text || ''));
  paragraph.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  paragraph.setLineSpacing(1.08);
  paragraph.setSpacingBefore(0);
  paragraph.setSpacingAfter(spacingAfter || 0);
  var rendered = paragraph.editAsText();
  styleSabbathEncouragementText_(rendered, size, bold);
  if (underline) {
    rendered.setUnderline(true);
  }
}

function appendSabbathEncouragementColumn_(cell, heading, text, size, showDisclaimer, headingBold, headingUnderline) {
  cell.setPaddingLeft(4);
  cell.setPaddingRight(4);
  cell.setPaddingTop(3);
  cell.setPaddingBottom(3);
  appendSabbathEncouragementHeading_(cell, heading, headingBold, headingUnderline);
  if (showDisclaimer) {
    var disclaimer = cell.appendParagraph('Machine-translated from Chinese; may not be fully accurate. Bible quotations use the Berean Standard Bible (BSB).');
    disclaimer.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    disclaimer.setLineSpacing(1);
    disclaimer.setSpacingBefore(0);
    disclaimer.setSpacingAfter(4);
    styleText_(disclaimer.editAsText(), 7, false);
    disclaimer.editAsText().setItalic(true);
  }
  var paragraphs = String(text || "").split(/\n\n/);
  if (paragraphs.length) {
    var lessonHeading = cell.appendParagraph(paragraphs.shift());
    lessonHeading.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
    lessonHeading.setLineSpacing(1);
    lessonHeading.setSpacingBefore(0);
    lessonHeading.setSpacingAfter(4);
    var lessonText = lessonHeading.editAsText();
    styleSabbathEncouragementText_(lessonText, size, false);
    lessonText.setUnderline(false);
  }
  paragraphs.forEach(function (paragraph, index) {
    var rendered = cell.appendParagraph(paragraph);
    rendered.setAlignment(DocumentApp.HorizontalAlignment.LEFT);
    rendered.setLineSpacing(1.08);
    rendered.setSpacingBefore(0);
    rendered.setSpacingAfter(0);
    var renderedText = rendered.editAsText();
    styleSabbathEncouragementText_(renderedText, size, false);
    // The Chinese heading is underlined intentionally, but that style must
    // never leak into the encouragement body paragraphs.
    renderedText.setUnderline(false);
    if (index < paragraphs.length - 1) {
      var gap = cell.appendParagraph(' ');
      gap.setLineSpacing(1);
      gap.setSpacingBefore(0);
      gap.setSpacingAfter(0);
      styleText_(gap.editAsText(), size, false);
    }
  });
}

function appendSabbathEncouragementHeading_(cell, heading, bold, underline) {
  // Keep this heading clearly above the 10-point body text without using the
  // oversized 15-point general panel heading. The verse panel uses the same
  // size so the two halves read as one designed spread.
  var paragraph = cell.appendParagraph(String(heading || ''));
  paragraph.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  paragraph.setLineSpacing(1.25);
  paragraph.setSpacingBefore(0);
  paragraph.setSpacingAfter(0);
  var rendered = paragraph.editAsText();
  styleSabbathEncouragementText_(
    rendered,
    SABBATH_ENCOURAGEMENT_HEADING_SIZE,
    bold !== false,
  );
  if (underline) {
    rendered.setUnderline(true);
  }
  appendSpacer_(cell);
}

function styleSabbathEncouragementText_(text, size, bold) {
  styleText_(text, size, bold, { preserveCjkFont: true });
  // CJK text must stay regular even when a surrounding English heading is
  // bold. Explicitly clear inherited CJK bold and underline styles.
  setPrintedCjkBold_(text, text.getText(), false);
  text.setUnderline(false);
}
