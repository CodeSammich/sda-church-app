# Keep EAS local builds aligned with the repository whitelist while allowing
# local validation of config plugins before they are committed.
/*
!/plugins/
!/plugins/withAndroidPermanentAudioFocus.js

!/.github
!/apps-script
!/app
!/assets
!/components
!/constants
!/docs
!/features
!/hooks
!/public
!/scripts
!/services
!/styles
!/test

!/*.json
!/*.md
!/*.js
!/*.ts
!/*.tsx
!/*.html
!/.gitignore
!/.easignore
!/.aiexclude
!/.env.example
!/.vscode

node_modules/
.expo/
dist/
web-build/
build/
downloads/
expo-env.d.ts
*.tsbuildinfo
external-dependency-report.json
.env*
apps-script/.clasp.json
.vscode/hunkwise/

credentials.json
*.jks
*.keystore
*.p12
*.mobileprovision
*.ipa
*.apk
*.aab
