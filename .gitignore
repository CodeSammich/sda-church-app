# SDA Church App Git Configuration
# Aligned with Tenet 5 (Simplicity) via a Whitelist-first approach.
# This mirrors the logic of .aiexclude to ensure absolute consistency.

# 1. Ignore everything by default
/*
# 2. Re-include source and configuration directories
!/.github
!/google-apps-script
!/app
!/assets
!/components
!/constants
!/docs
!/features
!/hooks
!/plugins
!/public
!/scripts
!/services
!/styles
!/test

# 3. Re-include root configuration files
!/*.json
!/*.md
!/*.js
!/*.ts
!/*.tsx
!/*.html
!/.gitignore
!/.aiexclude
!/.env.example
!/.vscode

# 4. Explicitly ignore generated or sensitive noise
# These are excluded even if they match whitelisted patterns.
node_modules/
.expo/
dist/
web-build/
build/
downloads/
expo-env.d.ts
*.tsbuildinfo
external-dependency-report.json
.env*
# Local Apps Script project/deployment identifiers and OAuth credentials.
**/.clasp.json
**/.clasp-deployment.json
**/.clasprc.json
google-apps-script/PinyinPro.gs
.vscode/hunkwise/

# Native signing credentials and build artifacts
credentials.json
*.jks
*.keystore
*.p12
*.mobileprovision
*.provisionprofile
*.ipa
*.apk
*.aab
*.p8
*.pem
*.key
*.cer
*.crt
*.der
*.keychain
*.keychain-db
*.xcarchive
