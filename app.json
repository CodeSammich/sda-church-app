{
  "expo": {
    "name": "NY Chinese SDA",
    "slug": "sda-church-app",
    "version": "0.33.1",
    "orientation": "portrait",
    "icon": "./public/icon-1024x1024.png",
    "scheme": "sdachurchapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./public/icon-2048x2048.png",
      "resizeMode": "contain",
      "backgroundColor": "#00405C"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/sda-church-app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icon-48x48.png",
      "display": "fullscreen",
      "description": "Seventh-day Adventist church community application.",
      "shortName": "NYCCSDA",
      "lang": "en"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nyccsda.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "translucent": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-1024x1024.png",
        "backgroundColor": "#00405C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.nyccsda.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-build-properties",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92100255-b9a3-4535-8500-b21d762bbf98"
      }
    },
    "owner": "new-york-chinese-seventh-day-adventist-church"
  }
}
