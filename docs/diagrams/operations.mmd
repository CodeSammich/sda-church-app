  admins -- sign in with church accounts --> group
  repo --> actions
  androidKeys --> actions
  appleKeys --> actions
  claspKeys --> actions
  actions -- signed AAB --> play
  actions -- signed IPA --> appstore
  actions -- uploads bulletin code --> script
  actions -- QR codes, preview APKs --> drive
  actions -- web build --> pages
  abm -.-> appstore
  dns -.-> pages
  dns -.-> Google
  dns -. DNS TXT record proves ownership .-> gsc
  gsc -. website verification for the organization account .-> play

