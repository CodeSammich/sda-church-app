{"translation":{"id":"eng_asv","name":"American Standard Version (1901)","website":"https://ebible.org/Scriptures/details.php?id=eng-asv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-asv","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"ASV","englishName":"American Standard Version (1901)","language":"eng","textDirection":"ltr","sha256":"154967f9f68504bdf9a8d7abaae4ef6a93f20f779df84e62c1c8828427731839","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_asv/books.json","completeTranslationApiLink":"/api/eng_asv/complete.json","simpleCompleteTranslationApiLink":"/api/eng_asv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"PRO","name":"Proverbs","commonName":"Proverbs","title":"THE PROVERBS","numberOfChapters":31,"totalNumberOfVerses":915},"chapters":[null,{"numberOfVerses":33,"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["The proverbs of Solomon the son of David, king of Israel:"]},{"type":"verse","number":2,"content":[{"text":"To know wisdom and instruction;","poem":1},{"lineBreak":true},{"text":"To discern the words of understanding;","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"To receive instruction in wise dealing,","poem":1},{"lineBreak":true},{"text":"In righteousness and justice and equity;","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"To give prudence to the simple,","poem":1},{"lineBreak":true},{"text":"To the young man knowledge and discretion:","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"That the wise man may hear, and increase in learning;","poem":1},{"lineBreak":true},{"text":"And that the man of understanding may attain unto sound counsels:","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"To understand a proverb, and a figure,","poem":1},{"lineBreak":true},{"text":"The words of the wise, and their dark sayings.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"The fear of Jehovah is the beginning of knowledge;","poem":1},{"lineBreak":true},{"text":"But the foolish despise wisdom and instruction.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"My son, hear the instruction of thy father,","poem":1},{"lineBreak":true},{"text":"And forsake not the law of thy mother:","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"For they shall be a chaplet of grace unto thy head,","poem":1},{"lineBreak":true},{"text":"And chains about thy neck.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"My son, if sinners entice thee,","poem":1},{"lineBreak":true},{"text":"Consent thou not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"If they say, Come with us,","poem":1},{"lineBreak":true},{"text":"Let us lay wait for blood;","poem":1},{"lineBreak":true},{"text":"Let us lurk privily for the innocent without cause;","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Let us swallow them up alive as Sheol,","poem":1},{"lineBreak":true},{"text":"And whole, as those that go down into the pit;","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"We shall find all precious substance;","poem":1},{"lineBreak":true},{"text":"We shall fill our houses with spoil;","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Thou shalt cast thy lot among us;","poem":1},{"lineBreak":true},{"text":"We will all have one purse:","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"My son, walk not thou in the way with them;","poem":1},{"lineBreak":true},{"text":"Refrain thy foot from their path:","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"For their feet run to evil,","poem":1},{"lineBreak":true},{"text":"And they make haste to shed blood.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"For in vain is the net spread","poem":1},{"lineBreak":true},{"text":"In the sight of any bird:","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"And these lay wait for their own blood;","poem":1},{"lineBreak":true},{"text":"They lurk privily for their own lives.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"So are the ways of every one that is greedy of gain;","poem":1},{"lineBreak":true},{"text":"It taketh away the life of the owners thereof.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wisdom crieth aloud in the street;","poem":1},{"lineBreak":true},{"text":"She uttereth her voice in the broad places;","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"She crieth in the chief place of concourse;","poem":1},{"lineBreak":true},{"text":"At the entrance of the gates,","poem":1},{"lineBreak":true},{"text":"In the city, she uttereth her words:","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"How long, ye simple ones, will ye love simplicity?","poem":1},{"lineBreak":true},{"text":"And scoffers delight them in scoffing,","poem":1},{"lineBreak":true},{"text":"And fools hate knowledge?","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Turn you at my reproof:","poem":1},{"lineBreak":true},{"text":"Behold, I will pour out my spirit upon you;","poem":1},{"lineBreak":true},{"text":"I will make known my words unto you.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Because I have called, and ye have refused;","poem":1},{"lineBreak":true},{"text":"I have stretched out my hand, and no man hath regarded;","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"But ye have set at nought all my counsel,","poem":1},{"lineBreak":true},{"text":"And would none of my reproof:","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"I also will laugh in the day of your calamity;","poem":1},{"lineBreak":true},{"text":"I will mock when your fear cometh;","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"When your fear cometh as a storm,","poem":1},{"lineBreak":true},{"text":"And your calamity cometh on as a whirlwind;","poem":1},{"lineBreak":true},{"text":"When distress and anguish come upon you.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Then will they call upon me, but I will not answer;","poem":1},{"lineBreak":true},{"text":"They will seek me diligently, but they shall not find me:","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"For that they hated knowledge,","poem":1},{"lineBreak":true},{"text":"And did not choose the fear of Jehovah,","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"They would none of my counsel,","poem":1},{"lineBreak":true},{"text":"They despised all my reproof.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"Therefore shall they eat of the fruit of their own way,","poem":1},{"lineBreak":true},{"text":"And be filled with their own devices.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"For the backsliding of the simple shall slay them,","poem":1},{"lineBreak":true},{"text":"And the careless ease of fools shall destroy them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"But whoso hearkeneth unto me shall dwell securely,","poem":1},{"lineBreak":true},{"text":"And shall be quiet without fear of evil.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":22,"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"My son, if thou wilt receive my words,","poem":1},{"lineBreak":true},{"text":"And lay up my commandments with thee;","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"So as to incline thine ear unto wisdom,","poem":1},{"lineBreak":true},{"text":"And apply thy heart to understanding;","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Yea, if thou cry after discernment,","poem":1},{"lineBreak":true},{"text":"And lift up thy voice for understanding;","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"If thou seek her as silver,","poem":1},{"lineBreak":true},{"text":"And search for her as for hid treasures:","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Then shalt thou understand the fear of Jehovah,","poem":1},{"lineBreak":true},{"text":"And find the knowledge of God.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"For Jehovah giveth wisdom;","poem":1},{"lineBreak":true},{"text":"Out of his mouth cometh knowledge and understanding:","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"He layeth up sound wisdom for the upright;","poem":1},{"lineBreak":true},{"text":"He is a shield to them that walk in integrity;","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"That he may guard the paths of justice,","poem":1},{"lineBreak":true},{"text":"And preserve the way of his saints.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Then shalt thou understand righteousness and justice,","poem":1},{"lineBreak":true},{"text":"And equity, yea, every good path.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"For wisdom shall enter into thy heart,","poem":1},{"lineBreak":true},{"text":"And knowledge shall be pleasant unto thy soul;","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Discretion shall watch over thee;","poem":1},{"lineBreak":true},{"text":"Understanding shall keep thee:","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"To deliver thee from the way of evil,","poem":1},{"lineBreak":true},{"text":"From the men that speak perverse things;","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Who forsake the paths of uprightness,","poem":1},{"lineBreak":true},{"text":"To walk in the ways of darkness;","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Who rejoice to do evil,","poem":1},{"lineBreak":true},{"text":"And delight in the perverseness of evil;","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Who are crooked in their ways,","poem":1},{"lineBreak":true},{"text":"And wayward in their paths:","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"To deliver thee from the strange woman,","poem":1},{"lineBreak":true},{"text":"Even from the foreigner that flattereth with her words;","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"That forsaketh the friend of her youth,","poem":1},{"lineBreak":true},{"text":"And forgetteth the covenant of her God:","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"For her house inclineth unto death,","poem":1},{"lineBreak":true},{"text":"And her paths unto the dead;","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"None that go unto her return again,","poem":1},{"lineBreak":true},{"text":"Neither do they attain unto the paths of life:","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"That thou mayest walk in the way of good men,","poem":1},{"lineBreak":true},{"text":"And keep the paths of the righteous.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"For the upright shall dwell in the land,","poem":1},{"lineBreak":true},{"text":"And the perfect shall remain in it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"But the wicked shall be cut off from the land,","poem":1},{"lineBreak":true},{"text":"And the treacherous shall be rooted out of it.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":35,"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"My son, forget not my law;","poem":1},{"lineBreak":true},{"text":"But let thy heart keep my commandments:","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"For length of days, and years of life,","poem":1},{"lineBreak":true},{"text":"And peace, will they add to thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Let not kindness and truth forsake thee:","poem":1},{"lineBreak":true},{"text":"Bind them about thy neck;","poem":1},{"lineBreak":true},{"text":"Write them upon the tablet of thy heart:","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"So shalt thou find favor and good understanding","poem":1},{"lineBreak":true},{"text":"In the sight of God and man.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Trust in Jehovah with all thy heart,","poem":1},{"lineBreak":true},{"text":"And lean not upon thine own understanding:","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"In all thy ways acknowledge him,","poem":1},{"lineBreak":true},{"text":"And he will direct thy paths.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Be not wise in thine own eyes;","poem":1},{"lineBreak":true},{"text":"Fear Jehovah, and depart from evil:","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"It will be health to thy navel,","poem":1},{"lineBreak":true},{"text":"And marrow to thy bones.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Honor Jehovah with thy substance,","poem":1},{"lineBreak":true},{"text":"And with the first-fruits of all thine increase:","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"So shall thy barns be filled with plenty,","poem":1},{"lineBreak":true},{"text":"And thy vats shall overflow with new wine.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"My son, despise not the chastening of Jehovah;","poem":1},{"lineBreak":true},{"text":"Neither be weary of his reproof:","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"For whom Jehovah loveth he reproveth,","poem":1},{"lineBreak":true},{"text":"Even as a father the son in whom he delighteth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Happy is the man that findeth wisdom,","poem":1},{"lineBreak":true},{"text":"And the man that getteth understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"For the gaining of it is better than the gaining of silver,","poem":1},{"lineBreak":true},{"text":"And the profit thereof than fine gold.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"She is more precious than rubies:","poem":1},{"lineBreak":true},{"text":"And none of the things thou canst desire are to be compared unto her.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Length of days is in her right hand;","poem":1},{"lineBreak":true},{"text":"In her left hand are riches and honor.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Her ways are ways of pleasantness,","poem":1},{"lineBreak":true},{"text":"And all her paths are peace.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"She is a tree of life to them that lay hold upon her:","poem":1},{"lineBreak":true},{"text":"And happy is every one that retaineth her.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"Jehovah by wisdom founded the earth;","poem":1},{"lineBreak":true},{"text":"By understanding he established the heavens.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"By his knowledge the depths were broken up,","poem":1},{"lineBreak":true},{"text":"And the skies drop down the dew.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"My son, let them not depart from thine eyes;","poem":1},{"lineBreak":true},{"text":"Keep sound wisdom and discretion:","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"So shall they be life unto thy soul,","poem":1},{"lineBreak":true},{"text":"And grace to thy neck.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Then shalt thou walk in thy way securely,","poem":1},{"lineBreak":true},{"text":"And thy foot shall not stumble.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"When thou liest down, thou shalt not be afraid:","poem":1},{"lineBreak":true},{"text":"Yea, thou shalt lie down, and thy sleep shall be sweet.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Be not afraid of sudden fear,","poem":1},{"lineBreak":true},{"text":"Neither of the desolation of the wicked, when it cometh:","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"For Jehovah will be thy confidence,","poem":1},{"lineBreak":true},{"text":"And will keep thy foot from being taken.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Withhold not good from them to whom it is due,","poem":1},{"lineBreak":true},{"text":"When it is in the power of thy hand to do it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Say not unto thy neighbor, Go, and come again,","poem":1},{"lineBreak":true},{"text":"And to-morrow I will give;","poem":1},{"lineBreak":true},{"text":"When thou hast it by thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Devise not evil against thy neighbor,","poem":1},{"lineBreak":true},{"text":"Seeing he dwelleth securely by thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"Strive not with a man without cause,","poem":1},{"lineBreak":true},{"text":"If he have done thee no harm.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"Envy thou not the man of violence,","poem":1},{"lineBreak":true},{"text":"And choose none of his ways.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"For the perverse is an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"But his friendship is with the upright.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"The curse of Jehovah is in the house of the wicked;","poem":1},{"lineBreak":true},{"text":"But he blesseth the habitation of the righteous.","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"Surely he scoffeth at the scoffers;","poem":1},{"lineBreak":true},{"text":"But he giveth grace unto the lowly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":35,"content":[{"text":"The wise shall inherit glory;","poem":1},{"lineBreak":true},{"text":"But shame shall be the promotion of fools.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":27,"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Hear, my sons, the instruction of a father,","poem":1},{"lineBreak":true},{"text":"And attend to know understanding:","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"For I give you good doctrine;","poem":1},{"lineBreak":true},{"text":"Forsake ye not my law.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"For I was a son unto my father,","poem":1},{"lineBreak":true},{"text":"Tender and only beloved in the sight of my mother.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"And he taught me, and said unto me:","poem":1},{"lineBreak":true},{"text":"Let thy heart retain my words;","poem":1},{"lineBreak":true},{"text":"Keep my commandments, and live;","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Get wisdom, get understanding;","poem":1},{"lineBreak":true},{"text":"Forget not, neither decline from the words of my mouth;","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Forsake her not, and she will preserve thee;","poem":1},{"lineBreak":true},{"text":"Love her, and she will keep thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Wisdom is the principal thing; therefore get wisdom;","poem":1},{"lineBreak":true},{"text":"Yea, with all thy getting get understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Exalt her, and she will promote thee;","poem":1},{"lineBreak":true},{"text":"She will bring thee to honor, when thou dost embrace her.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"She will give to thy head a chaplet of grace;","poem":1},{"lineBreak":true},{"text":"A crown of beauty will she deliver to thee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hear, O my son, and receive my sayings;","poem":1},{"lineBreak":true},{"text":"And the years of thy life shall be many.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"I have taught thee in the way of wisdom;","poem":1},{"lineBreak":true},{"text":"I have led thee in paths of uprightness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"When thou goest, thy steps shall not be straitened;","poem":1},{"lineBreak":true},{"text":"And if thou runnest, thou shalt not stumble.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Take fast hold of instruction; let her not go:","poem":1},{"lineBreak":true},{"text":"Keep her; for she is thy life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Enter not into the path of the wicked,","poem":1},{"lineBreak":true},{"text":"And walk not in the way of evil men.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Avoid it, pass not by it;","poem":1},{"lineBreak":true},{"text":"Turn from it, and pass on.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"For they sleep not, except they do evil;","poem":1},{"lineBreak":true},{"text":"And their sleep is taken away, unless they cause some to fall.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"For they eat the bread of wickedness,","poem":1},{"lineBreak":true},{"text":"And drink the wine of violence.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"But the path of the righteous is as the dawning light,","poem":1},{"lineBreak":true},{"text":"That shineth more and more unto the perfect day.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"The way of the wicked is as darkness:","poem":1},{"lineBreak":true},{"text":"They know not at what they stumble.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"My son, attend to my words;","poem":1},{"lineBreak":true},{"text":"Incline thine ear unto my sayings.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"Let them not depart from thine eyes;","poem":1},{"lineBreak":true},{"text":"Keep them in the midst of thy heart.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"For they are life unto those that find them,","poem":1},{"lineBreak":true},{"text":"And health to all their flesh.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Keep thy heart with all diligence;","poem":1},{"lineBreak":true},{"text":"For out of it are the issues of life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Put away from thee a wayward mouth,","poem":1},{"lineBreak":true},{"text":"And perverse lips put far from thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Let thine eyes look right on,","poem":1},{"lineBreak":true},{"text":"And let thine eyelids look straight before thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"Make level the path of thy feet,","poem":1},{"lineBreak":true},{"text":"And let all thy ways be established.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"Turn not to the right hand nor to the left:","poem":1},{"lineBreak":true},{"text":"Remove thy foot from evil.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":23,"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"My son, attend unto my wisdom;","poem":1},{"lineBreak":true},{"text":"Incline thine ear to my understanding:","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"That thou mayest preserve discretion,","poem":1},{"lineBreak":true},{"text":"And that thy lips may keep knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"For the lips of a strange woman drop honey,","poem":1},{"lineBreak":true},{"text":"And her mouth is smoother than oil:","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"But in the end she is bitter as wormwood,","poem":1},{"lineBreak":true},{"text":"Sharp as a two-edged sword.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Her feet go down to death;","poem":1},{"lineBreak":true},{"text":"Her steps take hold on Sheol;","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"So that she findeth not the level path of life:","poem":1},{"lineBreak":true},{"text":"Her ways are unstable, and she knoweth it not.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Now therefore, my sons, hearken unto me,","poem":1},{"lineBreak":true},{"text":"And depart not from the words of my mouth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Remove thy way far from her,","poem":1},{"lineBreak":true},{"text":"And come not nigh the door of her house;","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Lest thou give thine honor unto others,","poem":1},{"lineBreak":true},{"text":"And thy years unto the cruel;","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Lest strangers be filled with thy strength,","poem":1},{"lineBreak":true},{"text":"And thy labors be in the house of an alien,","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"And thou mourn at thy latter end,","poem":1},{"lineBreak":true},{"text":"When thy flesh and thy body are consumed,","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"And say, How have I hated instruction,","poem":1},{"lineBreak":true},{"text":"And my heart despised reproof;","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Neither have I obeyed the voice of my teachers,","poem":1},{"lineBreak":true},{"text":"Nor inclined mine ear to them that instructed me!","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"I was well-nigh in all evil","poem":1},{"lineBreak":true},{"text":"In the midst of the assembly and congregation.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Drink waters out of thine own cistern,","poem":1},{"lineBreak":true},{"text":"And running waters out of thine own well.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Should thy springs be dispersed abroad,","poem":1},{"lineBreak":true},{"text":"And streams of water in the streets?","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Let them be for thyself alone,","poem":1},{"lineBreak":true},{"text":"And not for strangers with thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Let thy fountain be blessed;","poem":1},{"lineBreak":true},{"text":"And rejoice in the wife of thy youth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"As a loving hind and a pleasant doe,","poem":1},{"lineBreak":true},{"text":"Let her breasts satisfy thee at all times;","poem":1},{"lineBreak":true},{"text":"And be thou ravished always with her love.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"For why shouldest thou, my son, be ravished with a strange woman,","poem":1},{"lineBreak":true},{"text":"And embrace the bosom of a foreigner?","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"For the ways of man are before the eyes of Jehovah;","poem":1},{"lineBreak":true},{"text":"And he maketh level all his paths.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"His own iniquities shall take the wicked,","poem":1},{"lineBreak":true},{"text":"And he shall be holden with the cords of his sin.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"He shall die for lack of instruction;","poem":1},{"lineBreak":true},{"text":"And in the greatness of his folly he shall go astray.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":35,"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"My son, if thou art become surety for thy neighbor,","poem":1},{"lineBreak":true},{"text":"If thou hast stricken thy hands for a stranger;","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Thou art snared with the words of thy mouth,","poem":1},{"lineBreak":true},{"text":"Thou art taken with the words of thy mouth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Do this now, my son, and deliver thyself,","poem":1},{"lineBreak":true},{"text":"Seeing thou art come into the hand of thy neighbor:","poem":1},{"lineBreak":true},{"text":"Go, humble thyself, and importune thy neighbor;","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Give not sleep to thine eyes,","poem":1},{"lineBreak":true},{"text":"Nor slumber to thine eyelids;","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Deliver thyself as a roe from the hand of the hunter,","poem":1},{"lineBreak":true},{"text":"And as a bird from the hand of the fowler.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Go to the ant, thou sluggard;","poem":1},{"lineBreak":true},{"text":"Consider her ways, and be wise:","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Which having no chief,","poem":1},{"lineBreak":true},{"text":"Overseer, or ruler,","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Provideth her bread in the summer,","poem":1},{"lineBreak":true},{"text":"And gathereth her food in the harvest.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"How long wilt thou sleep, O sluggard?","poem":1},{"lineBreak":true},{"text":"When wilt thou arise out of thy sleep?","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Yet a little sleep, a little slumber,","poem":1},{"lineBreak":true},{"text":"A little folding of the hands to sleep:","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"So shall thy poverty come as a robber,","poem":1},{"lineBreak":true},{"text":"And thy want as an armed man.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"A worthless person, a man of iniquity,","poem":1},{"lineBreak":true},{"text":"Is he that walketh with a perverse mouth;","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"That winketh with his eyes, that speaketh with his feet,","poem":1},{"lineBreak":true},{"text":"That maketh signs with his fingers;","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"In whose heart is perverseness,","poem":1},{"lineBreak":true},{"text":"Who deviseth evil continually,","poem":1},{"lineBreak":true},{"text":"Who soweth discord.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Therefore shall his calamity come suddenly;","poem":1},{"lineBreak":true},{"text":"On a sudden shall he be broken, and that without remedy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"There are six things which Jehovah hateth;","poem":1},{"lineBreak":true},{"text":"Yea, seven which are an abomination unto him:","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Haughty eyes, a lying tongue,","poem":1},{"lineBreak":true},{"text":"And hands that shed innocent blood;","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"A heart that deviseth wicked purposes,","poem":1},{"lineBreak":true},{"text":"Feet that are swift in running to mischief,","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"A false witness that uttereth lies,","poem":1},{"lineBreak":true},{"text":"And he that soweth discord among brethren.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"My son, keep the commandment of thy father,","poem":1},{"lineBreak":true},{"text":"And forsake not the law of thy mother:","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"Bind them continually upon thy heart;","poem":1},{"lineBreak":true},{"text":"Tie them about thy neck.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"When thou walkest, it shall lead thee;","poem":1},{"lineBreak":true},{"text":"When thou sleepest, it shall watch over thee;","poem":1},{"lineBreak":true},{"text":"And when thou awakest, it shall talk with thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"For the commandment is a lamp; and the law is light;","poem":1},{"lineBreak":true},{"text":"And reproofs of instruction are the way of life:","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"To keep thee from the evil woman,","poem":1},{"lineBreak":true},{"text":"From the flattery of the foreigner’s tongue.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Lust not after her beauty in thy heart;","poem":1},{"lineBreak":true},{"text":"Neither let her take thee with her eyelids.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"For on account of a harlot a man is brought to a piece of bread;","poem":1},{"lineBreak":true},{"text":"And the adulteress hunteth for the precious life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"Can a man take fire in his bosom,","poem":1},{"lineBreak":true},{"text":"And his clothes not be burned?","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Or can one walk upon hot coals,","poem":1},{"lineBreak":true},{"text":"And his feet not be scorched?","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"So he that goeth in to his neighbor’s wife;","poem":1},{"lineBreak":true},{"text":"Whosoever toucheth her shall not be unpunished.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"Men do not despise a thief, if he steal","poem":1},{"lineBreak":true},{"text":"To satisfy himself when he is hungry:","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"But if he be found, he shall restore sevenfold;","poem":1},{"lineBreak":true},{"text":"He shall give all the substance of his house.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"He that committeth adultery with a woman is void of understanding:","poem":1},{"lineBreak":true},{"text":"He doeth it who would destroy his own soul.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"Wounds and dishonor shall he get;","poem":1},{"lineBreak":true},{"text":"And his reproach shall not be wiped away.","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"For jealousy is the rage of a man;","poem":1},{"lineBreak":true},{"text":"And he will not spare in the day of vengeance.","poem":1},{"lineBreak":true}]},{"type":"verse","number":35,"content":[{"text":"He will not regard any ransom;","poem":1},{"lineBreak":true},{"text":"Neither will he rest content, though thou givest many gifts.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":27,"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"My son, keep my words,","poem":1},{"lineBreak":true},{"text":"And lay up my commandments with thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Keep my commandments and live;","poem":1},{"lineBreak":true},{"text":"And my law as the apple of thine eye.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Bind them upon thy fingers;","poem":1},{"lineBreak":true},{"text":"Write them upon the tablet of thy heart.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Say unto wisdom, Thou art my sister;","poem":1},{"lineBreak":true},{"text":"And call understanding thy kinswoman:","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"That they may keep thee from the strange woman,","poem":1},{"lineBreak":true},{"text":"From the foreigner that flattereth with her words.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"For at the window of my house","poem":1},{"lineBreak":true},{"text":"I looked forth through my lattice;","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"And I beheld among the simple ones,","poem":1},{"lineBreak":true},{"text":"I discerned among the youths,","poem":1},{"lineBreak":true},{"text":"A young man void of understanding,","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Passing through the street near her corner;","poem":1},{"lineBreak":true},{"text":"And he went the way to her house,","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"In the twilight, in the evening of the day,","poem":1},{"lineBreak":true},{"text":"In the middle of the night and in the darkness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"And, behold, there met him a woman","poem":1},{"lineBreak":true},{"text":"With the attire of a harlot, and wily of heart.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"(She is clamorous and wilful;","poem":1},{"lineBreak":true},{"text":"Her feet abide not in her house:","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Now she is in the streets, now in the broad places,","poem":1},{"lineBreak":true},{"text":"And lieth in wait at every corner.)","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"So she caught him, and kissed him,","poem":1},{"lineBreak":true},{"text":"And with an impudent face she said unto him:","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Sacrifices of peace-offerings are with me;","poem":1},{"lineBreak":true},{"text":"This day have I paid my vows.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Therefore came I forth to meet thee,","poem":1},{"lineBreak":true},{"text":"Diligently to seek thy face, and I have found thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"I have spread my couch with carpets of tapestry,","poem":1},{"lineBreak":true},{"text":"With striped cloths of the yarn of Egypt.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"I have perfumed my bed","poem":1},{"lineBreak":true},{"text":"With myrrh, aloes, and cinnamon.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Come, let us take our fill of love until the morning;","poem":1},{"lineBreak":true},{"text":"Let us solace ourselves with loves.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"For the man is not at home;","poem":1},{"lineBreak":true},{"text":"He is gone a long journey:","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"He hath taken a bag of money with him;","poem":1},{"lineBreak":true},{"text":"He will come home at the full moon.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"With her much fair speech she causeth him to yield;","poem":1},{"lineBreak":true},{"text":"With the flattering of her lips she forceth him along.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"He goeth after her straightway,","poem":1},{"lineBreak":true},{"text":"As an ox goeth to the slaughter,","poem":1},{"lineBreak":true},{"text":"Or as one in fetters to the correction of the fool;","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Till an arrow strike through his liver;","poem":1},{"lineBreak":true},{"text":"As a bird hasteth to the snare,","poem":1},{"lineBreak":true},{"text":"And knoweth not that it is for his life.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Now therefore, my sons, hearken unto me,","poem":1},{"lineBreak":true},{"text":"And attend to the words of my mouth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Let not thy heart decline to her ways;","poem":1},{"lineBreak":true},{"text":"Go not astray in her paths.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"For she hath cast down many wounded:","poem":1},{"lineBreak":true},{"text":"Yea, all her slain are a mighty host.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"Her house is the way to Sheol,","poem":1},{"lineBreak":true},{"text":"Going down to the chambers of death.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":36,"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Doth not wisdom cry,","poem":1},{"lineBreak":true},{"text":"And understanding put forth her voice?","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"On the top of high places by the way,","poem":1},{"lineBreak":true},{"text":"Where the paths meet, she standeth;","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Beside the gates, at the entry of the city,","poem":1},{"lineBreak":true},{"text":"At the coming in at the doors, she crieth aloud:","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Unto you, O men, I call;","poem":1},{"lineBreak":true},{"text":"And my voice is to the sons of men.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"O ye simple, understand prudence;","poem":1},{"lineBreak":true},{"text":"And, ye fools, be of an understanding heart.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Hear, for I will speak excellent things;","poem":1},{"lineBreak":true},{"text":"And the opening of my lips shall be right things.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"For my mouth shall utter truth;","poem":1},{"lineBreak":true},{"text":"And wickedness is an abomination to my lips.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"All the words of my mouth are in righteousness;","poem":1},{"lineBreak":true},{"text":"There is nothing crooked or perverse in them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"They are all plain to him that understandeth,","poem":1},{"lineBreak":true},{"text":"And right to them that find knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Receive my instruction, and not silver;","poem":1},{"lineBreak":true},{"text":"And knowledge rather than choice gold.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"For wisdom is better than rubies;","poem":1},{"lineBreak":true},{"text":"And all the things that may be desired are not to be compared unto it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"I wisdom have made prudence my dwelling,","poem":1},{"lineBreak":true},{"text":"And find out knowledge and discretion.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"The fear of Jehovah is to hate evil:","poem":1},{"lineBreak":true},{"text":"Pride, and arrogancy, and the evil way,","poem":1},{"lineBreak":true},{"text":"And the perverse mouth, do I hate.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Counsel is mine, and sound knowledge:","poem":1},{"lineBreak":true},{"text":"I am understanding; I have might.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"By me kings reign,","poem":1},{"lineBreak":true},{"text":"And princes decree justice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"By me princes rule,","poem":1},{"lineBreak":true},{"text":"And nobles, even all the judges of the earth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"I love them that love me;","poem":1},{"lineBreak":true},{"text":"And those that seek me diligently shall find me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Riches and honor are with me;","poem":1},{"lineBreak":true},{"text":"Yea, durable wealth and righteousness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"My fruit is better than gold, yea, than fine gold;","poem":1},{"lineBreak":true},{"text":"And my revenue than choice silver.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"I walk in the way of righteousness,","poem":1},{"lineBreak":true},{"text":"In the midst of the paths of justice;","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"That I may cause those that love me to inherit substance,","poem":1},{"lineBreak":true},{"text":"And that I may fill their treasuries.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Jehovah possessed me in the beginning of his way,","poem":1},{"lineBreak":true},{"text":"Before his works of old.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"I was set up from everlasting, from the beginning,","poem":1},{"lineBreak":true},{"text":"Before the earth was.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"When there were no depths, I was brought forth,","poem":1},{"lineBreak":true},{"text":"When there were no fountains abounding with water.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Before the mountains were settled,","poem":1},{"lineBreak":true},{"text":"Before the hills was I brought forth;","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"While as yet he had not made the earth, nor the fields,","poem":1},{"lineBreak":true},{"text":"Nor the beginning of the dust of the world.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"When he established the heavens, I was there:","poem":1},{"lineBreak":true},{"text":"When he set a circle upon the face of the deep,","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"When he made firm the skies above,","poem":1},{"lineBreak":true},{"text":"When the fountains of the deep became strong,","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"When he gave to the sea its bound,","poem":1},{"lineBreak":true},{"text":"That the waters should not transgress his commandment,","poem":1},{"lineBreak":true},{"text":"When he marked out the foundations of the earth;","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"Then I was by him, as a master workman;","poem":1},{"lineBreak":true},{"text":"And I was daily his delight,","poem":1},{"lineBreak":true},{"text":"Rejoicing always before him,","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"Rejoicing in his habitable earth;","poem":1},{"lineBreak":true},{"text":"And my delight was with the sons of men.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Now therefore, my sons, hearken unto me;","poem":1},{"lineBreak":true},{"text":"For blessed are they that keep my ways.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"Hear instruction, and be wise,","poem":1},{"lineBreak":true},{"text":"And refuse it not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"Blessed is the man that heareth me,","poem":1},{"lineBreak":true},{"text":"Watching daily at my gates,","poem":1},{"lineBreak":true},{"text":"Waiting at the posts of my doors.","poem":1},{"lineBreak":true}]},{"type":"verse","number":35,"content":[{"text":"For whoso findeth me findeth life,","poem":1},{"lineBreak":true},{"text":"And shall obtain favor of Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":36,"content":[{"text":"But he that sinneth against me wrongeth his own soul:","poem":1},{"lineBreak":true},{"text":"All they that hate me love death.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":18,"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Wisdom hath builded her house;","poem":1},{"lineBreak":true},{"text":"She hath hewn out her seven pillars:","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"She hath killed her beasts; she hath mingled her wine;","poem":1},{"lineBreak":true},{"text":"She hath also furnished her table:","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"She hath sent forth her maidens;","poem":1},{"lineBreak":true},{"text":"She crieth upon the highest places of the city:","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Whoso is simple, let him turn in hither:","poem":1},{"lineBreak":true},{"text":"As for him that is void of understanding, she saith to him,","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Come, eat ye of my bread,","poem":1},{"lineBreak":true},{"text":"And drink of the wine which I have mingled.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Leave off, ye simple ones, and live;","poem":1},{"lineBreak":true},{"text":"And walk in the way of understanding.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"He that correcteth a scoffer getteth to himself reviling;","poem":1},{"lineBreak":true},{"text":"And he that reproveth a wicked man getteth himself a blot.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Reprove not a scoffer, lest he hate thee:","poem":1},{"lineBreak":true},{"text":"Reprove a wise man, and he will love thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Give instruction to a wise man, and he will be yet wiser:","poem":1},{"lineBreak":true},{"text":"Teach a righteous man, and he will increase in learning.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The fear of Jehovah is the beginning of wisdom;","poem":1},{"lineBreak":true},{"text":"And the knowledge of the Holy One is understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"For by me thy days shall be multiplied,","poem":1},{"lineBreak":true},{"text":"And the years of thy life shall be increased.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"If thou art wise, thou art wise for thyself;","poem":1},{"lineBreak":true},{"text":"And if thou scoffest, thou alone shalt bear it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"The foolish woman is clamorous;","poem":1},{"lineBreak":true},{"text":"She is simple, and knoweth nothing.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"And she sitteth at the door of her house,","poem":1},{"lineBreak":true},{"text":"On a seat in the high places of the city,","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"To call to them that pass by,","poem":1},{"lineBreak":true},{"text":"Who go right on their ways:","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Whoso is simple, let him turn in hither;","poem":1},{"lineBreak":true},{"text":"And as for him that is void of understanding, she saith to him,","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Stolen waters are sweet,","poem":1},{"lineBreak":true},{"text":"And bread eaten in secret is pleasant.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"But he knoweth not that the dead are there;","poem":1},{"lineBreak":true},{"text":"That her guests are in the depths of Sheol.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":32,"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["The proverbs of Solomon.",{"lineBreak":true},{"text":"A wise son maketh a glad father;","poem":1},{"lineBreak":true},{"text":"But a foolish son is the heaviness of his mother.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Treasures of wickedness profit nothing;","poem":1},{"lineBreak":true},{"text":"But righteousness delivereth from death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Jehovah will not suffer the soul of the righteous to famish;","poem":1},{"lineBreak":true},{"text":"But he thrusteth away the desire of the wicked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"He becometh poor that worketh with a slack hand;","poem":1},{"lineBreak":true},{"text":"But the hand of the diligent maketh rich.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"He that gathereth in summer is a wise son;","poem":1},{"lineBreak":true},{"text":"But he that sleepeth in harvest is a son that causeth shame.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Blessings are upon the head of the righteous;","poem":1},{"lineBreak":true},{"text":"But violence covereth the mouth of the wicked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The memory of the righteous is blessed;","poem":1},{"lineBreak":true},{"text":"But the name of the wicked shall rot.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The wise in heart will receive commandments;","poem":1},{"lineBreak":true},{"text":"But a prating fool shall fall.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"He that walketh uprightly walketh surely;","poem":1},{"lineBreak":true},{"text":"But he that perverteth his ways shall be known.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"He that winketh with the eye causeth sorrow;","poem":1},{"lineBreak":true},{"text":"But a prating fool shall fall.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"The mouth of the righteous is a fountain of life;","poem":1},{"lineBreak":true},{"text":"But violence covereth the mouth of the wicked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Hatred stirreth up strifes;","poem":1},{"lineBreak":true},{"text":"But love covereth all transgressions.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"In the lips of him that hath discernment wisdom is found;","poem":1},{"lineBreak":true},{"text":"But a rod is for the back of him that is void of understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Wise men lay up knowledge;","poem":1},{"lineBreak":true},{"text":"But the mouth of the foolish is a present destruction.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The rich man’s wealth is his strong city:","poem":1},{"lineBreak":true},{"text":"The destruction of the poor is their poverty.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"The labor of the righteous tendeth to life;","poem":1},{"lineBreak":true},{"text":"The increase of the wicked, to sin.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"He is in the way of life that heedeth correction;","poem":1},{"lineBreak":true},{"text":"But he that forsaketh reproof erreth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"He that hideth hatred is of lying lips;","poem":1},{"lineBreak":true},{"text":"And he that uttereth a slander is a fool.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"In the multitude of words there wanteth not transgression;","poem":1},{"lineBreak":true},{"text":"But he that refraineth his lips doeth wisely.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"The tongue of the righteous is as choice silver:","poem":1},{"lineBreak":true},{"text":"The heart of the wicked is little worth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"The lips of the righteous feed many;","poem":1},{"lineBreak":true},{"text":"But the foolish die for lack of understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"The blessing of Jehovah, it maketh rich;","poem":1},{"lineBreak":true},{"text":"And he addeth no sorrow therewith.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"It is as sport to a fool to do wickedness;","poem":1},{"lineBreak":true},{"text":"And so is wisdom to a man of understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"The fear of the wicked, it shall come upon him;","poem":1},{"lineBreak":true},{"text":"And the desire of the righteous shall be granted.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"When the whirlwind passeth, the wicked is no more;","poem":1},{"lineBreak":true},{"text":"But the righteous is an everlasting foundation.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"As vinegar to the teeth, and as smoke to the eyes,","poem":1},{"lineBreak":true},{"text":"So is the sluggard to them that send him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"The fear of Jehovah prolongeth days;","poem":1},{"lineBreak":true},{"text":"But the years of the wicked shall be shortened.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"The hope of the righteous shall be gladness;","poem":1},{"lineBreak":true},{"text":"But the expectation of the wicked shall perish.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"The way of Jehovah is a stronghold to the upright;","poem":1},{"lineBreak":true},{"text":"But it is a destruction to the workers of iniquity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"The righteous shall never be removed;","poem":1},{"lineBreak":true},{"text":"But the wicked shall not dwell in the land.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"The mouth of the righteous bringeth forth wisdom;","poem":1},{"lineBreak":true},{"text":"But the perverse tongue shall be cut off.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"The lips of the righteous know what is acceptable;","poem":1},{"lineBreak":true},{"text":"But the mouth of the wicked speaketh perverseness.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":31,"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"A false balance is an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"But a just weight is his delight.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"When pride cometh, then cometh shame;","poem":1},{"lineBreak":true},{"text":"But with the lowly is wisdom.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"The integrity of the upright shall guide them;","poem":1},{"lineBreak":true},{"text":"But the perverseness of the treacherous shall destroy them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Riches profit not in the day of wrath;","poem":1},{"lineBreak":true},{"text":"But righteousness delivereth from death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"The righteousness of the perfect shall direct his way;","poem":1},{"lineBreak":true},{"text":"But the wicked shall fall by his own wickedness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"The righteousness of the upright shall deliver them;","poem":1},{"lineBreak":true},{"text":"But the treacherous shall be taken in their own iniquity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"When a wicked man dieth, his expectation shall perish;","poem":1},{"lineBreak":true},{"text":"And the hope of iniquity perisheth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The righteous is delivered out of trouble;","poem":1},{"lineBreak":true},{"text":"And the wicked cometh in his stead.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"With his mouth the godless man destroyeth his neighbor;","poem":1},{"lineBreak":true},{"text":"But through knowledge shall the righteous be delivered.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"When it goeth well with the righteous, the city rejoiceth;","poem":1},{"lineBreak":true},{"text":"And when the wicked perish, there is shouting.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"By the blessing of the upright the city is exalted;","poem":1},{"lineBreak":true},{"text":"But it is overthrown by the mouth of the wicked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"He that despiseth his neighbor is void of wisdom;","poem":1},{"lineBreak":true},{"text":"But a man of understanding holdeth his peace.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"He that goeth about as a tale-bearer revealeth secrets;","poem":1},{"lineBreak":true},{"text":"But he that is of a faithful spirit concealeth a matter.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Where no wise guidance is, the people falleth;","poem":1},{"lineBreak":true},{"text":"But in the multitude of counsellors there is safety.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"He that is surety for a stranger shall smart for it;","poem":1},{"lineBreak":true},{"text":"But he that hateth suretyship is secure.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"A gracious woman obtaineth honor;","poem":1},{"lineBreak":true},{"text":"And violent men obtain riches.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"The merciful man doeth good to his own soul;","poem":1},{"lineBreak":true},{"text":"But he that is cruel troubleth his own flesh.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"The wicked earneth deceitful wages;","poem":1},{"lineBreak":true},{"text":"But he that soweth righteousness hath a sure reward.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"He that is stedfast in righteousness shall attain unto life;","poem":1},{"lineBreak":true},{"text":"And he that pursueth evil doeth it to his own death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"They that are perverse in heart are an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"But such as are perfect in their way are his delight.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"Though hand join in hand, the evil man shall not be unpunished;","poem":1},{"lineBreak":true},{"text":"But the seed of the righteous shall be delivered.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"As a ring of gold in a swine’s snout,","poem":1},{"lineBreak":true},{"text":"So is a fair woman that is without discretion.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"The desire of the righteous is only good;","poem":1},{"lineBreak":true},{"text":"But the expectation of the wicked is wrath.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"There is that scattereth, and increaseth yet more;","poem":1},{"lineBreak":true},{"text":"And there is that withholdeth more than is meet, but it tendeth only to want.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"The liberal soul shall be made fat;","poem":1},{"lineBreak":true},{"text":"And he that watereth shall be watered also himself.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"He that withholdeth grain, the people shall curse him;","poem":1},{"lineBreak":true},{"text":"But blessing shall be upon the head of him that selleth it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"He that diligently seeketh good seeketh favor;","poem":1},{"lineBreak":true},{"text":"But he that searcheth after evil, it shall come unto him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"He that trusteth in his riches shall fall;","poem":1},{"lineBreak":true},{"text":"But the righteous shall flourish as the green leaf.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"He that troubleth his own house shall inherit the wind;","poem":1},{"lineBreak":true},{"text":"And the foolish shall be servant to the wise of heart.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"The fruit of the righteous is a tree of life;","poem":1},{"lineBreak":true},{"text":"And he that is wise winneth souls.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"Behold, the righteous shall be recompensed in the earth;","poem":1},{"lineBreak":true},{"text":"How much more the wicked and the sinner!","poem":1}]}],"footnotes":[]}},{"numberOfVerses":28,"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Whoso loveth correction loveth knowledge;","poem":1},{"lineBreak":true},{"text":"But he that hateth reproof is brutish.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"A good man shall obtain favor of Jehovah;","poem":1},{"lineBreak":true},{"text":"But a man of wicked devices will he condemn.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"A man shall not be established by wickedness;","poem":1},{"lineBreak":true},{"text":"But the root of the righteous shall not be moved.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"A worthy woman is the crown of her husband;","poem":1},{"lineBreak":true},{"text":"But she that maketh ashamed is as rottenness in his bones.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"The thoughts of the righteous are just;","poem":1},{"lineBreak":true},{"text":"But the counsels of the wicked are deceit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"The words of the wicked are of lying in wait for blood;","poem":1},{"lineBreak":true},{"text":"But the mouth of the upright shall deliver them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The wicked are overthrown, and are not;","poem":1},{"lineBreak":true},{"text":"But the house of the righteous shall stand.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"A man shall be commended according to his wisdom;","poem":1},{"lineBreak":true},{"text":"But he that is of a perverse heart shall be despised.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Better is he that is lightly esteemed, and hath a servant,","poem":1},{"lineBreak":true},{"text":"Than he that honoreth himself, and lacketh bread.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"A righteous man regardeth the life of his beast;","poem":1},{"lineBreak":true},{"text":"But the tender mercies of the wicked are cruel.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"He that tilleth his land shall have plenty of bread;","poem":1},{"lineBreak":true},{"text":"But he that followeth after vain persons is void of understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"The wicked desireth the net of evil men;","poem":1},{"lineBreak":true},{"text":"But the root of the righteous yieldeth fruit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"In the transgression of the lips is a snare to the evil man;","poem":1},{"lineBreak":true},{"text":"But the righteous shall come out of trouble.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"A man shall be satisfied with good by the fruit of his mouth;","poem":1},{"lineBreak":true},{"text":"And the doings of a man’s hands shall be rendered unto him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The way of a fool is right in his own eyes;","poem":1},{"lineBreak":true},{"text":"But he that is wise hearkeneth unto counsel.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"A fool’s vexation is presently known;","poem":1},{"lineBreak":true},{"text":"But a prudent man concealeth shame.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"He that uttereth truth showeth forth righteousness;","poem":1},{"lineBreak":true},{"text":"But a false witness, deceit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"There is that speaketh rashly like the piercings of a sword;","poem":1},{"lineBreak":true},{"text":"But the tongue of the wise is health.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"The lip of truth shall be established for ever;","poem":1},{"lineBreak":true},{"text":"But a lying tongue is but for a moment.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Deceit is in the heart of them that devise evil;","poem":1},{"lineBreak":true},{"text":"But to the counsellors of peace is joy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"There shall no mischief happen to the righteous;","poem":1},{"lineBreak":true},{"text":"But the wicked shall be filled with evil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Lying lips are an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"But they that deal truly are his delight.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"A prudent man concealeth knowledge;","poem":1},{"lineBreak":true},{"text":"But the heart of fools proclaimeth foolishness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"The hand of the diligent shall bear rule;","poem":1},{"lineBreak":true},{"text":"But the slothful shall be put under taskwork.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Heaviness in the heart of a man maketh it stoop;","poem":1},{"lineBreak":true},{"text":"But a good word maketh it glad.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"The righteous is a guide to his neighbor;","poem":1},{"lineBreak":true},{"text":"But the way of the wicked causeth them to err.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"The slothful man roasteth not that which he took in hunting;","poem":1},{"lineBreak":true},{"text":"But the precious substance of men is to the diligent.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"In the way of righteousness is life;","poem":1},{"lineBreak":true},{"text":"And in the pathway thereof there is no death.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":25,"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"A wise son heareth his father’s instruction;","poem":1},{"lineBreak":true},{"text":"But a scoffer heareth not rebuke.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"A man shall eat good by the fruit of his mouth;","poem":1},{"lineBreak":true},{"text":"But the soul of the treacherous shall eat violence.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"He that guardeth his mouth keepeth his life;","poem":1},{"lineBreak":true},{"text":"But he that openeth wide his lips shall have destruction.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"The soul of the sluggard desireth, and hath nothing;","poem":1},{"lineBreak":true},{"text":"But the soul of the diligent shall be made fat.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"A righteous man hateth lying;","poem":1},{"lineBreak":true},{"text":"But a wicked man is loathsome, and cometh to shame.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Righteousness guardeth him that is upright in the way;","poem":1},{"lineBreak":true},{"text":"But wickedness overthroweth the sinner.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"There is that maketh himself rich, yet hath nothing:","poem":1},{"lineBreak":true},{"text":"There is that maketh himself poor, yet hath great wealth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The ransom of a man’s life is his riches;","poem":1},{"lineBreak":true},{"text":"But the poor heareth no threatening.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"The light of the righteous rejoiceth;","poem":1},{"lineBreak":true},{"text":"But the lamp of the wicked shall be put out.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"By pride cometh only contention;","poem":1},{"lineBreak":true},{"text":"But with the well-advised is wisdom.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Wealth gotten by vanity shall be diminished;","poem":1},{"lineBreak":true},{"text":"But he that gathereth by labor shall have increase.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Hope deferred maketh the heart sick;","poem":1},{"lineBreak":true},{"text":"But when the desire cometh, it is a tree of life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Whoso despiseth the word bringeth destruction on himself;","poem":1},{"lineBreak":true},{"text":"But he that feareth the commandment shall be rewarded.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The law of the wise is a fountain of life,","poem":1},{"lineBreak":true},{"text":"That one may depart from the snares of death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Good understanding giveth favor;","poem":1},{"lineBreak":true},{"text":"But the way of the transgressor is hard.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Every prudent man worketh with knowledge;","poem":1},{"lineBreak":true},{"text":"But a fool flaunteth his folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"A wicked messenger falleth into evil;","poem":1},{"lineBreak":true},{"text":"But a faithful ambassador is health.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Poverty and shame shall be to him that refuseth correction;","poem":1},{"lineBreak":true},{"text":"But he that regardeth reproof shall be honored.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"The desire accomplished is sweet to the soul;","poem":1},{"lineBreak":true},{"text":"But it is an abomination to fools to depart from evil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Walk with wise men, and thou shalt be wise;","poem":1},{"lineBreak":true},{"text":"But the companion of fools shall smart for it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"Evil pursueth sinners;","poem":1},{"lineBreak":true},{"text":"But the righteous shall be recompensed with good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"A good man leaveth an inheritance to his children’s children;","poem":1},{"lineBreak":true},{"text":"And the wealth of the sinner is laid up for the righteous.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Much food is in the tillage of the poor;","poem":1},{"lineBreak":true},{"text":"But there is that is destroyed by reason of injustice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"He that spareth his rod hateth his son;","poem":1},{"lineBreak":true},{"text":"But he that loveth him chasteneth him betimes.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"The righteous eateth to the satisfying of his soul;","poem":1},{"lineBreak":true},{"text":"But the belly of the wicked shall want.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":35,"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Every wise woman buildeth her house;","poem":1},{"lineBreak":true},{"text":"But the foolish plucketh it down with her own hands.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"He that walketh in his uprightness feareth Jehovah;","poem":1},{"lineBreak":true},{"text":"But he that is perverse in his ways despiseth him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"In the mouth of the foolish is a rod for his pride;","poem":1},{"lineBreak":true},{"text":"But the lips of the wise shall preserve them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Where no oxen are, the crib is clean;","poem":1},{"lineBreak":true},{"text":"But much increase is by the strength of the ox.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"A faithful witness will not lie;","poem":1},{"lineBreak":true},{"text":"But a false witness uttereth lies.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"A scoffer seeketh wisdom, and findeth it not;","poem":1},{"lineBreak":true},{"text":"But knowledge is easy unto him that hath understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Go into the presence of a foolish man,","poem":1},{"lineBreak":true},{"text":"And thou shalt not perceive in him the lips of knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The wisdom of the prudent is to understand his way;","poem":1},{"lineBreak":true},{"text":"But the folly of fools is deceit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"A trespass-offering mocketh fools;","poem":1},{"lineBreak":true},{"text":"But among the upright there is good will.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The heart knoweth its own bitterness;","poem":1},{"lineBreak":true},{"text":"And a stranger doth not intermeddle with its joy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"The house of the wicked shall be overthrown;","poem":1},{"lineBreak":true},{"text":"But the tent of the upright shall flourish.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"There is a way which seemeth right unto a man;","poem":1},{"lineBreak":true},{"text":"But the end thereof are the ways of death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Even in laughter the heart is sorrowful;","poem":1},{"lineBreak":true},{"text":"And the end of mirth is heaviness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The backslider in heart shall be filled with his own ways;","poem":1},{"lineBreak":true},{"text":"And a good man shall be satisfied from himself.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The simple believeth every word;","poem":1},{"lineBreak":true},{"text":"But the prudent man looketh well to his going.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"A wise man feareth, and departeth from evil;","poem":1},{"lineBreak":true},{"text":"But the fool beareth himself insolently, and is confident.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"He that is soon angry will deal foolishly;","poem":1},{"lineBreak":true},{"text":"And a man of wicked devices is hated.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"The simple inherit folly;","poem":1},{"lineBreak":true},{"text":"But the prudent are crowned with knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"The evil bow down before the good;","poem":1},{"lineBreak":true},{"text":"And the wicked, at the gates of the righteous.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"The poor is hated even of his own neighbor;","poem":1},{"lineBreak":true},{"text":"But the rich hath many friends.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"He that despiseth his neighbor sinneth;","poem":1},{"lineBreak":true},{"text":"But he that hath pity on the poor, happy is he.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Do they not err that devise evil?","poem":1},{"lineBreak":true},{"text":"But mercy and truth shall be to them that devise good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"In all labor there is profit;","poem":1},{"lineBreak":true},{"text":"But the talk of the lips tendeth only to penury.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"The crown of the wise is their riches;","poem":1},{"lineBreak":true},{"text":"But the folly of fools is only folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"A true witness delivereth souls;","poem":1},{"lineBreak":true},{"text":"But he that uttereth lies causeth deceit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"In the fear of Jehovah is strong confidence;","poem":1},{"lineBreak":true},{"text":"And his children shall have a place of refuge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"The fear of Jehovah is a fountain of life,","poem":1},{"lineBreak":true},{"text":"That one may depart from the snares of death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"In the multitude of people is the king’s glory;","poem":1},{"lineBreak":true},{"text":"But in the want of people is the destruction of the prince.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"He that is slow to anger is of great understanding;","poem":1},{"lineBreak":true},{"text":"But he that is hasty of spirit exalteth folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"A tranquil heart is the life of the flesh;","poem":1},{"lineBreak":true},{"text":"But envy is the rottenness of the bones.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"He that oppresseth the poor reproacheth his Maker;","poem":1},{"lineBreak":true},{"text":"But he that hath mercy on the needy honoreth him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"The wicked is thrust down in his evil-doing;","poem":1},{"lineBreak":true},{"text":"But the righteous hath a refuge in his death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"Wisdom resteth in the heart of him that hath understanding;","poem":1},{"lineBreak":true},{"text":"But that which is in the inward part of fools is made known.","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"Righteousness exalteth a nation;","poem":1},{"lineBreak":true},{"text":"But sin is a reproach to any people.","poem":1},{"lineBreak":true}]},{"type":"verse","number":35,"content":[{"text":"The king’s favor is toward a servant that dealeth wisely;","poem":1},{"lineBreak":true},{"text":"But his wrath will be against him that causeth shame.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":33,"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"A soft answer turneth away wrath;","poem":1},{"lineBreak":true},{"text":"But a grievous word stirreth up anger.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"The tongue of the wise uttereth knowledge aright;","poem":1},{"lineBreak":true},{"text":"But the mouth of fools poureth out folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"The eyes of Jehovah are in every place,","poem":1},{"lineBreak":true},{"text":"Keeping watch upon the evil and the good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"A gentle tongue is a tree of life;","poem":1},{"lineBreak":true},{"text":"But perverseness therein is a breaking of the spirit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"A fool despiseth his father’s correction;","poem":1},{"lineBreak":true},{"text":"But he that regardeth reproof getteth prudence.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"In the house of the righteous is much treasure;","poem":1},{"lineBreak":true},{"text":"But in the revenues of the wicked is trouble.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The lips of the wise disperse knowledge;","poem":1},{"lineBreak":true},{"text":"But the heart of the foolish doeth not so.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The sacrifice of the wicked is an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"But the prayer of the upright is his delight.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"The way of the wicked is an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"But he loveth him that followeth after righteousness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"There is grievous correction for him that forsaketh the way;","poem":1},{"lineBreak":true},{"text":"And he that hateth reproof shall die.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Sheol and Abaddon are before Jehovah;","poem":1},{"lineBreak":true},{"text":"How much more then the hearts of the children of men!","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"A scoffer loveth not to be reproved;","poem":1},{"lineBreak":true},{"text":"He will not go unto the wise.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"A glad heart maketh a cheerful countenance;","poem":1},{"lineBreak":true},{"text":"But by sorrow of heart the spirit is broken.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The heart of him that hath understanding seeketh knowledge;","poem":1},{"lineBreak":true},{"text":"But the mouth of fools feedeth on folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"All the days of the afflicted are evil;","poem":1},{"lineBreak":true},{"text":"But he that is of a cheerful heart hath a continual feast.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Better is little, with the fear of Jehovah,","poem":1},{"lineBreak":true},{"text":"Than great treasure and trouble therewith.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Better is a dinner of herbs, where love is,","poem":1},{"lineBreak":true},{"text":"Than a stalled ox and hatred therewith.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"A wrathful man stirreth up contention;","poem":1},{"lineBreak":true},{"text":"But he that is slow to anger appeaseth strife.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"The way of the sluggard is as a hedge of thorns;","poem":1},{"lineBreak":true},{"text":"But the path of the upright is made a highway.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"A wise son maketh a glad father;","poem":1},{"lineBreak":true},{"text":"But a foolish man despiseth his mother.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"Folly is joy to him that is void of wisdom;","poem":1},{"lineBreak":true},{"text":"But a man of understanding maketh straight his going.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Where there is no counsel, purposes are disappointed;","poem":1},{"lineBreak":true},{"text":"But in the multitude of counsellors they are established.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"A man hath joy in the answer of his mouth;","poem":1},{"lineBreak":true},{"text":"And a word in due season, how good is it!","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"To the wise the way of life goeth upward,","poem":1},{"lineBreak":true},{"text":"That he may depart from Sheol beneath.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Jehovah will root up the house of the proud;","poem":1},{"lineBreak":true},{"text":"But he will establish the border of the widow.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"Evil devices are an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"But pleasant words are pure.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"He that is greedy of gain troubleth his own house;","poem":1},{"lineBreak":true},{"text":"But he that hateth bribes shall live.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"The heart of the righteous studieth to answer;","poem":1},{"lineBreak":true},{"text":"But the mouth of the wicked poureth out evil things.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Jehovah is far from the wicked;","poem":1},{"lineBreak":true},{"text":"But he heareth the prayer of the righteous.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"The light of the eyes rejoiceth the heart;","poem":1},{"lineBreak":true},{"text":"And good tidings make the bones fat.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"The ear that hearkeneth to the reproof of life","poem":1},{"lineBreak":true},{"text":"Shall abide among the wise.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"He that refuseth correction despiseth his own soul;","poem":1},{"lineBreak":true},{"text":"But he that hearkeneth to reproof getteth understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"The fear of Jehovah is the instruction of wisdom;","poem":1},{"lineBreak":true},{"text":"And before honor goeth humility.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":33,"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"The plans of the heart belong to man;","poem":1},{"lineBreak":true},{"text":"But the answer of the tongue is from Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"All the ways of a man are clean in his own eyes;","poem":1},{"lineBreak":true},{"text":"But Jehovah weigheth the spirits.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Commit thy works unto Jehovah,","poem":1},{"lineBreak":true},{"text":"And thy purposes shall be established.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Jehovah hath made everything for its own end;","poem":1},{"lineBreak":true},{"text":"Yea, even the wicked for the day of evil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Every one that is proud in heart is an abomination to Jehovah:","poem":1},{"lineBreak":true},{"text":"Though hand join in hand, he shall not be unpunished.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"By mercy and truth iniquity is atoned for;","poem":1},{"lineBreak":true},{"text":"And by the fear of Jehovah men depart from evil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"When a man’s ways please Jehovah,","poem":1},{"lineBreak":true},{"text":"He maketh even his enemies to be at peace with him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Better is a little, with righteousness,","poem":1},{"lineBreak":true},{"text":"Than great revenues with injustice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"A man’s heart deviseth his way;","poem":1},{"lineBreak":true},{"text":"But Jehovah directeth his steps.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"A divine sentence is in the lips of the king;","poem":1},{"lineBreak":true},{"text":"His mouth shall not transgress in judgment.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"A just balance and scales are Jehovah’s;","poem":1},{"lineBreak":true},{"text":"All the weights of the bag are his work.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"It is an abomination to kings to commit wickedness;","poem":1},{"lineBreak":true},{"text":"For the throne is established by righteousness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Righteous lips are the delight of kings;","poem":1},{"lineBreak":true},{"text":"And they love him that speaketh right.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The wrath of a king is as messengers of death;","poem":1},{"lineBreak":true},{"text":"But a wise man will pacify it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"In the light of the king’s countenance is life;","poem":1},{"lineBreak":true},{"text":"And his favor is as a cloud of the latter rain.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"How much better is it to get wisdom than gold!","poem":1},{"lineBreak":true},{"text":"Yea, to get understanding is rather to be chosen than silver.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"The highway of the upright is to depart from evil:","poem":1},{"lineBreak":true},{"text":"He that keepeth his way preserveth his soul.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Pride goeth before destruction,","poem":1},{"lineBreak":true},{"text":"And a haughty spirit before a fall.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"Better it is to be of a lowly spirit with the poor,","poem":1},{"lineBreak":true},{"text":"Than to divide the spoil with the proud.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"He that giveth heed unto the word shall find good;","poem":1},{"lineBreak":true},{"text":"And whoso trusteth in Jehovah, happy is he.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"The wise in heart shall be called prudent;","poem":1},{"lineBreak":true},{"text":"And the sweetness of the lips increaseth learning.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Understanding is a well-spring of life unto him that hath it;","poem":1},{"lineBreak":true},{"text":"But the correction of fools is their folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"The heart of the wise instructeth his mouth,","poem":1},{"lineBreak":true},{"text":"And addeth learning to his lips.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Pleasant words are as a honeycomb,","poem":1},{"lineBreak":true},{"text":"Sweet to the soul, and health to the bones.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"There is a way which seemeth right unto a man,","poem":1},{"lineBreak":true},{"text":"But the end thereof are the ways of death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"The appetite of the laboring man laboreth for him;","poem":1},{"lineBreak":true},{"text":"For his mouth urgeth him thereto.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"A worthless man deviseth mischief;","poem":1},{"lineBreak":true},{"text":"And in his lips there is as a scorching fire.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"A perverse man scattereth abroad strife;","poem":1},{"lineBreak":true},{"text":"And a whisperer separateth chief friends.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"A man of violence enticeth his neighbor,","poem":1},{"lineBreak":true},{"text":"And leadeth him in a way that is not good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"He that shutteth his eyes, it is to devise perverse things:","poem":1},{"lineBreak":true},{"text":"He that compresseth his lips bringeth evil to pass.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"The hoary head is a crown of glory;","poem":1},{"lineBreak":true},{"text":"It shall be found in the way of righteousness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"He that is slow to anger is better than the mighty;","poem":1},{"lineBreak":true},{"text":"And he that ruleth his spirit, than he that taketh a city.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"The lot is cast into the lap;","poem":1},{"lineBreak":true},{"text":"But the whole disposing thereof is of Jehovah.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":28,"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Better is a dry morsel, and quietness therewith,","poem":1},{"lineBreak":true},{"text":"Than a house full of feasting with strife.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"A servant that dealeth wisely shall have rule over a son that causeth shame,","poem":1},{"lineBreak":true},{"text":"And shall have part in the inheritance among the brethren.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"The refining pot is for silver, and the furnace for gold;","poem":1},{"lineBreak":true},{"text":"But Jehovah trieth the hearts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"An evil-doer giveth heed to wicked lips;","poem":1},{"lineBreak":true},{"text":"And a liar giveth ear to a mischievous tongue.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Whoso mocketh the poor reproacheth his Maker;","poem":1},{"lineBreak":true},{"text":"And he that is glad at calamity shall not be unpunished.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Children’s children are the crown of old men;","poem":1},{"lineBreak":true},{"text":"And the glory of children are their fathers.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Excellent speech becometh not a fool;","poem":1},{"lineBreak":true},{"text":"Much less do lying lips a prince.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"A bribe is as a precious stone in the eyes of him that hath it;","poem":1},{"lineBreak":true},{"text":"Whithersoever it turneth, it prospereth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"He that covereth a transgression seeketh love;","poem":1},{"lineBreak":true},{"text":"But he that harpeth on a matter separateth chief friends.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"A rebuke entereth deeper into one that hath understanding","poem":1},{"lineBreak":true},{"text":"Than a hundred stripes into a fool.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"An evil man seeketh only rebellion;","poem":1},{"lineBreak":true},{"text":"Therefore a cruel messenger shall be sent against him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Let a bear robbed of her whelps meet a man,","poem":1},{"lineBreak":true},{"text":"Rather than a fool in his folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Whoso rewardeth evil for good,","poem":1},{"lineBreak":true},{"text":"Evil shall not depart from his house.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The beginning of strife is as when one letteth out water:","poem":1},{"lineBreak":true},{"text":"Therefore leave off contention, before there is quarrelling.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"He that justifieth the wicked, and he that condemneth the righteous,","poem":1},{"lineBreak":true},{"text":"Both of them alike are an abomination to Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Wherefore is there a price in the hand of a fool to buy wisdom,","poem":1},{"lineBreak":true},{"text":"Seeing he hath no understanding?","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"A friend loveth at all times;","poem":1},{"lineBreak":true},{"text":"And a brother is born for adversity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"A man void of understanding striketh hands,","poem":1},{"lineBreak":true},{"text":"And becometh surety in the presence of his neighbor.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"He loveth transgression that loveth strife:","poem":1},{"lineBreak":true},{"text":"He that raiseth high his gate seeketh destruction.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"He that hath a wayward heart findeth no good;","poem":1},{"lineBreak":true},{"text":"And he that hath a perverse tongue falleth into mischief.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"He that begetteth a fool doeth it to his sorrow;","poem":1},{"lineBreak":true},{"text":"And the father of a fool hath no joy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"A cheerful heart is a good medicine;","poem":1},{"lineBreak":true},{"text":"But a broken spirit drieth up the bones.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"A wicked man receiveth a bribe out of the bosom,","poem":1},{"lineBreak":true},{"text":"To pervert the ways of justice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Wisdom is before the face of him that hath understanding;","poem":1},{"lineBreak":true},{"text":"But the eyes of a fool are in the ends of the earth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"A foolish son is a grief to his father,","poem":1},{"lineBreak":true},{"text":"And bitterness to her that bare him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"Also to punish the righteous is not good,","poem":1},{"lineBreak":true},{"text":"Nor to smite the noble for their uprightness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"He that spareth his words hath knowledge;","poem":1},{"lineBreak":true},{"text":"And he that is of a cool spirit is a man of understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Even a fool, when he holdeth his peace, is counted wise;","poem":1},{"lineBreak":true},{"text":"When he shutteth his lips, he is esteemed as prudent.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":24,"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"He that separateth himself seeketh his own desire,","poem":1},{"lineBreak":true},{"text":"And rageth against all sound wisdom.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"A fool hath no delight in understanding,","poem":1},{"lineBreak":true},{"text":"But only that his heart may reveal itself.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"When the wicked cometh, there cometh also contempt,","poem":1},{"lineBreak":true},{"text":"And with ignominy cometh reproach.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"The words of a man’s mouth are as deep waters;","poem":1},{"lineBreak":true},{"text":"The wellspring of wisdom is as a flowing brook.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"To respect the person of the wicked is not good,","poem":1},{"lineBreak":true},{"text":"Nor to turn aside the righteous in judgment.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"A fool’s lips enter into contention,","poem":1},{"lineBreak":true},{"text":"And his mouth calleth for stripes.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"A fool’s mouth is his destruction,","poem":1},{"lineBreak":true},{"text":"And his lips are the snare of his soul.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The words of a whisperer are as dainty morsels,","poem":1},{"lineBreak":true},{"text":"And they go down into the innermost parts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"He also that is slack in his work","poem":1},{"lineBreak":true},{"text":"Is brother to him that is a destroyer.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The name of Jehovah is a strong tower;","poem":1},{"lineBreak":true},{"text":"The righteous runneth into it, and is safe.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"The rich man’s wealth is his strong city,","poem":1},{"lineBreak":true},{"text":"And as a high wall in his own imagination.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Before destruction the heart of man is haughty;","poem":1},{"lineBreak":true},{"text":"And before honor goeth humility.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"He that giveth answer before he heareth,","poem":1},{"lineBreak":true},{"text":"It is folly and shame unto him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The spirit of a man will sustain his infirmity;","poem":1},{"lineBreak":true},{"text":"But a broken spirit who can bear?","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The heart of the prudent getteth knowledge;","poem":1},{"lineBreak":true},{"text":"And the ear of the wise seeketh knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"A man’s gift maketh room for him,","poem":1},{"lineBreak":true},{"text":"And bringeth him before great men.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"He that pleadeth his cause first seemeth just;","poem":1},{"lineBreak":true},{"text":"But his neighbor cometh and searcheth him out.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"The lot causeth contentions to cease,","poem":1},{"lineBreak":true},{"text":"And parteth between the mighty.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"A brother offended is harder to be won than a strong city;","poem":1},{"lineBreak":true},{"text":"And such contentions are like the bars of a castle.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"A man’s belly shall be filled with the fruit of his mouth;","poem":1},{"lineBreak":true},{"text":"With the increase of his lips shall he be satisfied.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"Death and life are in the power of the tongue;","poem":1},{"lineBreak":true},{"text":"And they that love it shall eat the fruit thereof.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Whoso findeth a wife findeth a good thing,","poem":1},{"lineBreak":true},{"text":"And obtaineth favor of Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"The poor useth entreaties;","poem":1},{"lineBreak":true},{"text":"But the rich answereth roughly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"He that maketh many friends doeth it to his own destruction;","poem":1},{"lineBreak":true},{"text":"But there is a friend that sticketh closer than a brother.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":29,"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Better is the poor that walketh in his integrity","poem":1},{"lineBreak":true},{"text":"Than he that is perverse in his lips and is a fool.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Also, that the soul be without knowledge is not good;","poem":1},{"lineBreak":true},{"text":"And he that hasteth with his feet sinneth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"The foolishness of man subverteth his way;","poem":1},{"lineBreak":true},{"text":"And his heart fretteth against Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Wealth addeth many friends;","poem":1},{"lineBreak":true},{"text":"But the poor is separated from his friend.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"A false witness shall not be unpunished;","poem":1},{"lineBreak":true},{"text":"And he that uttereth lies shall not escape.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Many will entreat the favor of the liberal man;","poem":1},{"lineBreak":true},{"text":"And every man is a friend to him that giveth gifts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"All the brethren of the poor do hate him:","poem":1},{"lineBreak":true},{"text":"How much more do his friends go far from him!","poem":1},{"lineBreak":true},{"text":"He pursueth them with words, but they are gone.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"He that getteth wisdom loveth his own soul:","poem":1},{"lineBreak":true},{"text":"He that keepeth understanding shall find good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"A false witness shall not be unpunished;","poem":1},{"lineBreak":true},{"text":"And he that uttereth lies shall perish.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Delicate living is not seemly for a fool;","poem":1},{"lineBreak":true},{"text":"Much less for a servant to have rule over princes.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"The discretion of a man maketh him slow to anger;","poem":1},{"lineBreak":true},{"text":"And it is his glory to pass over a transgression.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"The king’s wrath is as the roaring of a lion;","poem":1},{"lineBreak":true},{"text":"But his favor is as dew upon the grass.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"A foolish son is the calamity of his father;","poem":1},{"lineBreak":true},{"text":"And the contentions of a wife are a continual dropping.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"House and riches are an inheritance from fathers;","poem":1},{"lineBreak":true},{"text":"But a prudent wife is from Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Slothfulness casteth into a deep sleep;","poem":1},{"lineBreak":true},{"text":"And the idle soul shall suffer hunger.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"He that keepeth the commandment keepeth his soul;","poem":1},{"lineBreak":true},{"text":"But he that is careless of his ways shall die.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"He that hath pity upon the poor lendeth unto Jehovah,","poem":1},{"lineBreak":true},{"text":"And his good deed will he pay him again.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Chasten thy son, seeing there is hope;","poem":1},{"lineBreak":true},{"text":"And set not thy heart on his destruction.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"A man of great wrath shall bear the penalty;","poem":1},{"lineBreak":true},{"text":"For if thou deliver him, thou must do it yet again.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Hear counsel, and receive instruction,","poem":1},{"lineBreak":true},{"text":"That thou mayest be wise in thy latter end.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"There are many devices in a man’s heart;","poem":1},{"lineBreak":true},{"text":"But the counsel of Jehovah, that shall stand.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"That which maketh a man to be desired is his kindness;","poem":1},{"lineBreak":true},{"text":"And a poor man is better than a liar.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"The fear of Jehovah tendeth to life;","poem":1},{"lineBreak":true},{"text":"And he that hath it shall abide satisfied;","poem":1},{"lineBreak":true},{"text":"He shall not be visited with evil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"The sluggard burieth his hand in the dish,","poem":1},{"lineBreak":true},{"text":"And will not so much as bring it to his mouth again.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Smite a scoffer, and the simple will learn prudence;","poem":1},{"lineBreak":true},{"text":"And reprove one that hath understanding, and he will understand knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"He that doeth violence to his father, and chaseth away his mother,","poem":1},{"lineBreak":true},{"text":"Is a son that causeth shame and bringeth reproach.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"Cease, my son, to hear instruction","poem":1},{"lineBreak":true},{"text":"Only to err from the words of knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"A worthless witness mocketh at justice;","poem":1},{"lineBreak":true},{"text":"And the mouth of the wicked swalloweth iniquity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Judgments are prepared for scoffers,","poem":1},{"lineBreak":true},{"text":"And stripes for the back of fools.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":30,"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Wine is a mocker, strong drink a brawler;","poem":1},{"lineBreak":true},{"text":"And whosoever erreth thereby is not wise.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"The terror of a king is as the roaring of a lion:","poem":1},{"lineBreak":true},{"text":"He that provoketh him to anger sinneth against his own life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"It is an honor for a man to keep aloof from strife;","poem":1},{"lineBreak":true},{"text":"But every fool will be quarrelling.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"The sluggard will not plow by reason of the winter;","poem":1},{"lineBreak":true},{"text":"Therefore he shall beg in harvest, and have nothing.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Counsel in the heart of man is like deep water;","poem":1},{"lineBreak":true},{"text":"But a man of understanding will draw it out.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Most men will proclaim every one his own kindness;","poem":1},{"lineBreak":true},{"text":"But a faithful man who can find?","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"A righteous man that walketh in his integrity,","poem":1},{"lineBreak":true},{"text":"Blessed are his children after him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"A king that sitteth on the throne of judgment","poem":1},{"lineBreak":true},{"text":"Scattereth away all evil with his eyes.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Who can say, I have made my heart clean,","poem":1},{"lineBreak":true},{"text":"I am pure from my sin?","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Diverse weights, and diverse measures,","poem":1},{"lineBreak":true},{"text":"Both of them alike are an abomination to Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Even a child maketh himself known by his doings,","poem":1},{"lineBreak":true},{"text":"Whether his work be pure, and whether it be right.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"The hearing ear, and the seeing eye,","poem":1},{"lineBreak":true},{"text":"Jehovah hath made even both of them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Love not sleep, lest thou come to poverty;","poem":1},{"lineBreak":true},{"text":"Open thine eyes, and thou shalt be satisfied with bread.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"It is bad, it is bad, saith the buyer;","poem":1},{"lineBreak":true},{"text":"But when he is gone his way, then he boasteth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"There is gold, and abundance of rubies;","poem":1},{"lineBreak":true},{"text":"But the lips of knowledge are a precious jewel.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Take his garment that is surety for a stranger;","poem":1},{"lineBreak":true},{"text":"And hold him in pledge that is surety for foreigners.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Bread of falsehood is sweet to a man;","poem":1},{"lineBreak":true},{"text":"But afterwards his mouth shall be filled with gravel.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Every purpose is established by counsel;","poem":1},{"lineBreak":true},{"text":"And by wise guidance make thou war.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"He that goeth about as a tale-bearer revealeth secrets;","poem":1},{"lineBreak":true},{"text":"Therefore company not with him that openeth wide his lips.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Whoso curseth his father or his mother,","poem":1},{"lineBreak":true},{"text":"His lamp shall be put out in blackness of darkness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"An inheritance may be gotten hastily at the beginning;","poem":1},{"lineBreak":true},{"text":"But the end thereof shall not be blessed.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Say not thou, I will recompense evil:","poem":1},{"lineBreak":true},{"text":"Wait for Jehovah, and he will save thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Diverse weights are an abomination to Jehovah;","poem":1},{"lineBreak":true},{"text":"And a false balance is not good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"A man’s goings are of Jehovah;","poem":1},{"lineBreak":true},{"text":"How then can man understand his way?","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"It is a snare to a man rashly to say, It is holy,","poem":1},{"lineBreak":true},{"text":"And after vows to make inquiry.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"A wise king winnoweth the wicked,","poem":1},{"lineBreak":true},{"text":"And bringeth the threshing-wheel over them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"The spirit of man is the lamp of Jehovah,","poem":1},{"lineBreak":true},{"text":"Searching all his innermost parts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Kindness and truth preserve the king;","poem":1},{"lineBreak":true},{"text":"And his throne is upholden by kindness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"The glory of young men is their strength;","poem":1},{"lineBreak":true},{"text":"And the beauty of old men is the hoary head.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"Stripes that wound cleanse away evil;","poem":1},{"lineBreak":true},{"text":"And strokes reach the innermost parts.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":31,"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"The king’s heart is in the hand of Jehovah as the watercourses:","poem":1},{"lineBreak":true},{"text":"He turneth it whithersoever he will.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Every way of a man is right in his own eyes;","poem":1},{"lineBreak":true},{"text":"But Jehovah weigheth the hearts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"To do righteousness and justice","poem":1},{"lineBreak":true},{"text":"Is more acceptable to Jehovah than sacrifice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"A high look, and a proud heart,","poem":1},{"lineBreak":true},{"text":"Even the lamp of the wicked, is sin.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"The thoughts of the diligent tend only to plenteousness;","poem":1},{"lineBreak":true},{"text":"But every one that is hasty hasteth only to want.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"The getting of treasures by a lying tongue","poem":1},{"lineBreak":true},{"text":"Is a vapor driven to and fro by them that seek death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The violence of the wicked shall sweep them away,","poem":1},{"lineBreak":true},{"text":"Because they refuse to do justice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The way of him that is laden with guilt is exceeding crooked;","poem":1},{"lineBreak":true},{"text":"But as for the pure, his work is right.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"It is better to dwell in the corner of the housetop,","poem":1},{"lineBreak":true},{"text":"Than with a contentious woman in a wide house.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The soul of the wicked desireth evil:","poem":1},{"lineBreak":true},{"text":"His neighbor findeth no favor in his eyes.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"When the scoffer is punished, the simple is made wise;","poem":1},{"lineBreak":true},{"text":"And when the wise is instructed, he receiveth knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"The righteous man considereth the house of the wicked,","poem":1},{"lineBreak":true},{"text":"How the wicked are overthrown to their ruin.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Whoso stoppeth his ears at the cry of the poor,","poem":1},{"lineBreak":true},{"text":"He also shall cry, but shall not be heard.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"A gift in secret pacifieth anger;","poem":1},{"lineBreak":true},{"text":"And a present in the bosom, strong wrath.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"It is joy to the righteous to do justice;","poem":1},{"lineBreak":true},{"text":"But it is a destruction to the workers of iniquity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"The man that wandereth out of the way of understanding","poem":1},{"lineBreak":true},{"text":"Shall rest in the assembly of the dead.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"He that loveth pleasure shall be a poor man:","poem":1},{"lineBreak":true},{"text":"He that loveth wine and oil shall not be rich.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"The wicked is a ransom for the righteous;","poem":1},{"lineBreak":true},{"text":"And the treacherous cometh in the stead of the upright.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"It is better to dwell in a desert land,","poem":1},{"lineBreak":true},{"text":"Than with a contentious and fretful woman.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"There is precious treasure and oil in the dwelling of the wise;","poem":1},{"lineBreak":true},{"text":"But a foolish man swalloweth it up.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"He that followeth after righteousness and kindness","poem":1},{"lineBreak":true},{"text":"Findeth life, righteousness, and honor.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"A wise man scaleth the city of the mighty,","poem":1},{"lineBreak":true},{"text":"And bringeth down the strength of the confidence thereof.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Whoso keepeth his mouth and his tongue","poem":1},{"lineBreak":true},{"text":"Keepeth his soul from troubles.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"The proud and haughty man, scoffer is his name;","poem":1},{"lineBreak":true},{"text":"He worketh in the arrogance of pride.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"The desire of the sluggard killeth him;","poem":1},{"lineBreak":true},{"text":"For his hands refuse to labor.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"There is that coveteth greedily all the day long;","poem":1},{"lineBreak":true},{"text":"But the righteous giveth and withholdeth not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"The sacrifice of the wicked is an abomination;","poem":1},{"lineBreak":true},{"text":"How much more, when he bringeth it with a wicked mind!","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"A false witness shall perish;","poem":1},{"lineBreak":true},{"text":"But the man that heareth shall speak so as to endure.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"A wicked man hardeneth his face;","poem":1},{"lineBreak":true},{"text":"But as for the upright, he establisheth his ways.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"There is no wisdom nor understanding","poem":1},{"lineBreak":true},{"text":"Nor counsel against Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"The horse is prepared against the day of battle;","poem":1},{"lineBreak":true},{"text":"But victory is of Jehovah.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":29,"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"A good name is rather to be chosen than great riches,","poem":1},{"lineBreak":true},{"text":"And loving favor rather than silver and gold.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"The rich and the poor meet together:","poem":1},{"lineBreak":true},{"text":"Jehovah is the maker of them all.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"A prudent man seeth the evil, and hideth himself;","poem":1},{"lineBreak":true},{"text":"But the simple pass on, and suffer for it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"The reward of humility and the fear of Jehovah","poem":1},{"lineBreak":true},{"text":"Is riches, and honor, and life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Thorns and snares are in the way of the perverse:","poem":1},{"lineBreak":true},{"text":"He that keepeth his soul shall be far from them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Train up a child in the way he should go,","poem":1},{"lineBreak":true},{"text":"And even when he is old he will not depart from it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The rich ruleth over the poor;","poem":1},{"lineBreak":true},{"text":"And the borrower is servant to the lender.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"He that soweth iniquity shall reap calamity;","poem":1},{"lineBreak":true},{"text":"And the rod of his wrath shall fail.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"He that hath a bountiful eye shall be blessed;","poem":1},{"lineBreak":true},{"text":"For he giveth of his bread to the poor.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Cast out the scoffer, and contention will go out;","poem":1},{"lineBreak":true},{"text":"Yea, strife and ignominy will cease.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"He that loveth pureness of heart,","poem":1},{"lineBreak":true},{"text":"For the grace of his lips the king will be his friend.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"The eyes of Jehovah preserve him that hath knowledge;","poem":1},{"lineBreak":true},{"text":"But he overthroweth the words of the treacherous man.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"The sluggard saith, There is a lion without;","poem":1},{"lineBreak":true},{"text":"I shall be slain in the streets.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The mouth of strange women is a deep pit;","poem":1},{"lineBreak":true},{"text":"He that is abhorred of Jehovah shall fall therein.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Foolishness is bound up in the heart of a child;","poem":1},{"lineBreak":true},{"text":"But the rod of correction shall drive it far from him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"He that oppresseth the poor to increase his gain,","poem":1},{"lineBreak":true},{"text":"And he that giveth to the rich, shall come only to want.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Incline thine ear, and hear the words of the wise,","poem":1},{"lineBreak":true},{"text":"And apply thy heart unto my knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"For it is a pleasant thing if thou keep them within thee,","poem":1},{"lineBreak":true},{"text":"If they be established together upon thy lips.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"That thy trust may be in Jehovah,","poem":1},{"lineBreak":true},{"text":"I have made them known to thee this day, even to thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Have not I written unto thee excellent things","poem":1},{"lineBreak":true},{"text":"Of counsels and knowledge,","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"To make thee know the certainty of the words of truth,","poem":1},{"lineBreak":true},{"text":"That thou mayest carry back words of truth to them that send thee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Rob not the poor, because he is poor;","poem":1},{"lineBreak":true},{"text":"Neither oppress the afflicted in the gate:","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"For Jehovah will plead their cause,","poem":1},{"lineBreak":true},{"text":"And despoil of life those that despoil them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Make no friendship with a man that is given to anger;","poem":1},{"lineBreak":true},{"text":"And with a wrathful man thou shalt not go:","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Lest thou learn his ways,","poem":1},{"lineBreak":true},{"text":"And get a snare to thy soul.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"Be thou not one of them that strike hands,","poem":1},{"lineBreak":true},{"text":"Or of them that are sureties for debts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"If thou hast not wherewith to pay,","poem":1},{"lineBreak":true},{"text":"Why should he take away thy bed from under thee?","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Remove not the ancient landmark,","poem":1},{"lineBreak":true},{"text":"Which thy fathers have set.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Seest thou a man diligent in his business? he shall stand before kings;","poem":1},{"lineBreak":true},{"text":"He shall not stand before mean men.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":35,"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"When thou sittest to eat with a ruler,","poem":1},{"lineBreak":true},{"text":"Consider diligently him that is before thee;","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"And put a knife to thy throat,","poem":1},{"lineBreak":true},{"text":"If thou be a man given to appetite.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Be not desirous of his dainties;","poem":1},{"lineBreak":true},{"text":"Seeing they are deceitful food.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Weary not thyself to be rich;","poem":1},{"lineBreak":true},{"text":"Cease from thine own wisdom.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Wilt thou set thine eyes upon that which is not?","poem":1},{"lineBreak":true},{"text":"For riches certainly make themselves wings,","poem":1},{"lineBreak":true},{"text":"Like an eagle that flieth toward heaven.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Eat thou not the bread of him that hath an evil eye,","poem":1},{"lineBreak":true},{"text":"Neither desire thou his dainties:","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"For as he thinketh within himself, so is he:","poem":1},{"lineBreak":true},{"text":"Eat and drink, saith he to thee;","poem":1},{"lineBreak":true},{"text":"But his heart is not with thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"The morsel which thou hast eaten shalt thou vomit up,","poem":1},{"lineBreak":true},{"text":"And lose thy sweet words.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Speak not in the hearing of a fool;","poem":1},{"lineBreak":true},{"text":"For he will despise the wisdom of thy words.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Remove not the ancient landmark;","poem":1},{"lineBreak":true},{"text":"And enter not into the fields of the fatherless:","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"For their Redeemer is strong;","poem":1},{"lineBreak":true},{"text":"He will plead their cause against thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Apply thy heart unto instruction,","poem":1},{"lineBreak":true},{"text":"And thine ears to the words of knowledge.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Withhold not correction from the child;","poem":1},{"lineBreak":true},{"text":"For if thou beat him with the rod, he will not die.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Thou shalt beat him with the rod,","poem":1},{"lineBreak":true},{"text":"And shalt deliver his soul from Sheol.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"My son, if thy heart be wise,","poem":1},{"lineBreak":true},{"text":"My heart will be glad, even mine:","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Yea, my heart will rejoice,","poem":1},{"lineBreak":true},{"text":"When thy lips speak right things.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Let not thy heart envy sinners;","poem":1},{"lineBreak":true},{"text":"But be thou in the fear of Jehovah all the day long:","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"For surely there is a reward;","poem":1},{"lineBreak":true},{"text":"And thy hope shall not be cut off.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"Hear thou, my son, and be wise,","poem":1},{"lineBreak":true},{"text":"And guide thy heart in the way.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Be not among winebibbers,","poem":1},{"lineBreak":true},{"text":"Among gluttonous eaters of flesh:","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"For the drunkard and the glutton shall come to poverty;","poem":1},{"lineBreak":true},{"text":"And drowsiness will clothe a man with rags.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Hearken unto thy father that begat thee,","poem":1},{"lineBreak":true},{"text":"And despise not thy mother when she is old.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Buy the truth, and sell it not;","poem":1},{"lineBreak":true},{"text":"Yea, wisdom, and instruction, and understanding.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"The father of the righteous will greatly rejoice;","poem":1},{"lineBreak":true},{"text":"And he that begetteth a wise child will have joy of him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Let thy father and thy mother be glad,","poem":1},{"lineBreak":true},{"text":"And let her that bare thee rejoice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"My son, give me thy heart;","poem":1},{"lineBreak":true},{"text":"And let thine eyes delight in my ways.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"For a harlot is a deep ditch;","poem":1},{"lineBreak":true},{"text":"And a foreign woman is a narrow pit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Yea, she lieth in wait as a robber,","poem":1},{"lineBreak":true},{"text":"And increaseth the treacherous among men.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Who hath woe? who hath sorrow? who hath contentions?","poem":1},{"lineBreak":true},{"text":"Who hath complaining? who hath wounds without cause?","poem":1},{"lineBreak":true},{"text":"Who hath redness of eyes?","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"They that tarry long at the wine;","poem":1},{"lineBreak":true},{"text":"They that go to seek out mixed wine.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"Look not thou upon the wine when it is red,","poem":1},{"lineBreak":true},{"text":"When it sparkleth in the cup,","poem":1},{"lineBreak":true},{"text":"When it goeth down smoothly:","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"At the last it biteth like a serpent,","poem":1},{"lineBreak":true},{"text":"And stingeth like an adder.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"Thine eyes shall behold strange things,","poem":1},{"lineBreak":true},{"text":"And thy heart shall utter perverse things.","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"Yea, thou shalt be as he that lieth down in the midst of the sea,","poem":1},{"lineBreak":true},{"text":"Or as he that lieth upon the top of a mast.","poem":1},{"lineBreak":true}]},{"type":"verse","number":35,"content":[{"text":"They have stricken me, shalt thou say, and I was not hurt;","poem":1},{"lineBreak":true},{"text":"They have beaten me, and I felt it not:","poem":1},{"lineBreak":true},{"text":"When shall I awake? I will seek it yet again.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":34,"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Be not thou envious against evil men;","poem":1},{"lineBreak":true},{"text":"Neither desire to be with them:","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"For their heart studieth oppression,","poem":1},{"lineBreak":true},{"text":"And their lips talk of mischief.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Through wisdom is a house builded;","poem":1},{"lineBreak":true},{"text":"And by understanding it is established;","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"And by knowledge are the chambers filled","poem":1},{"lineBreak":true},{"text":"With all precious and pleasant riches.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"A wise man is strong;","poem":1},{"lineBreak":true},{"text":"Yea, a man of knowledge increaseth might.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"For by wise guidance thou shalt make thy war;","poem":1},{"lineBreak":true},{"text":"And in the multitude of counsellors there is safety.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Wisdom is too high for a fool:","poem":1},{"lineBreak":true},{"text":"He openeth not his mouth in the gate.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"He that deviseth to do evil,","poem":1},{"lineBreak":true},{"text":"Men shall call him a mischief-maker.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"The thought of foolishness is sin;","poem":1},{"lineBreak":true},{"text":"And the scoffer is an abomination to men.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"If thou faint in the day of adversity,","poem":1},{"lineBreak":true},{"text":"Thy strength is small.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Deliver them that are carried away unto death,","poem":1},{"lineBreak":true},{"text":"And those that are ready to be slain see that thou hold back.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"If thou sayest, Behold, we knew not this;","poem":1},{"lineBreak":true},{"text":"Doth not he that weigheth the hearts consider it?","poem":1},{"lineBreak":true},{"text":"And he that keepeth thy soul, doth not he know it?","poem":1},{"lineBreak":true},{"text":"And shall not he render to every man according to his work?","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"My son, eat thou honey, for it is good;","poem":1},{"lineBreak":true},{"text":"And the droppings of the honeycomb, which are sweet to thy taste:","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"So shalt thou know wisdom to be unto thy soul;","poem":1},{"lineBreak":true},{"text":"If thou hast found it, then shall there be a reward,","poem":1},{"lineBreak":true},{"text":"And thy hope shall not be cut off.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Lay not wait, O wicked man, against the habitation of the righteous;","poem":1},{"lineBreak":true},{"text":"Destroy not his resting-place:","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"For a righteous man falleth seven times, and riseth up again;","poem":1},{"lineBreak":true},{"text":"But the wicked are overthrown by calamity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Rejoice not when thine enemy falleth,","poem":1},{"lineBreak":true},{"text":"And let not thy heart be glad when he is overthrown;","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Lest Jehovah see it, and it displease him,","poem":1},{"lineBreak":true},{"text":"And he turn away his wrath from him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"Fret not thyself because of evil-doers;","poem":1},{"lineBreak":true},{"text":"Neither be thou envious at the wicked:","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"For there shall be no reward to the evil man;","poem":1},{"lineBreak":true},{"text":"The lamp of the wicked shall be put out.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"My son, fear thou Jehovah and the king;","poem":1},{"lineBreak":true},{"text":"And company not with them that are given to change:","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"For their calamity shall rise suddenly;","poem":1},{"lineBreak":true},{"text":"And the destruction from them both, who knoweth it?","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":["These also are sayings of the wise.",{"lineBreak":true},{"text":"To have respect of persons in judgment is not good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"He that saith unto the wicked, Thou art righteous,","poem":1},{"lineBreak":true},{"text":"Peoples shall curse him, nations shall abhor him;","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"But to them that rebuke him shall be delight,","poem":1},{"lineBreak":true},{"text":"And a good blessing shall come upon them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"He kisseth the lips","poem":1},{"lineBreak":true},{"text":"Who giveth a right answer.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"Prepare thy work without,","poem":1},{"lineBreak":true},{"text":"And make it ready for thee in the field;","poem":1},{"lineBreak":true},{"text":"And afterwards build thy house.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Be not a witness against thy neighbor without cause;","poem":1},{"lineBreak":true},{"text":"And deceive not with thy lips.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Say not, I will do so to him as he hath done to me;","poem":1},{"lineBreak":true},{"text":"I will render to the man according to his work.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"I went by the field of the sluggard,","poem":1},{"lineBreak":true},{"text":"And by the vineyard of the man void of understanding;","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"And, lo, it was all grown over with thorns,","poem":1},{"lineBreak":true},{"text":"The face thereof was covered with nettles,","poem":1},{"lineBreak":true},{"text":"And the stone wall thereof was broken down.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"Then I beheld, and considered well;","poem":1},{"lineBreak":true},{"text":"I saw, and received instruction:","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"Yet a little sleep, a little slumber,","poem":1},{"lineBreak":true},{"text":"A little folding of the hands to sleep;","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"So shall thy poverty come as a robber,","poem":1},{"lineBreak":true},{"text":"And thy want as an armed man.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":28,"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["These also are proverbs of Solomon, which the men of Hezekiah king of Judah copied out."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"It is the glory of God to conceal a thing;","poem":1},{"lineBreak":true},{"text":"But the glory of kings is to search out a matter.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"As the heavens for height, and the earth for depth,","poem":1},{"lineBreak":true},{"text":"So the heart of kings is unsearchable.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Take away the dross from the silver,","poem":1},{"lineBreak":true},{"text":"And there cometh forth a vessel for the refiner:","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Take away the wicked from before the king,","poem":1},{"lineBreak":true},{"text":"And his throne shall be established in righteousness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Put not thyself forward in the presence of the king,","poem":1},{"lineBreak":true},{"text":"And stand not in the place of great men:","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"For better is it that it be said unto thee, Come up hither,","poem":1},{"lineBreak":true},{"text":"Than that thou shouldest be put lower in the presence of the prince,","poem":1},{"lineBreak":true},{"text":"Whom thine eyes have seen.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Go not forth hastily to strive,","poem":1},{"lineBreak":true},{"text":"Lest thou know not what to do in the end thereof,","poem":1},{"lineBreak":true},{"text":"When thy neighbor hath put thee to shame.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Debate thy cause with thy neighbor himself,","poem":1},{"lineBreak":true},{"text":"And disclose not the secret of another;","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Lest he that heareth it revile thee,","poem":1},{"lineBreak":true},{"text":"And thine infamy turn not away.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"A word fitly spoken","poem":1},{"lineBreak":true},{"text":"Is like apples of gold in network of silver.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"As an ear-ring of gold, and an ornament of fine gold,","poem":1},{"lineBreak":true},{"text":"So is a wise reprover upon an obedient ear.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"As the cold of snow in the time of harvest,","poem":1},{"lineBreak":true},{"text":"So is a faithful messenger to them that send him;","poem":1},{"lineBreak":true},{"text":"For he refresheth the soul of his masters.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"As clouds and wind without rain,","poem":1},{"lineBreak":true},{"text":"So is he that boasteth himself of his gifts falsely.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"By long forbearing is a ruler persuaded,","poem":1},{"lineBreak":true},{"text":"And a soft tongue breaketh the bone.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Hast thou found honey? eat so much as is sufficient for thee,","poem":1},{"lineBreak":true},{"text":"Lest thou be filled therewith, and vomit it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Let thy foot be seldom in thy neighbor’s house,","poem":1},{"lineBreak":true},{"text":"Lest he be weary of thee, and hate thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"A man that beareth false witness against his neighbor","poem":1},{"lineBreak":true},{"text":"Is a maul, and a sword, and a sharp arrow.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"Confidence in an unfaithful man in time of trouble","poem":1},{"lineBreak":true},{"text":"Is like a broken tooth, and a foot out of joint.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"As one that taketh off a garment in cold weather, and as vinegar upon soda,","poem":1},{"lineBreak":true},{"text":"So is he that singeth songs to a heavy heart.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"If thine enemy be hungry, give him bread to eat;","poem":1},{"lineBreak":true},{"text":"And if he be thirsty, give him water to drink:","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"For thou wilt heap coals of fire upon his head,","poem":1},{"lineBreak":true},{"text":"And Jehovah will reward thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"The north wind bringeth forth rain;","poem":1},{"lineBreak":true},{"text":"So doth a backbiting tongue an angry countenance.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"It is better to dwell in the corner of the housetop,","poem":1},{"lineBreak":true},{"text":"Than with a contentious woman in a wide house.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"As cold waters to a thirsty soul,","poem":1},{"lineBreak":true},{"text":"So is good news from a far country.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"As a troubled fountain, and a corrupted spring,","poem":1},{"lineBreak":true},{"text":"So is a righteous man that giveth way before the wicked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"It is not good to eat much honey;","poem":1},{"lineBreak":true},{"text":"So for men to search out their own glory is grievous.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"He whose spirit is without restraint","poem":1},{"lineBreak":true},{"text":"Is like a city that is broken down and without walls.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":28,"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"As snow in summer, and as rain in harvest,","poem":1},{"lineBreak":true},{"text":"So honor is not seemly for a fool.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"As the sparrow in her wandering, as the swallow in her flying,","poem":1},{"lineBreak":true},{"text":"So the curse that is causeless alighteth not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"A whip for the horse, a bridle for the ass,","poem":1},{"lineBreak":true},{"text":"And a rod for the back of fools.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Answer not a fool according to his folly,","poem":1},{"lineBreak":true},{"text":"Lest thou also be like unto him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Answer a fool according to his folly,","poem":1},{"lineBreak":true},{"text":"Lest he be wise in his own conceit.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"He that sendeth a message by the hand of a fool","poem":1},{"lineBreak":true},{"text":"Cutteth off his own feet, and drinketh in damage.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The legs of the lame hang loose;","poem":1},{"lineBreak":true},{"text":"So is a parable in the mouth of fools.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"As one that bindeth a stone in a sling,","poem":1},{"lineBreak":true},{"text":"So is he that giveth honor to a fool.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"As a thorn that goeth up into the hand of a drunkard,","poem":1},{"lineBreak":true},{"text":"So is a parable in the mouth of fools.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"As an archer that woundeth all,","poem":1},{"lineBreak":true},{"text":"So is he that hireth a fool and he that hireth them that pass by.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"As a dog that returneth to his vomit,","poem":1},{"lineBreak":true},{"text":"So is a fool that repeateth his folly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Seest thou a man wise in his own conceit?","poem":1},{"lineBreak":true},{"text":"There is more hope of a fool than of him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"The sluggard saith, There is a lion in the way;","poem":1},{"lineBreak":true},{"text":"A lion is in the streets.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"As the door turneth upon its hinges,","poem":1},{"lineBreak":true},{"text":"So doth the sluggard upon his bed.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The sluggard burieth his hand in the dish;","poem":1},{"lineBreak":true},{"text":"It wearieth him to bring it again to his mouth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"The sluggard is wiser in his own conceit","poem":1},{"lineBreak":true},{"text":"Than seven men that can render a reason.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"He that passeth by, and vexeth himself with strife belonging not to him,","poem":1},{"lineBreak":true},{"text":"Is like one that taketh a dog by the ears.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"As a madman who casteth firebrands,","poem":1},{"lineBreak":true},{"text":"Arrows, and death,","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"So is the man that deceiveth his neighbor,","poem":1},{"lineBreak":true},{"text":"And saith, Am not I in sport?","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"For lack of wood the fire goeth out;","poem":1},{"lineBreak":true},{"text":"And where there is no whisperer, contention ceaseth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"As coals are to hot embers, and wood to fire,","poem":1},{"lineBreak":true},{"text":"So is a contentious man to inflame strife.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"The words of a whisperer are as dainty morsels,","poem":1},{"lineBreak":true},{"text":"And they go down into the innermost parts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Fervent lips and a wicked heart","poem":1},{"lineBreak":true},{"text":"Are like an earthen vessel overlaid with silver dross.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"He that hateth dissembleth with his lips;","poem":1},{"lineBreak":true},{"text":"But he layeth up deceit within him:","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"When he speaketh fair, believe him not;","poem":1},{"lineBreak":true},{"text":"For there are seven abominations in his heart:","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"Though his hatred cover itself with guile,","poem":1},{"lineBreak":true},{"text":"His wickedness shall be openly showed before the assembly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"Whoso diggeth a pit shall fall therein;","poem":1},{"lineBreak":true},{"text":"And he that rolleth a stone, it shall return upon him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"A lying tongue hateth those whom it hath wounded;","poem":1},{"lineBreak":true},{"text":"And a flattering mouth worketh ruin.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":27,"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Boast not thyself of to-morrow;","poem":1},{"lineBreak":true},{"text":"For thou knowest not what a day may bring forth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Let another man praise thee, and not thine own mouth;","poem":1},{"lineBreak":true},{"text":"A stranger, and not thine own lips.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"A stone is heavy, and the sand weighty;","poem":1},{"lineBreak":true},{"text":"But a fool’s vexation is heavier than they both.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Wrath is cruel, and anger is overwhelming;","poem":1},{"lineBreak":true},{"text":"But who is able to stand before jealousy?","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Better is open rebuke","poem":1},{"lineBreak":true},{"text":"Than love that is hidden.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Faithful are the wounds of a friend;","poem":1},{"lineBreak":true},{"text":"But the kisses of an enemy are profuse.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The full soul loatheth a honeycomb;","poem":1},{"lineBreak":true},{"text":"But to the hungry soul every bitter thing is sweet.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"As a bird that wandereth from her nest,","poem":1},{"lineBreak":true},{"text":"So is a man that wandereth from his place.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Oil and perfume rejoice the heart;","poem":1},{"lineBreak":true},{"text":"So doth the sweetness of a man’s friend that cometh of hearty counsel.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Thine own friend, and thy father’s friend, forsake not;","poem":1},{"lineBreak":true},{"text":"And go not to thy brother’s house in the day of thy calamity:","poem":1},{"lineBreak":true},{"text":"Better is a neighbor that is near than a brother far off.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"My son, be wise, and make my heart glad,","poem":1},{"lineBreak":true},{"text":"That I may answer him that reproacheth me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"A prudent man seeth the evil, and hideth himself;","poem":1},{"lineBreak":true},{"text":"But the simple pass on, and suffer for it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Take his garment that is surety for a stranger;","poem":1},{"lineBreak":true},{"text":"And hold him in pledge that is surety for a foreign woman.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"He that blesseth his friend with a loud voice, rising early in the morning,","poem":1},{"lineBreak":true},{"text":"It shall be counted a curse to him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"A continual dropping in a very rainy day","poem":1},{"lineBreak":true},{"text":"And a contentious woman are alike:","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"He that would restrain her restraineth the wind;","poem":1},{"lineBreak":true},{"text":"And his right hand encountereth oil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Iron sharpeneth iron;","poem":1},{"lineBreak":true},{"text":"So a man sharpeneth the countenance of his friend.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Whoso keepeth the fig-tree shall eat the fruit thereof;","poem":1},{"lineBreak":true},{"text":"And he that regardeth his master shall be honored.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"As in water face answereth to face,","poem":1},{"lineBreak":true},{"text":"So the heart of man to man.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Sheol and Abaddon are never satisfied;","poem":1},{"lineBreak":true},{"text":"And the eyes of man are never satisfied.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"The refining pot is for silver, and the furnace for gold;","poem":1},{"lineBreak":true},{"text":"And a man is tried by his praise.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Though thou shouldest bray a fool in a mortar with a pestle along with bruised grain,","poem":1},{"lineBreak":true},{"text":"Yet will not his foolishness depart from him.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Be thou diligent to know the state of thy flocks,","poem":1},{"lineBreak":true},{"text":"And look well to thy herds:","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"For riches are not for ever;","poem":1},{"lineBreak":true},{"text":"And doth the crown endure unto all generations?","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"The hay is carried, and the tender grass showeth itself,","poem":1},{"lineBreak":true},{"text":"And the herbs of the mountains are gathered in.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"The lambs are for thy clothing,","poem":1},{"lineBreak":true},{"text":"And the goats are the price of the field;","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"And there will be goats’ milk enough for thy food, for the food of thy household,","poem":1},{"lineBreak":true},{"text":"And maintenance for thy maidens.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":28,"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"The wicked flee when no man pursueth;","poem":1},{"lineBreak":true},{"text":"But the righteous are bold as a lion.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"For the transgression of a land many are the princes thereof;","poem":1},{"lineBreak":true},{"text":"But by men of understanding and knowledge the state thereof shall be prolonged.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"A needy man that oppresseth the poor","poem":1},{"lineBreak":true},{"text":"Is like a sweeping rain which leaveth no food.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"They that forsake the law praise the wicked;","poem":1},{"lineBreak":true},{"text":"But such as keep the law contend with them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Evil men understand not justice;","poem":1},{"lineBreak":true},{"text":"But they that seek Jehovah understand all things.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Better is the poor that walketh in his integrity,","poem":1},{"lineBreak":true},{"text":"Than he that is perverse in his ways, though he be rich.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Whoso keepeth the law is a wise son;","poem":1},{"lineBreak":true},{"text":"But he that is a companion of gluttons shameth his father.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"He that augmenteth his substance by interest and increase,","poem":1},{"lineBreak":true},{"text":"Gathereth it for him that hath pity on the poor.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"He that turneth away his ear from hearing the law,","poem":1},{"lineBreak":true},{"text":"Even his prayer is an abomination.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Whoso causeth the upright to go astray in an evil way,","poem":1},{"lineBreak":true},{"text":"He shall fall himself into his own pit;","poem":1},{"lineBreak":true},{"text":"But the perfect shall inherit good.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"The rich man is wise in his own conceit;","poem":1},{"lineBreak":true},{"text":"But the poor that hath understanding searcheth him out.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"When the righteous triumph, there is great glory;","poem":1},{"lineBreak":true},{"text":"But when the wicked rise, men hide themselves.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"He that covereth his transgressions shall not prosper;","poem":1},{"lineBreak":true},{"text":"But whoso confesseth and forsaketh them shall obtain mercy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Happy is the man that feareth alway;","poem":1},{"lineBreak":true},{"text":"But he that hardeneth his heart shall fall into mischief.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"As a roaring lion, and a ranging bear,","poem":1},{"lineBreak":true},{"text":"So is a wicked ruler over a poor people.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"The prince that lacketh understanding is also a great oppressor;","poem":1},{"lineBreak":true},{"text":"But he that hateth covetousness shall prolong his days.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"A man that is laden with the blood of any person","poem":1},{"lineBreak":true},{"text":"Shall flee unto the pit; let no man stay him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Whoso walketh uprightly shall be delivered;","poem":1},{"lineBreak":true},{"text":"But he that is perverse in his ways shall fall at once.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"He that tilleth his land shall have plenty of bread;","poem":1},{"lineBreak":true},{"text":"But he that followeth after vain persons shall have poverty enough.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"A faithful man shall abound with blessings;","poem":1},{"lineBreak":true},{"text":"But he that maketh haste to be rich shall not be unpunished.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"To have respect of persons is not good;","poem":1},{"lineBreak":true},{"text":"Neither that a man should transgress for a piece of bread.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"He that hath an evil eye hasteth after riches,","poem":1},{"lineBreak":true},{"text":"And knoweth not that want shall come upon him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"He that rebuketh a man shall afterward find more favor","poem":1},{"lineBreak":true},{"text":"Than he that flattereth with the tongue.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Whoso robbeth his father or his mother, and saith, It is no transgression,","poem":1},{"lineBreak":true},{"text":"The same is the companion of a destroyer.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"He that is of a greedy spirit stirreth up strife;","poem":1},{"lineBreak":true},{"text":"But he that putteth his trust in Jehovah shall be made fat.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"He that trusteth in his own heart is a fool;","poem":1},{"lineBreak":true},{"text":"But whoso walketh wisely, he shall be delivered.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"He that giveth unto the poor shall not lack;","poem":1},{"lineBreak":true},{"text":"But he that hideth his eyes shall have many a curse.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"When the wicked rise, men hide themselves;","poem":1},{"lineBreak":true},{"text":"But when they perish, the righteous increase.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":27,"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"He that being often reproved hardeneth his neck","poem":1},{"lineBreak":true},{"text":"Shall suddenly be destroyed, and that without remedy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"When the righteous are increased, the people rejoice;","poem":1},{"lineBreak":true},{"text":"But when a wicked man beareth rule, the people sigh.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Whoso loveth wisdom rejoiceth his father;","poem":1},{"lineBreak":true},{"text":"But he that keepeth company with harlots wasteth his substance.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"The king by justice establisheth the land;","poem":1},{"lineBreak":true},{"text":"But he that exacteth gifts overthroweth it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"A man that flattereth his neighbor","poem":1},{"lineBreak":true},{"text":"Spreadeth a net for his steps.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"In the transgression of an evil man there is a snare;","poem":1},{"lineBreak":true},{"text":"But the righteous doth sing and rejoice.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The righteous taketh knowledge of the cause of the poor;","poem":1},{"lineBreak":true},{"text":"The wicked hath not understanding to know it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Scoffers set a city in a flame;","poem":1},{"lineBreak":true},{"text":"But wise men turn away wrath.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"If a wise man hath a controversy with a foolish man,","poem":1},{"lineBreak":true},{"text":"Whether he be angry or laugh, there will be no rest.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The bloodthirsty hate him that is perfect;","poem":1},{"lineBreak":true},{"text":"And as for the upright, they seek his life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"A fool uttereth all his anger;","poem":1},{"lineBreak":true},{"text":"But a wise man keepeth it back and stilleth it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"If a ruler hearkeneth to falsehood,","poem":1},{"lineBreak":true},{"text":"All his servants are wicked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"The poor man and the oppressor meet together;","poem":1},{"lineBreak":true},{"text":"Jehovah lighteneth the eyes of them both.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The king that faithfully judgeth the poor,","poem":1},{"lineBreak":true},{"text":"His throne shall be established for ever.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The rod and reproof give wisdom;","poem":1},{"lineBreak":true},{"text":"But a child left to himself causeth shame to his mother.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"When the wicked are increased, transgression increaseth;","poem":1},{"lineBreak":true},{"text":"But the righteous shall look upon their fall.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Correct thy son, and he will give thee rest;","poem":1},{"lineBreak":true},{"text":"Yea, he will give delight unto thy soul.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Where there is no vision, the people cast off restraint;","poem":1},{"lineBreak":true},{"text":"But he that keepeth the law, happy is he.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"A servant will not be corrected by words;","poem":1},{"lineBreak":true},{"text":"For though he understand, he will not give heed.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Seest thou a man that is hasty in his words?","poem":1},{"lineBreak":true},{"text":"There is more hope of a fool than of him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"He that delicately bringeth up his servant from a child","poem":1},{"lineBreak":true},{"text":"Shall have him become a son at the last.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"An angry man stirreth up strife,","poem":1},{"lineBreak":true},{"text":"And a wrathful man aboundeth in transgression.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"A man’s pride shall bring him low;","poem":1},{"lineBreak":true},{"text":"But he that is of a lowly spirit shall obtain honor.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Whoso is partner with a thief hateth his own soul;","poem":1},{"lineBreak":true},{"text":"He heareth the adjuration and uttereth nothing.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"The fear of man bringeth a snare;","poem":1},{"lineBreak":true},{"text":"But whoso putteth his trust in Jehovah shall be safe.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"Many seek the ruler’s favor;","poem":1},{"lineBreak":true},{"text":"But a man’s judgment cometh from Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"An unjust man is an abomination to the righteous;","poem":1},{"lineBreak":true},{"text":"And he that is upright in the way is an abomination to the wicked.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":33,"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["The words of Agur the son of Jakeh; the oracle.",{"lineBreak":true},{"text":"The man saith unto Ithiel, unto Ithiel and Ucal:","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Surely I am more brutish than any man,","poem":1},{"lineBreak":true},{"text":"And have not the understanding of a man;","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"And I have not learned wisdom,","poem":1},{"lineBreak":true},{"text":"Neither have I the knowledge of the Holy One.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Who hath ascended up into heaven, and descended?","poem":1},{"lineBreak":true},{"text":"Who hath gathered the wind in his fists?","poem":1},{"lineBreak":true},{"text":"Who hath bound the waters in his garment?","poem":1},{"lineBreak":true},{"text":"Who hath established all the ends of the earth?","poem":1},{"lineBreak":true},{"text":"What is his name, and what is his son’s name, if thou knowest?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Every word of God is tried:","poem":1},{"lineBreak":true},{"text":"He is a shield unto them that take refuge in him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Add thou not unto his words,","poem":1},{"lineBreak":true},{"text":"Lest he reprove thee, and thou be found a liar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Two things have I asked of thee;","poem":1},{"lineBreak":true},{"text":"Deny me them not before I die:","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Remove far from me falsehood and lies;","poem":1},{"lineBreak":true},{"text":"Give me neither poverty nor riches;","poem":1},{"lineBreak":true},{"text":"Feed me with the food that is needful for me:","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Lest I be full, and deny thee, and say, Who is Jehovah?","poem":1},{"lineBreak":true},{"text":"Or lest I be poor, and steal,","poem":1},{"lineBreak":true},{"text":"And use profanely the name of my God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Slander not a servant unto his master,","poem":1},{"lineBreak":true},{"text":"Lest he curse thee, and thou be held guilty.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"There is a generation that curse their father,","poem":1},{"lineBreak":true},{"text":"And bless not their mother.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"There is a generation that are pure in their own eyes,","poem":1},{"lineBreak":true},{"text":"And yet are not washed from their filthiness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"There is a generation, oh how lofty are their eyes!","poem":1},{"lineBreak":true},{"text":"And their eyelids are lifted up.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"There is a generation whose teeth are as swords, and their jaw teeth as knives,","poem":1},{"lineBreak":true},{"text":"To devour the poor from off the earth, and the needy from among men.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"The horseleach hath two daughters, crying, Give, give.","poem":1},{"lineBreak":true},{"text":"There are three things that are never satisfied,","poem":1},{"lineBreak":true},{"text":"Yea, four that say not, Enough:","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"Sheol; and the barren womb;","poem":1},{"lineBreak":true},{"text":"The earth that is not satisfied with water;","poem":1},{"lineBreak":true},{"text":"And the fire that saith not, Enough.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"The eye that mocketh at his father,","poem":1},{"lineBreak":true},{"text":"And despiseth to obey his mother,","poem":1},{"lineBreak":true},{"text":"The ravens of the valley shall pick it out,","poem":1},{"lineBreak":true},{"text":"And the young eagles shall eat it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"There are three things which are too wonderful for me,","poem":1},{"lineBreak":true},{"text":"Yea, four which I know not:","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"The way of an eagle in the air;","poem":1},{"lineBreak":true},{"text":"The way of a serpent upon a rock;","poem":1},{"lineBreak":true},{"text":"The way of a ship in the midst of the sea;","poem":1},{"lineBreak":true},{"text":"And the way of a man with a maiden.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"So is the way of an adulterous woman;","poem":1},{"lineBreak":true},{"text":"She eateth, and wipeth her mouth,","poem":1},{"lineBreak":true},{"text":"And saith, I have done no wickedness.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"For three things the earth doth tremble,","poem":1},{"lineBreak":true},{"text":"And for four, which it cannot bear:","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"For a servant when he is king;","poem":1},{"lineBreak":true},{"text":"And a fool when he is filled with food;","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"For an odious woman when she is married;","poem":1},{"lineBreak":true},{"text":"And a handmaid that is heir to her mistress.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"There are four things which are little upon the earth,","poem":1},{"lineBreak":true},{"text":"But they are exceeding wise:","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"The ants are a people not strong,","poem":1},{"lineBreak":true},{"text":"Yet they provide their food in the summer;","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"The conies are but a feeble folk,","poem":1},{"lineBreak":true},{"text":"Yet make they their houses in the rocks;","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"The locusts have no king,","poem":1},{"lineBreak":true},{"text":"Yet go they forth all of them by bands;","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"The lizard taketh hold with her hands,","poem":1},{"lineBreak":true},{"text":"Yet is she in kings’ palaces.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"There are three things which are stately in their march,","poem":1},{"lineBreak":true},{"text":"Yea, four which are stately in going:","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"The lion, which is mightiest among beasts,","poem":1},{"lineBreak":true},{"text":"And turneth not away for any;","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"The greyhound; the he-goat also;","poem":1},{"lineBreak":true},{"text":"And the king against whom there is no rising up.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"If thou hast done foolishly in lifting up thyself,","poem":1},{"lineBreak":true},{"text":"Or if thou hast thought evil,","poem":1},{"lineBreak":true},{"text":"Lay thy hand upon thy mouth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"For the churning of milk bringeth forth butter,","poem":1},{"lineBreak":true},{"text":"And the wringing of the nose bringeth forth blood;","poem":1},{"lineBreak":true},{"text":"So the forcing of wrath bringeth forth strife.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":31,"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["The words of king Lemuel; the oracle which his mother taught him."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"What, my son? and what, O son of my womb?","poem":1},{"lineBreak":true},{"text":"And what, O son of my vows?","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Give not thy strength unto women,","poem":1},{"lineBreak":true},{"text":"Nor thy ways to that which destroyeth kings.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"It is not for kings, O Lemuel, it is not for kings to drink wine;","poem":1},{"lineBreak":true},{"text":"Nor for princes to say, Where is strong drink?","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Lest they drink, and forget the law,","poem":1},{"lineBreak":true},{"text":"And pervert the justice due to any that is afflicted.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Give strong drink unto him that is ready to perish,","poem":1},{"lineBreak":true},{"text":"And wine unto the bitter in soul:","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Let him drink, and forget his poverty,","poem":1},{"lineBreak":true},{"text":"And remember his misery no more.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Open thy mouth for the dumb,","poem":1},{"lineBreak":true},{"text":"In the cause of all such as are left desolate.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Open thy mouth, judge righteously,","poem":1},{"lineBreak":true},{"text":"And minister justice to the poor and needy.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"A worthy woman who can find?","poem":1},{"lineBreak":true},{"text":"For her price is far above rubies.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"The heart of her husband trusteth in her,","poem":1},{"lineBreak":true},{"text":"And he shall have no lack of gain.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"She doeth him good and not evil","poem":1},{"lineBreak":true},{"text":"All the days of her life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"She seeketh wool and flax,","poem":1},{"lineBreak":true},{"text":"And worketh willingly with her hands.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"She is like the merchant-ships;","poem":1},{"lineBreak":true},{"text":"She bringeth her bread from afar.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"She riseth also while it is yet night,","poem":1},{"lineBreak":true},{"text":"And giveth food to her household,","poem":1},{"lineBreak":true},{"text":"And their task to her maidens.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"She considereth a field, and buyeth it;","poem":1},{"lineBreak":true},{"text":"With the fruit of her hands she planteth a vineyard.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"She girdeth her loins with strength,","poem":1},{"lineBreak":true},{"text":"And maketh strong her arms.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"She perceiveth that her merchandise is profitable;","poem":1},{"lineBreak":true},{"text":"Her lamp goeth not out by night.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"She layeth her hands to the distaff,","poem":1},{"lineBreak":true},{"text":"And her hands hold the spindle.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"She stretcheth out her hand to the poor;","poem":1},{"lineBreak":true},{"text":"Yea, she reacheth forth her hands to the needy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"She is not afraid of the snow for her household;","poem":1},{"lineBreak":true},{"text":"For all her household are clothed with scarlet.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"She maketh for herself carpets of tapestry;","poem":1},{"lineBreak":true},{"text":"Her clothing is fine linen and purple.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"Her husband is known in the gates,","poem":1},{"lineBreak":true},{"text":"When he sitteth among the elders of the land.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"She maketh linen garments and selleth them,","poem":1},{"lineBreak":true},{"text":"And delivereth girdles unto the merchant.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Strength and dignity are her clothing;","poem":1},{"lineBreak":true},{"text":"And she laugheth at the time to come.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"She openeth her mouth with wisdom;","poem":1},{"lineBreak":true},{"text":"And the law of kindness is on her tongue.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"She looketh well to the ways of her household,","poem":1},{"lineBreak":true},{"text":"And eateth not the bread of idleness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Her children rise up, and call her blessed;","poem":1},{"lineBreak":true},{"text":"Her husband also, and he praiseth her, saying:","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Many daughters have done worthily,","poem":1},{"lineBreak":true},{"text":"But thou excellest them all.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"Grace is deceitful, and beauty is vain;","poem":1},{"lineBreak":true},{"text":"But a woman that feareth Jehovah, she shall be praised.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"Give her of the fruit of her hands;","poem":1},{"lineBreak":true},{"text":"And let her works praise her in the gates.","poem":1}]}],"footnotes":[]}}]}
