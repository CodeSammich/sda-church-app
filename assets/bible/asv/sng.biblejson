{"translation":{"id":"eng_asv","name":"American Standard Version (1901)","website":"https://ebible.org/Scriptures/details.php?id=eng-asv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-asv","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"ASV","englishName":"American Standard Version (1901)","language":"eng","textDirection":"ltr","sha256":"154967f9f68504bdf9a8d7abaae4ef6a93f20f779df84e62c1c8828427731839","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_asv/books.json","completeTranslationApiLink":"/api/eng_asv/complete.json","simpleCompleteTranslationApiLink":"/api/eng_asv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"SNG","name":"Song of Solomon","commonName":"Song of Solomon","title":"THE SONG OF SOLOMON","numberOfChapters":8,"totalNumberOfVerses":117},"chapters":[null,{"numberOfVerses":17,"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["The Song of songs, which is Solomon’s."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Let him kiss me with the kisses of his mouth;","poem":1},{"lineBreak":true},{"text":"For thy love is better than wine.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Thine oils have a goodly fragrance;","poem":1},{"lineBreak":true},{"text":"Thy name is as oil poured forth;","poem":1},{"lineBreak":true},{"text":"Therefore do the virgins love thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Draw me; we will run after thee:","poem":1},{"lineBreak":true},{"text":"The king hath brought me into his chambers;","poem":1},{"lineBreak":true},{"text":"We will be glad and rejoice in thee;","poem":1},{"lineBreak":true},{"text":"We will make mention of thy love more than of wine:","poem":1},{"lineBreak":true},{"text":"Rightly do they love thee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I am black, but comely,","poem":1},{"lineBreak":true},{"text":"O ye daughters of Jerusalem,","poem":1},{"lineBreak":true},{"text":"As the tents of Kedar,","poem":1},{"lineBreak":true},{"text":"As the curtains of Solomon.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Look not upon me, because I am swarthy,","poem":1},{"lineBreak":true},{"text":"Because the sun hath scorched me.","poem":1},{"lineBreak":true},{"text":"My mother’s sons were incensed against me;","poem":1},{"lineBreak":true},{"text":"They made me keeper of the vineyards;","poem":1},{"lineBreak":true},{"text":"But mine own vineyard have I not kept.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Tell me, O thou whom my soul loveth,","poem":1},{"lineBreak":true},{"text":"Where thou feedest thy flock,","poem":1},{"lineBreak":true},{"text":"Where thou makest it to rest at noon:","poem":1},{"lineBreak":true},{"text":"For why should I be as one that is veiled","poem":1},{"lineBreak":true},{"text":"Beside the flocks of thy companions?","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"If thou know not, O thou fairest among women,","poem":1},{"lineBreak":true},{"text":"Go thy way forth by the footsteps of the flock,","poem":1},{"lineBreak":true},{"text":"And feed thy kids beside the shepherds’ tents.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I have compared thee, O my love,","poem":1},{"lineBreak":true},{"text":"To a steed in Pharaoh’s chariots.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Thy cheeks are comely with plaits of hair,","poem":1},{"lineBreak":true},{"text":"Thy neck with strings of jewels.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"We will make thee plaits of gold","poem":1},{"lineBreak":true},{"text":"With studs of silver.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"While the king sat at his table,","poem":1},{"lineBreak":true},{"text":"My spikenard sent forth its fragrance.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"My beloved is unto me as a bundle of myrrh,","poem":1},{"lineBreak":true},{"text":"That lieth betwixt my breasts.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"My beloved is unto me as a cluster of henna-flowers","poem":1},{"lineBreak":true},{"text":"In the vineyards of En-gedi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Behold, thou art fair, my love;","poem":1},{"lineBreak":true},{"text":"Behold thou art fair;","poem":1},{"lineBreak":true},{"text":"Thine eyes are as doves.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Behold, thou art fair, my beloved, yea, pleasant:","poem":1},{"lineBreak":true},{"text":"Also our couch is green.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"The beams of our house are cedars,","poem":1},{"lineBreak":true},{"text":"And our rafters are firs.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":17,"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"I am a rose of Sharon,","poem":1},{"lineBreak":true},{"text":"A lily of the valleys.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"As a lily among thorns,","poem":1},{"lineBreak":true},{"text":"So is my love among the daughters.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"As the apple-tree among the trees of the wood,","poem":1},{"lineBreak":true},{"text":"So is my beloved among the sons.","poem":1},{"lineBreak":true},{"text":"I sat down under his shadow with great delight,","poem":1},{"lineBreak":true},{"text":"And his fruit was sweet to my taste.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"He brought me to the banqueting-house,","poem":1},{"lineBreak":true},{"text":"And his banner over me was love.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Stay ye me with raisins, refresh me with apples;","poem":1},{"lineBreak":true},{"text":"For I am sick from love.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"His left hand is under my head,","poem":1},{"lineBreak":true},{"text":"And his right hand doth embrace me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I adjure you, O daughters of Jerusalem,","poem":1},{"lineBreak":true},{"text":"By the roes, or by the hinds of the field,","poem":1},{"lineBreak":true},{"text":"That ye stir not up, nor awake my love,","poem":1},{"lineBreak":true},{"text":"Until he please.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"The voice of my beloved! behold, he cometh,","poem":1},{"lineBreak":true},{"text":"Leaping upon the mountains,","poem":1},{"lineBreak":true},{"text":"Skipping upon the hills.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"My beloved is like a roe or a young hart:","poem":1},{"lineBreak":true},{"text":"Behold, he standeth behind our wall;","poem":1},{"lineBreak":true},{"text":"He looketh in at the windows;","poem":1},{"lineBreak":true},{"text":"He glanceth through the lattice.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"My beloved spake, and said unto me,","poem":1},{"lineBreak":true},{"text":"Rise up, my love, my fair one, and come away.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"For, lo, the winter is past;","poem":1},{"lineBreak":true},{"text":"The rain is over and gone;","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"The flowers appear on the earth;","poem":1},{"lineBreak":true},{"text":"The time of the singing of birds is come,","poem":1},{"lineBreak":true},{"text":"And the voice of the turtle-dove is heard in our land;","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"The fig-tree ripeneth her green figs,","poem":1},{"lineBreak":true},{"text":"And the vines are in blossom;","poem":1},{"lineBreak":true},{"text":"They give forth their fragrance.","poem":1},{"lineBreak":true},{"text":"Arise, my love, my fair one, and come away.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"O my dove, that art in the clefts of the rock,","poem":1},{"lineBreak":true},{"text":"In the covert of the steep place,","poem":1},{"lineBreak":true},{"text":"Let me see thy countenance,","poem":1},{"lineBreak":true},{"text":"Let me hear thy voice;","poem":1},{"lineBreak":true},{"text":"For sweet is thy voice, and thy countenance is comely.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Take us the foxes, the little foxes,","poem":1},{"lineBreak":true},{"text":"That spoil the vineyards;","poem":1},{"lineBreak":true},{"text":"For our vineyards are in blossom.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"My beloved is mine, and I am his:","poem":1},{"lineBreak":true},{"text":"He feedeth his flock among the lilies.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Until the day be cool, and the shadows flee away,","poem":1},{"lineBreak":true},{"text":"Turn, my beloved, and be thou like a roe or a young hart","poem":1},{"lineBreak":true},{"text":"Upon the mountains of Bether.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":11,"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"By night on my bed","poem":1},{"lineBreak":true},{"text":"I sought him whom my soul loveth:","poem":1},{"lineBreak":true},{"text":"I sought him, but I found him not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"I said, I will rise now, and go about the city;","poem":1},{"lineBreak":true},{"text":"In the streets and in the broad ways","poem":1},{"lineBreak":true},{"text":"I will seek him whom my soul loveth:","poem":1},{"lineBreak":true},{"text":"I sought him, but I found him not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"The watchmen that go about the city found me;","poem":1},{"lineBreak":true},{"text":"To whom I said, Saw ye him whom my soul loveth?","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"It was but a little that I passed from them,","poem":1},{"lineBreak":true},{"text":"When I found him whom my soul loveth:","poem":1},{"lineBreak":true},{"text":"I held him, and would not let him go,","poem":1},{"lineBreak":true},{"text":"Until I had brought him into my mother’s house,","poem":1},{"lineBreak":true},{"text":"And into the chamber of her that conceived me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I adjure you, O daughters of Jerusalem,","poem":1},{"lineBreak":true},{"text":"By the roes, or by the hinds of the field,","poem":1},{"lineBreak":true},{"text":"That ye stir not up, nor awake my love,","poem":1},{"lineBreak":true},{"text":"Until he please.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Who is this that cometh up from the wilderness","poem":1},{"lineBreak":true},{"text":"Like pillars of smoke,","poem":1},{"lineBreak":true},{"text":"Perfumed with myrrh and frankincense,","poem":1},{"lineBreak":true},{"text":"With all powders of the merchant?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Behold, it is the litter of Solomon;","poem":1},{"lineBreak":true},{"text":"Threescore mighty men are about it,","poem":1},{"lineBreak":true},{"text":"Of the mighty men of Israel.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"They all handle the sword, and are expert in war:","poem":1},{"lineBreak":true},{"text":"Every man hath his sword upon his thigh,","poem":1},{"lineBreak":true},{"text":"Because of fear in the night.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"King Solomon made himself a palanquin","poem":1},{"lineBreak":true},{"text":"Of the wood of Lebanon.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"He made the pillars thereof of silver,","poem":1},{"lineBreak":true},{"text":"The bottom thereof of gold, the seat of it of purple,","poem":1},{"lineBreak":true},{"text":"The midst thereof being paved with love,","poem":1},{"lineBreak":true},{"text":"From the daughters of Jerusalem.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Go forth, O ye daughters of Zion, and behold king Solomon,","poem":1},{"lineBreak":true},{"text":"With the crown wherewith his mother hath crowned him","poem":1},{"lineBreak":true},{"text":"In the day of his espousals,","poem":1},{"lineBreak":true},{"text":"And in the day of the gladness of his heart.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":16,"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Behold, thou art fair, my love; behold, thou art fair;","poem":1},{"lineBreak":true},{"text":"Thine eyes are as doves behind thy veil.","poem":1},{"lineBreak":true},{"text":"Thy hair is as a flock of goats,","poem":1},{"lineBreak":true},{"text":"That lie along the side of mount Gilead.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Thy teeth are like a flock of ewes that are newly shorn,","poem":1},{"lineBreak":true},{"text":"Which are come up from the washing,","poem":1},{"lineBreak":true},{"text":"Whereof every one hath twins,","poem":1},{"lineBreak":true},{"text":"And none is bereaved among them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Thy lips are like a thread of scarlet,","poem":1},{"lineBreak":true},{"text":"And thy mouth is comely.","poem":1},{"lineBreak":true},{"text":"Thy temples are like a piece of a pomegranate","poem":1},{"lineBreak":true},{"text":"Behind thy veil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Thy neck is like the tower of David","poem":1},{"lineBreak":true},{"text":"Builded for an armory,","poem":1},{"lineBreak":true},{"text":"Whereon there hang a thousand bucklers,","poem":1},{"lineBreak":true},{"text":"All the shields of the mighty men.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Thy two breasts are like two fawns","poem":1},{"lineBreak":true},{"text":"That are twins of a roe,","poem":1},{"lineBreak":true},{"text":"Which feed among the lilies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Until the day be cool, and the shadows flee away,","poem":1},{"lineBreak":true},{"text":"I will get me to the mountain of myrrh,","poem":1},{"lineBreak":true},{"text":"And to the hill of frankincense.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Thou art all fair, my love;","poem":1},{"lineBreak":true},{"text":"And there is no spot in thee.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Come with me from Lebanon, my bride,","poem":1},{"lineBreak":true},{"text":"With me from Lebanon:","poem":1},{"lineBreak":true},{"text":"Look from the top of Amana,","poem":1},{"lineBreak":true},{"text":"From the top of Senir and Hermon,","poem":1},{"lineBreak":true},{"text":"From the lions’ dens,","poem":1},{"lineBreak":true},{"text":"From the mountains of the leopards.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Thou hast ravished my heart, my sister, my bride;","poem":1},{"lineBreak":true},{"text":"Thou hast ravished my heart with one of thine eyes,","poem":1},{"lineBreak":true},{"text":"With one chain of thy neck.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"How fair is thy love, my sister, my bride!","poem":1},{"lineBreak":true},{"text":"How much better is thy love than wine!","poem":1},{"lineBreak":true},{"text":"And the fragrance of thine oils than all manner of spices!","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Thy lips, O my bride, drop as the honeycomb:","poem":1},{"lineBreak":true},{"text":"Honey and milk are under thy tongue;","poem":1},{"lineBreak":true},{"text":"And the smell of thy garments is like the smell of Lebanon.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"A garden shut up is my sister, my bride;","poem":1},{"lineBreak":true},{"text":"A spring shut up, a fountain sealed.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"Thy shoots are an orchard of pomegranates, with precious fruits;","poem":1},{"lineBreak":true},{"text":"Henna with spikenard plants,","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Spikenard and saffron,","poem":1},{"lineBreak":true},{"text":"Calamus and cinnamon, with all trees of frankincense;","poem":1},{"lineBreak":true},{"text":"Myrrh and aloes, with all the chief spices.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Thou art a fountain of gardens,","poem":1},{"lineBreak":true},{"text":"A well of living waters,","poem":1},{"lineBreak":true},{"text":"And flowing streams from Lebanon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Awake, O north wind; and come, thou south;","poem":1},{"lineBreak":true},{"text":"Blow upon my garden, that the spices thereof may flow out.","poem":1},{"lineBreak":true},{"text":"Let my beloved come into his garden,","poem":1},{"lineBreak":true},{"text":"And eat his precious fruits.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":16,"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"I am come into my garden, my sister, my bride:","poem":1},{"lineBreak":true},{"text":"I have gathered my myrrh with my spice;","poem":1},{"lineBreak":true},{"text":"I have eaten my honeycomb with my honey;","poem":1},{"lineBreak":true},{"text":"I have drunk my wine with my milk.","poem":1},{"lineBreak":true},{"text":"Eat, O friends;","poem":1},{"lineBreak":true},{"text":"Drink, yea, drink abundantly, O beloved.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I was asleep, but my heart waked:","poem":1},{"lineBreak":true},{"text":"It is the voice of my beloved that knocketh, saying,","poem":1},{"lineBreak":true},{"text":"Open to me, my sister, my love, my dove, my undefiled;","poem":1},{"lineBreak":true},{"text":"For my head is filled with dew,","poem":1},{"lineBreak":true},{"text":"My locks with the drops of the night.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"I have put off my garment; how shall I put it on?","poem":1},{"lineBreak":true},{"text":"I have washed my feet; how shall I defile them?","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"My beloved put in his hand by the hole of the door,","poem":1},{"lineBreak":true},{"text":"And my heart was moved for him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"I rose up to open to my beloved;","poem":1},{"lineBreak":true},{"text":"And my hands dropped with myrrh,","poem":1},{"lineBreak":true},{"text":"And my fingers with liquid myrrh,","poem":1},{"lineBreak":true},{"text":"Upon the handles of the bolt.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"I opened to my beloved;","poem":1},{"lineBreak":true},{"text":"But my beloved had withdrawn himself, and was gone.","poem":1},{"lineBreak":true},{"text":"My soul had failed me when he spake:","poem":1},{"lineBreak":true},{"text":"I sought him, but I could not find him;","poem":1},{"lineBreak":true},{"text":"I called him, but he gave me no answer.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The watchmen that go about the city found me,","poem":1},{"lineBreak":true},{"text":"They smote me, they wounded me;","poem":1},{"lineBreak":true},{"text":"The keepers of the walls took away my mantle from me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"I adjure you, O daughters of Jerusalem,","poem":1},{"lineBreak":true},{"text":"If ye find my beloved,","poem":1},{"lineBreak":true},{"text":"That ye tell him, that I am sick from love.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"What is thy beloved more than another beloved,","poem":1},{"lineBreak":true},{"text":"O thou fairest among women?","poem":1},{"lineBreak":true},{"text":"What is thy beloved more than another beloved,","poem":1},{"lineBreak":true},{"text":"That thou dost so adjure us?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"My beloved is white and ruddy,","poem":1},{"lineBreak":true},{"text":"The chiefest among ten thousand.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"His head is as the most fine gold;","poem":1},{"lineBreak":true},{"text":"His locks are bushy, and black as a raven.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"His eyes are like doves beside the water-brooks,","poem":1},{"lineBreak":true},{"text":"Washed with milk, and fitly set.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"His cheeks are as a bed of spices,","poem":1},{"lineBreak":true},{"text":"As banks of sweet herbs:","poem":1},{"lineBreak":true},{"text":"His lips are as lilies, dropping liquid myrrh.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"His hands are as rings of gold set with beryl:","poem":1},{"lineBreak":true},{"text":"His body is as ivory work overlaid with sapphires.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"His legs are as pillars of marble, set upon sockets of fine gold:","poem":1},{"lineBreak":true},{"text":"His aspect is like Lebanon, excellent as the cedars.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"His mouth is most sweet;","poem":1},{"lineBreak":true},{"text":"Yea, he is altogether lovely.","poem":1},{"lineBreak":true},{"text":"This is my beloved, and this is my friend,","poem":1},{"lineBreak":true},{"text":"O daughters of Jerusalem.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":13,"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Whither is thy beloved gone,","poem":1},{"lineBreak":true},{"text":"O thou fairest among women?","poem":1},{"lineBreak":true},{"text":"Whither hath thy beloved turned him,","poem":1},{"lineBreak":true},{"text":"That we may seek him with thee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"My beloved is gone down to his garden,","poem":1},{"lineBreak":true},{"text":"To the beds of spices,","poem":1},{"lineBreak":true},{"text":"To feed in the gardens, and to gather lilies.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"I am my beloved’s, and my beloved is mine:","poem":1},{"lineBreak":true},{"text":"He feedeth his flock among the lilies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Thou art fair, O my love, as Tirzah,","poem":1},{"lineBreak":true},{"text":"Comely as Jerusalem,","poem":1},{"lineBreak":true},{"text":"Terrible as an army with banners.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Turn away thine eyes from me,","poem":1},{"lineBreak":true},{"text":"For they have overcome me.","poem":1},{"lineBreak":true},{"text":"Thy hair is as a flock of goats,","poem":1},{"lineBreak":true},{"text":"That lie along the side of Gilead.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"Thy teeth are like a flock of ewes,","poem":1},{"lineBreak":true},{"text":"Which are come up from the washing;","poem":1},{"lineBreak":true},{"text":"Whereof every one hath twins,","poem":1},{"lineBreak":true},{"text":"And none is bereaved among them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Thy temples are like a piece of a pomegranate","poem":1},{"lineBreak":true},{"text":"Behind thy veil.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"There are threescore queens, and fourscore concubines,","poem":1},{"lineBreak":true},{"text":"And virgins without number.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"My dove, my undefiled, is but one;","poem":1},{"lineBreak":true},{"text":"She is the only one of her mother;","poem":1},{"lineBreak":true},{"text":"She is the choice one of her that bare her.","poem":1},{"lineBreak":true},{"text":"The daughters saw her, and called her blessed;","poem":1},{"lineBreak":true},{"text":"Yea, the queens and the concubines, and they praised her.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Who is she that looketh forth as the morning,","poem":1},{"lineBreak":true},{"text":"Fair as the moon,","poem":1},{"lineBreak":true},{"text":"Clear as the sun,","poem":1},{"lineBreak":true},{"text":"Terrible as an army with banners?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I went down into the garden of nuts,","poem":1},{"lineBreak":true},{"text":"To see the green plants of the valley,","poem":1},{"lineBreak":true},{"text":"To see whether the vine budded,","poem":1},{"lineBreak":true},{"text":"And the pomegranates were in flower.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Before I was aware, my soul set me","poem":1},{"lineBreak":true},{"text":"Among the chariots of my princely people.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Return, return, O Shulammite;","poem":1},{"lineBreak":true},{"text":"Return, return, that we may look upon thee.","poem":1},{"lineBreak":true},{"text":"Why will ye look upon the Shulammite,","poem":1},{"lineBreak":true},{"text":"As upon the dance of Mahanaim?","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":13,"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"How beautiful are thy feet in sandals, O prince’s daughter!","poem":1},{"lineBreak":true},{"text":"Thy rounded thighs are like jewels,","poem":1},{"lineBreak":true},{"text":"The work of the hands of a skilful workman.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Thy body is like a round goblet,","poem":1},{"lineBreak":true},{"text":"Wherein no mingled wine is wanting:","poem":1},{"lineBreak":true},{"text":"Thy waist is like a heap of wheat","poem":1},{"lineBreak":true},{"text":"Set about with lilies.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Thy two breasts are like two fawns","poem":1},{"lineBreak":true},{"text":"That are twins of a roe.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"Thy neck is like the tower of ivory;","poem":1},{"lineBreak":true},{"text":"Thine eyes as the pools in Heshbon,","poem":1},{"lineBreak":true},{"text":"By the gate of Bath-rabbim;","poem":1},{"lineBreak":true},{"text":"Thy nose is like the tower of Lebanon","poem":1},{"lineBreak":true},{"text":"Which looketh toward Damascus.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Thy head upon thee is like Carmel,","poem":1},{"lineBreak":true},{"text":"And the hair of thy head like purple;","poem":1},{"lineBreak":true},{"text":"The king is held captive in the tresses thereof.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"How fair and how pleasant art thou,","poem":1},{"lineBreak":true},{"text":"O love, for delights!","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"This thy stature is like to a palm-tree,","poem":1},{"lineBreak":true},{"text":"And thy breasts to its clusters.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"I said, I will climb up into the palm-tree,","poem":1},{"lineBreak":true},{"text":"I will take hold of the branches thereof:","poem":1},{"lineBreak":true},{"text":"Let thy breasts be as clusters of the vine,","poem":1},{"lineBreak":true},{"text":"And the smell of thy breath like apples,","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"And thy mouth like the best wine,","poem":1},{"lineBreak":true},{"text":"That goeth down smoothly for my beloved,","poem":1},{"lineBreak":true},{"text":"Gliding through the lips of those that are asleep.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I am my beloved’s;","poem":1},{"lineBreak":true},{"text":"And his desire is toward me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Come, my beloved, let us go forth into the field;","poem":1},{"lineBreak":true},{"text":"Let us lodge in the villages.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Let us get up early to the vineyards;","poem":1},{"lineBreak":true},{"text":"Let us see whether the vine hath budded,","poem":1},{"lineBreak":true},{"text":"And its blossom is open,","poem":1},{"lineBreak":true},{"text":"And the pomegranates are in flower:","poem":1},{"lineBreak":true},{"text":"There will I give thee my love.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"The mandrakes give forth fragrance;","poem":1},{"lineBreak":true},{"text":"And at our doors are all manner of precious fruits, new and old,","poem":1},{"lineBreak":true},{"text":"Which I have laid up for thee, O my beloved.","poem":1}]}],"footnotes":[]}},{"numberOfVerses":14,"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Oh that thou wert as my brother,","poem":1},{"lineBreak":true},{"text":"That sucked the breasts of my mother!","poem":1},{"lineBreak":true},{"text":"When I should find thee without, I would kiss thee;","poem":1},{"lineBreak":true},{"text":"Yea, and none would despise me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"I would lead thee, and bring thee into my mother’s house,","poem":1},{"lineBreak":true},{"text":"Who would instruct me;","poem":1},{"lineBreak":true},{"text":"I would cause thee to drink of spiced wine,","poem":1},{"lineBreak":true},{"text":"Of the juice of my pomegranate.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"His left hand should be under my head,","poem":1},{"lineBreak":true},{"text":"And his right hand should embrace me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I adjure you, O daughters of Jerusalem,","poem":1},{"lineBreak":true},{"text":"That ye stir not up, nor awake my love,","poem":1},{"lineBreak":true},{"text":"Until he please.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Who is this that cometh up from the wilderness,","poem":1},{"lineBreak":true},{"text":"Leaning upon her beloved?","poem":1},{"lineBreak":true},{"text":"Under the apple-tree I awakened thee:","poem":1},{"lineBreak":true},{"text":"There thy mother was in travail with thee,","poem":1},{"lineBreak":true},{"text":"There was she in travail that brought thee forth.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Set me as a seal upon thy heart,","poem":1},{"lineBreak":true},{"text":"As a seal upon thine arm:","poem":1},{"lineBreak":true},{"text":"For love is strong as death;","poem":1},{"lineBreak":true},{"text":"Jealousy is cruel as Sheol;","poem":1},{"lineBreak":true},{"text":"The flashes thereof are flashes of fire,","poem":1},{"lineBreak":true},{"text":"A very flame of Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Many waters cannot quench love,","poem":1},{"lineBreak":true},{"text":"Neither can floods drown it:","poem":1},{"lineBreak":true},{"text":"If a man would give all the substance of his house for love,","poem":1},{"lineBreak":true},{"text":"He would utterly be contemned.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"We have a little sister,","poem":1},{"lineBreak":true},{"text":"And she hath no breasts:","poem":1},{"lineBreak":true},{"text":"What shall we do for our sister","poem":1},{"lineBreak":true},{"text":"In the day when she shall be spoken for?","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"If she be a wall,","poem":1},{"lineBreak":true},{"text":"We will build upon her a turret of silver:","poem":1},{"lineBreak":true},{"text":"And if she be a door,","poem":1},{"lineBreak":true},{"text":"We will inclose her with boards of cedar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I am a wall, and my breasts like the towers thereof:","poem":1},{"lineBreak":true},{"text":"Then was I in his eyes as one that found peace.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"Solomon had a vineyard at Baal-hamon;","poem":1},{"lineBreak":true},{"text":"He let out the vineyard unto keepers;","poem":1},{"lineBreak":true},{"text":"Every one for the fruit thereof was to bring a thousand pieces of silver.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"My vineyard, which is mine, is before me:","poem":1},{"lineBreak":true},{"text":"Thou, O Solomon, shalt have the thousand,","poem":1},{"lineBreak":true},{"text":"And those that keep the fruit thereof two hundred.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Thou that dwellest in the gardens,","poem":1},{"lineBreak":true},{"text":"The companions hearken for thy voice:","poem":1},{"lineBreak":true},{"text":"Cause me to hear it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Make haste, my beloved,","poem":1},{"lineBreak":true},{"text":"And be thou like to a roe or to a young hart","poem":1},{"lineBreak":true},{"text":"Upon the mountains of spices.","poem":1}]}],"footnotes":[]}}]}
