{"translation":{"id":"eng_asv","name":"American Standard Version (1901)","website":"https://ebible.org/Scriptures/details.php?id=eng-asv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-asv","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"ASV","englishName":"American Standard Version (1901)","language":"eng","textDirection":"ltr","sha256":"154967f9f68504bdf9a8d7abaae4ef6a93f20f779df84e62c1c8828427731839","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_asv/books.json","completeTranslationApiLink":"/api/eng_asv/complete.json","simpleCompleteTranslationApiLink":"/api/eng_asv/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"English","languageEnglishName":"English"},"book":{"id":"LAM","name":"Lamentations","commonName":"Lamentations","title":"THE LAMENTATIONS OF JEREMIAH","numberOfChapters":5,"totalNumberOfVerses":154},"chapters":[null,{"numberOfVerses":22,"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"How doth the city sit solitary, that was full of people!","poem":1},{"lineBreak":true},{"text":"She is become as a widow, that was great among the nations!","poem":1},{"lineBreak":true},{"text":"She that was a princess among the provinces is become tributary!","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"She weepeth sore in the night, and her tears are on her cheeks;","poem":1},{"lineBreak":true},{"text":"Among all her lovers she hath none to comfort her:","poem":1},{"lineBreak":true},{"text":"All her friends have dealt treacherously with her; they are become her enemies.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Judah is gone into captivity because of affliction, and because of great servitude;","poem":1},{"lineBreak":true},{"text":"She dwelleth among the nations, she findeth no rest:","poem":1},{"lineBreak":true},{"text":"All her persecutors overtook her within the straits.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"The ways of Zion do mourn, because none come to the solemn assembly;","poem":1},{"lineBreak":true},{"text":"All her gates are desolate, her priests do sigh:","poem":1},{"lineBreak":true},{"text":"Her virgins are afflicted, and she herself is in bitterness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Her adversaries are become the head, her enemies prosper;","poem":1},{"lineBreak":true},{"text":"For Jehovah hath afflicted her for the multitude of her transgressions:","poem":1},{"lineBreak":true},{"text":"Her young children are gone into captivity before the adversary.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"And from the daughter of Zion all her majesty is departed:","poem":1},{"lineBreak":true},{"text":"Her princes are become like harts that find no pasture,","poem":1},{"lineBreak":true},{"text":"And they are gone without strength before the pursuer.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Jerusalem remembereth in the days of her affliction and of her miseries all her pleasant things that were from the days of old:","poem":1},{"lineBreak":true},{"text":"When her people fell into the hand of the adversary, and none did help her,","poem":1},{"lineBreak":true},{"text":"The adversaries saw her, they did mock at her desolations.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Jerusalem hath grievously sinned; therefore she is become as an unclean thing;","poem":1},{"lineBreak":true},{"text":"All that honored her despise her, because they have seen her nakedness:","poem":1},{"lineBreak":true},{"text":"Yea, she sigheth, and turneth backward.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Her filthiness was in her skirts; she remembered not her latter end;","poem":1},{"lineBreak":true},{"text":"Therefore is she come down wonderfully; she hath no comforter:","poem":1},{"lineBreak":true},{"text":"Behold, O Jehovah, my affliction; for the enemy hath magnified himself.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The adversary hath spread out his hand upon all her pleasant things:","poem":1},{"lineBreak":true},{"text":"For she hath seen that the nations are entered into her sanctuary,","poem":1},{"lineBreak":true},{"text":"Concerning whom thou didst command that they should not enter into thine assembly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"All her people sigh, they seek bread;","poem":1},{"lineBreak":true},{"text":"They have given their pleasant things for food to refresh the soul:","poem":1},{"lineBreak":true},{"text":"See, O Jehovah, and behold; for I am become abject.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Is it nothing to you, all ye that pass by?","poem":1},{"lineBreak":true},{"text":"Behold, and see if there be any sorrow like unto my sorrow, which is brought upon me,","poem":1},{"lineBreak":true},{"text":"Wherewith Jehovah hath afflicted me in the day of his fierce anger.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"From on high hath he sent fire into my bones, and it prevaileth against them;","poem":1},{"lineBreak":true},{"text":"He hath spread a net for my feet, he hath turned me back:","poem":1},{"lineBreak":true},{"text":"He hath made me desolate and faint all the day.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The yoke of my transgressions is bound by his hand;","poem":1},{"lineBreak":true},{"text":"They are knit together, they are come up upon my neck; he hath made my strength to fail:","poem":1},{"lineBreak":true},{"text":"The Lord hath delivered me into their hands, against whom I am not able to stand.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The Lord hath set at nought all my mighty men in the midst of me;","poem":1},{"lineBreak":true},{"text":"He hath called a solemn assembly against me to crush my young men:","poem":1},{"lineBreak":true},{"text":"The Lord hath trodden as in a winepress the virgin daughter of Judah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"For these things I weep; mine eye, mine eye runneth down with water;","poem":1},{"lineBreak":true},{"text":"Because the comforter that should refresh my soul is far from me:","poem":1},{"lineBreak":true},{"text":"My children are desolate, because the enemy hath prevailed.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Zion spreadeth forth her hands; there is none to comfort her;","poem":1},{"lineBreak":true},{"text":"Jehovah hath commanded concerning Jacob, that they that are round about him should be his adversaries:","poem":1},{"lineBreak":true},{"text":"Jerusalem is among them as an unclean thing.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Jehovah is righteous; for I have rebelled against his commandment:","poem":1},{"lineBreak":true},{"text":"Hear, I pray you, all ye peoples, and behold my sorrow:","poem":1},{"lineBreak":true},{"text":"My virgins and my young men are gone into captivity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"I called for my lovers, but they deceived me:","poem":1},{"lineBreak":true},{"text":"My priests and mine elders gave up the ghost in the city,","poem":1},{"lineBreak":true},{"text":"While they sought them food to refresh their souls.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Behold, O Jehovah; for I am in distress; my heart is troubled;","poem":1},{"lineBreak":true},{"text":"My heart is turned within me; for I have grievously rebelled:","poem":1},{"lineBreak":true},{"text":"Abroad the sword bereaveth, at home there is as death.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"They have heard that I sigh; there is none to comfort me;","poem":1},{"lineBreak":true},{"text":"All mine enemies have heard of my trouble; they are glad that thou hast done it:","poem":1},{"lineBreak":true},{"text":"Thou wilt bring the day that thou hast proclaimed, and they shall be like unto me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Let all their wickedness come before thee;","poem":1},{"lineBreak":true},{"text":"And do unto them, as thou hast done unto me for all my transgressions:","poem":1},{"lineBreak":true},{"text":"For my sighs are many, and my heart is faint.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":22,"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"How hath the Lord covered the daughter of Zion with a cloud in his anger!","poem":1},{"lineBreak":true},{"text":"He hath cast down from heaven unto the earth the beauty of Israel,","poem":1},{"lineBreak":true},{"text":"And hath not remembered his footstool in the day of his anger.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"The Lord hath swallowed up all the habitations of Jacob, and hath not pitied:","poem":1},{"lineBreak":true},{"text":"He hath thrown down in his wrath the strongholds of the daughter of Judah;","poem":1},{"lineBreak":true},{"text":"He hath brought them down to the ground; he hath profaned the kingdom and the princes thereof.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"He hath cut off in fierce anger all the horn of Israel;","poem":1},{"lineBreak":true},{"text":"He hath drawn back his right hand from before the enemy:","poem":1},{"lineBreak":true},{"text":"And he hath burned up Jacob like a flaming fire, which devoureth round about.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"He hath bent his bow like an enemy, he hath stood with his right hand as an adversary,","poem":1},{"lineBreak":true},{"text":"And hath slain all that were pleasant to the eye:","poem":1},{"lineBreak":true},{"text":"In the tent of the daughter of Zion he hath poured out his wrath like fire.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"The Lord is become as an enemy, he hath swallowed up Israel;","poem":1},{"lineBreak":true},{"text":"He hath swallowed up all her palaces, he hath destroyed his strongholds;","poem":1},{"lineBreak":true},{"text":"And he hath multiplied in the daughter of Judah mourning and lamentation.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"And he hath violently taken away his tabernacle, as if it were of a garden; he hath destroyed his place of assembly:","poem":1},{"lineBreak":true},{"text":"Jehovah hath caused solemn assembly and sabbath to be forgotten in Zion,","poem":1},{"lineBreak":true},{"text":"And hath despised in the indignation of his anger the king and the priest.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"The Lord hath cast off his altar, he hath abhorred his sanctuary;","poem":1},{"lineBreak":true},{"text":"He hath given up into the hand of the enemy the walls of her palaces:","poem":1},{"lineBreak":true},{"text":"They have made a noise in the house of Jehovah, as in the day of a solemn assembly.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Jehovah hath purposed to destroy the wall of the daughter of Zion;","poem":1},{"lineBreak":true},{"text":"He hath stretched out the line, he hath not withdrawn his hand from destroying;","poem":1},{"lineBreak":true},{"text":"And he hath made the rampart and wall to lament; they languish together.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"Her gates are sunk into the ground; he hath destroyed and broken her bars:","poem":1},{"lineBreak":true},{"text":"Her king and her princes are among the nations where the law is not;","poem":1},{"lineBreak":true},{"text":"Yea, her prophets find no vision from Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The elders of the daughter of Zion sit upon the ground, they keep silence;","poem":1},{"lineBreak":true},{"text":"They have cast up dust upon their heads; they have girded themselves with sackcloth:","poem":1},{"lineBreak":true},{"text":"The virgins of Jerusalem hang down their heads to the ground.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mine eyes do fail with tears, my heart is troubled;","poem":1},{"lineBreak":true},{"text":"My liver is poured upon the earth, because of the destruction of the daughter of my people,","poem":1},{"lineBreak":true},{"text":"Because the young children and the sucklings swoon in the streets of the city.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"They say to their mothers, Where is grain and wine?","poem":1},{"lineBreak":true},{"text":"When they swoon as the wounded in the streets of the city,","poem":1},{"lineBreak":true},{"text":"When their soul is poured out into their mothers’ bosom.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"What shall I testify unto thee? what shall I liken to thee, O daughter of Jerusalem?","poem":1},{"lineBreak":true},{"text":"What shall I compare to thee, that I may comfort thee, O virgin daughter of Zion?","poem":1},{"lineBreak":true},{"text":"For thy breach is great like the sea: who can heal thee?","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"Thy prophets have seen for thee false and foolish visions;","poem":1},{"lineBreak":true},{"text":"And they have not uncovered thine iniquity, to bring back thy captivity,","poem":1},{"lineBreak":true},{"text":"But have seen for thee false oracles and causes of banishment.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"All that pass by clap their hands at thee;","poem":1},{"lineBreak":true},{"text":"They hiss and wag their head at the daughter of Jerusalem, saying,","poem":1},{"lineBreak":true},{"text":"Is this the city that men called The perfection of beauty, The joy of the whole earth?","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"All thine enemies have opened their mouth wide against thee;","poem":1},{"lineBreak":true},{"text":"They hiss and gnash the teeth; they say, We have swallowed her up;","poem":1},{"lineBreak":true},{"text":"Certainly this is the day that we looked for; we have found, we have seen it.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"Jehovah hath done that which he purposed; he hath fulfilled his word that he commanded in the days of old;","poem":1},{"lineBreak":true},{"text":"He hath thrown down, and hath not pitied:","poem":1},{"lineBreak":true},{"text":"And he hath caused the enemy to rejoice over thee; he hath exalted the horn of thine adversaries.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"Their heart cried unto the Lord:","poem":1},{"lineBreak":true},{"text":"O wall of the daughter of Zion, let tears run down like a river day and night;","poem":1},{"lineBreak":true},{"text":"Give thyself no respite; let not the apple of thine eye cease.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"Arise, cry out in the night, at the beginning of the watches;","poem":1},{"lineBreak":true},{"text":"Pour out thy heart like water before the face of the Lord:","poem":1},{"lineBreak":true},{"text":"Lift up thy hands toward him for the life of thy young children, that faint for hunger at the head of every street.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"See, O Jehovah, and behold to whom thou hast done thus!","poem":1},{"lineBreak":true},{"text":"Shall the women eat their fruit, the children that are dandled in the hands?","poem":1},{"lineBreak":true},{"text":"Shall the priest and the prophet be slain in the sanctuary of the Lord?","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"The youth and the old man lie on the ground in the streets;","poem":1},{"lineBreak":true},{"text":"My virgins and my young men are fallen by the sword:","poem":1},{"lineBreak":true},{"text":"Thou hast slain them in the day of thine anger; thou hast slaughtered, and not pitied.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"Thou hast called, as in the day of a solemn assembly, my terrors on every side;","poem":1},{"lineBreak":true},{"text":"And there was none that escaped or remained in the day of Jehovah’s anger:","poem":1},{"lineBreak":true},{"text":"Those that I have dandled and brought up hath mine enemy consumed.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":66,"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"I am the man that hath seen affliction by the rod of his wrath.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"He hath led me and caused me to walk in darkness, and not in light.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Surely against me he turneth his hand again and again all the day.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"My flesh and my skin hath he made old; he hath broken my bones.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"He hath builded against me, and compassed me with gall and travail.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"He hath made me to dwell in dark places, as those that have been long dead.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"He hath walled me about, that I cannot go forth; he hath made my chain heavy.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Yea, when I cry, and call for help, he shutteth out my prayer.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"He hath walled up my ways with hewn stone; he hath made my paths crooked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"He is unto me as a bear lying in wait, as a lion in secret places.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"He hath turned aside my ways, and pulled me in pieces; he hath made me desolate.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"He hath bent his bow, and set me as a mark for the arrow.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"He hath caused the shafts of his quiver to enter into my reins.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"I am become a derision to all my people, and their song all the day.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"He hath filled me with bitterness, he hath sated me with wormwood.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"He hath also broken my teeth with gravel stones; he hath covered me with ashes.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"And thou hast removed my soul far off from peace; I forgat prosperity.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"And I said, My strength is perished, and mine expectation from Jehovah.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Remember mine affliction and my misery, the wormwood and the gall.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"My soul hath them still in remembrance, and is bowed down within me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"This I recall to my mind; therefore have I hope.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"It is of Jehovah’s lovingkindnesses that we are not consumed, because his compassions fail not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":23,"content":[{"text":"They are new every morning; great is thy faithfulness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":24,"content":[{"text":"Jehovah is my portion, saith my soul; therefore will I hope in him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":25,"content":[{"text":"Jehovah is good unto them that wait for him, to the soul that seeketh him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":26,"content":[{"text":"It is good that a man should hope and quietly wait for the salvation of Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":27,"content":[{"text":"It is good for a man that he bear the yoke in his youth.","poem":1},{"lineBreak":true}]},{"type":"verse","number":28,"content":[{"text":"Let him sit alone and keep silence, because he hath laid it upon him.","poem":1},{"lineBreak":true}]},{"type":"verse","number":29,"content":[{"text":"Let him put his mouth in the dust, if so be there may be hope.","poem":1},{"lineBreak":true}]},{"type":"verse","number":30,"content":[{"text":"Let him give his cheek to him that smiteth him; let him be filled full with reproach.","poem":1},{"lineBreak":true}]},{"type":"verse","number":31,"content":[{"text":"For the Lord will not cast off for ever.","poem":1},{"lineBreak":true}]},{"type":"verse","number":32,"content":[{"text":"For though he cause grief, yet will he have compassion according to the multitude of his lovingkindnesses.","poem":1},{"lineBreak":true}]},{"type":"verse","number":33,"content":[{"text":"For he doth not afflict willingly, nor grieve the children of men.","poem":1},{"lineBreak":true}]},{"type":"verse","number":34,"content":[{"text":"To crush under foot all the prisoners of the earth,","poem":1},{"lineBreak":true}]},{"type":"verse","number":35,"content":[{"text":"To turn aside the right of a man before the face of the Most High,","poem":1},{"lineBreak":true}]},{"type":"verse","number":36,"content":[{"text":"To subvert a man in his cause, the Lord approveth not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":37,"content":[{"text":"Who is he that saith, and it cometh to pass, when the Lord commandeth it not?","poem":1},{"lineBreak":true}]},{"type":"verse","number":38,"content":[{"text":"Out of the mouth of the Most High cometh there not evil and good?","poem":1},{"lineBreak":true}]},{"type":"verse","number":39,"content":[{"text":"Wherefore doth a living man complain, a man for the punishment of his sins?","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Let us search and try our ways, and turn again to Jehovah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":41,"content":[{"text":"Let us lift up our heart with our hands unto God in the heavens.","poem":1},{"lineBreak":true}]},{"type":"verse","number":42,"content":[{"text":"We have transgressed and have rebelled; thou hast not pardoned.","poem":1},{"lineBreak":true}]},{"type":"verse","number":43,"content":[{"text":"Thou hast covered with anger and pursued us; thou hast slain, thou hast not pitied.","poem":1},{"lineBreak":true}]},{"type":"verse","number":44,"content":[{"text":"Thou hast covered thyself with a cloud, so that no prayer can pass through.","poem":1},{"lineBreak":true}]},{"type":"verse","number":45,"content":[{"text":"Thou hast made us an offscouring and refuse in the midst of the peoples.","poem":1},{"lineBreak":true}]},{"type":"verse","number":46,"content":[{"text":"All our enemies have opened their mouth wide against us.","poem":1},{"lineBreak":true}]},{"type":"verse","number":47,"content":[{"text":"Fear and the pit are come upon us, devastation and destruction.","poem":1},{"lineBreak":true}]},{"type":"verse","number":48,"content":[{"text":"Mine eye runneth down with streams of water, for the destruction of the daughter of my people.","poem":1},{"lineBreak":true}]},{"type":"verse","number":49,"content":[{"text":"Mine eye poureth down, and ceaseth not, without any intermission,","poem":1},{"lineBreak":true}]},{"type":"verse","number":50,"content":[{"text":"Till Jehovah look down, and behold from heaven.","poem":1},{"lineBreak":true}]},{"type":"verse","number":51,"content":[{"text":"Mine eye affecteth my soul, because of all the daughters of my city.","poem":1},{"lineBreak":true}]},{"type":"verse","number":52,"content":[{"text":"They have chased me sore like a bird, they that are mine enemies without cause.","poem":1},{"lineBreak":true}]},{"type":"verse","number":53,"content":[{"text":"They have cut off my life in the dungeon, and have cast a stone upon me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":54,"content":[{"text":"Waters flowed over my head; I said, I am cut off.","poem":1}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"I called upon thy name, O Jehovah, out of the lowest dungeon.","poem":1},{"lineBreak":true}]},{"type":"verse","number":56,"content":[{"text":"Thou heardest my voice; hide not thine ear at my breathing, at my cry.","poem":1},{"lineBreak":true}]},{"type":"verse","number":57,"content":[{"text":"Thou drewest near in the day that I called upon thee; thou saidst, Fear not.","poem":1},{"lineBreak":true}]},{"type":"verse","number":58,"content":[{"text":"O Lord, thou hast pleaded the causes of my soul; thou hast redeemed my life.","poem":1},{"lineBreak":true}]},{"type":"verse","number":59,"content":[{"text":"O Jehovah, thou hast seen my wrong; judge thou my cause.","poem":1},{"lineBreak":true}]},{"type":"verse","number":60,"content":[{"text":"Thou hast seen all their vengeance and all their devices against me.","poem":1},{"lineBreak":true}]},{"type":"verse","number":61,"content":[{"text":"Thou hast heard their reproach, O Jehovah, and all their devices against me,","poem":1},{"lineBreak":true}]},{"type":"verse","number":62,"content":[{"text":"The lips of those that rose up against me, and their device against me all the day.","poem":1},{"lineBreak":true}]},{"type":"verse","number":63,"content":[{"text":"Behold thou their sitting down, and their rising up; I am their song.","poem":1},{"lineBreak":true}]},{"type":"verse","number":64,"content":[{"text":"Thou wilt render unto them a recompense, O Jehovah, according to the work of their hands.","poem":1},{"lineBreak":true}]},{"type":"verse","number":65,"content":[{"text":"Thou wilt give them hardness of heart, thy curse unto them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":66,"content":[{"text":"Thou wilt pursue them in anger, and destroy them from under the heavens of Jehovah.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":22,"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"How is the gold become dim! how is the most pure gold changed!","poem":1},{"lineBreak":true},{"text":"The stones of the sanctuary are poured out at the head of every street.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"The precious sons of Zion, comparable to fine gold,","poem":1},{"lineBreak":true},{"text":"How are they esteemed as earthen pitchers, the work of the hands of the potter!","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"Even the jackals draw out the breast, they give suck to their young ones:","poem":1},{"lineBreak":true},{"text":"The daughter of my people is become cruel, like the ostriches in the wilderness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"The tongue of the sucking child cleaveth to the roof of his mouth for thirst:","poem":1},{"lineBreak":true},{"text":"The young children ask bread, and no man breaketh it unto them.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"They that did feed delicately are desolate in the streets:","poem":1},{"lineBreak":true},{"text":"They that were brought up in scarlet embrace dunghills.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"For the iniquity of the daughter of my people is greater than the sin of Sodom,","poem":1},{"lineBreak":true},{"text":"That was overthrown as in a moment, and no hands were laid upon her.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Her nobles were purer than snow, they were whiter than milk;","poem":1},{"lineBreak":true},{"text":"They were more ruddy in body than rubies, their polishing was as of sapphire.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Their visage is blacker than a coal; they are not known in the streets:","poem":1},{"lineBreak":true},{"text":"Their skin cleaveth to their bones; it is withered, it is become like a stick.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"They that are slain with the sword are better than they that are slain with hunger;","poem":1},{"lineBreak":true},{"text":"For these pine away, stricken through, for want of the fruits of the field.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"The hands of the pitiful women have boiled their own children;","poem":1},{"lineBreak":true},{"text":"They were their food in the destruction of the daughter of my people.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehovah hath accomplished his wrath, he hath poured out his fierce anger;","poem":1},{"lineBreak":true},{"text":"And he hath kindled a fire in Zion, which hath devoured the foundations thereof.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"The kings of the earth believed not, neither all the inhabitants of the world,","poem":1},{"lineBreak":true},{"text":"That the adversary and the enemy would enter into the gates of Jerusalem.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"It is because of the sins of her prophets, and the iniquities of her priests,","poem":1},{"lineBreak":true},{"text":"That have shed the blood of the just in the midst of her.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"They wander as blind men in the streets, they are polluted with blood,","poem":1},{"lineBreak":true},{"text":"So that men cannot touch their garments.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"Depart ye, they cried unto them, Unclean! depart, depart, touch not!","poem":1},{"lineBreak":true},{"text":"When they fled away and wandered, men said among the nations, They shall no more sojourn here.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"The anger of Jehovah hath scattered them; he will no more regard them:","poem":1},{"lineBreak":true},{"text":"They respected not the persons of the priests, they favored not the elders.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Our eyes do yet fail in looking for our vain help:","poem":1},{"lineBreak":true},{"text":"In our watching we have watched for a nation that could not save.","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"They hunt our steps, so that we cannot go in our streets:","poem":1},{"lineBreak":true},{"text":"Our end is near, our days are fulfilled; for our end is come.","poem":1},{"lineBreak":true}]},{"type":"verse","number":19,"content":[{"text":"Our pursuers were swifter than the eagles of the heavens:","poem":1},{"lineBreak":true},{"text":"They chased us upon the mountains, they laid wait for us in the wilderness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"The breath of our nostrils, the anointed of Jehovah, was taken in their pits;","poem":1},{"lineBreak":true},{"text":"Of whom we said, Under his shadow we shall live among the nations.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Rejoice and be glad, O daughter of Edom, that dwellest in the land of Uz:","poem":1},{"lineBreak":true},{"text":"The cup shall pass through unto thee also; thou shalt be drunken, and shalt make thyself naked.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"The punishment of thine iniquity is accomplished, O daughter of Zion; he will no more carry thee away into captivity:","poem":1},{"lineBreak":true},{"text":"He will visit thine iniquity, O daughter of Edom; he will uncover thy sins.","poem":1}]},{"type":"line_break"}],"footnotes":[]}},{"numberOfVerses":22,"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Remember, O Jehovah, what is come upon us:","poem":1},{"lineBreak":true},{"text":"Behold, and see our reproach.","poem":1},{"lineBreak":true}]},{"type":"verse","number":2,"content":[{"text":"Our inheritance is turned unto strangers,","poem":1},{"lineBreak":true},{"text":"Our houses unto aliens.","poem":1},{"lineBreak":true}]},{"type":"verse","number":3,"content":[{"text":"We are orphans and fatherless;","poem":1},{"lineBreak":true},{"text":"Our mothers are as widows.","poem":1},{"lineBreak":true}]},{"type":"verse","number":4,"content":[{"text":"We have drunken our water for money;","poem":1},{"lineBreak":true},{"text":"Our wood is sold unto us.","poem":1},{"lineBreak":true}]},{"type":"verse","number":5,"content":[{"text":"Our pursuers are upon our necks:","poem":1},{"lineBreak":true},{"text":"We are weary, and have no rest.","poem":1},{"lineBreak":true}]},{"type":"verse","number":6,"content":[{"text":"We have given the hand to the Egyptians,","poem":1},{"lineBreak":true},{"text":"And to the Assyrians, to be satisfied with bread.","poem":1},{"lineBreak":true}]},{"type":"verse","number":7,"content":[{"text":"Our fathers sinned, and are not;","poem":1},{"lineBreak":true},{"text":"And we have borne their iniquities.","poem":1},{"lineBreak":true}]},{"type":"verse","number":8,"content":[{"text":"Servants rule over us:","poem":1},{"lineBreak":true},{"text":"There is none to deliver us out of their hand.","poem":1},{"lineBreak":true}]},{"type":"verse","number":9,"content":[{"text":"We get our bread at the peril of our lives,","poem":1},{"lineBreak":true},{"text":"Because of the sword of the wilderness.","poem":1},{"lineBreak":true}]},{"type":"verse","number":10,"content":[{"text":"Our skin is black like an oven,","poem":1},{"lineBreak":true},{"text":"Because of the burning heat of famine.","poem":1},{"lineBreak":true}]},{"type":"verse","number":11,"content":[{"text":"They ravished the women in Zion,","poem":1},{"lineBreak":true},{"text":"The virgins in the cities of Judah.","poem":1},{"lineBreak":true}]},{"type":"verse","number":12,"content":[{"text":"Princes were hanged up by their hand:","poem":1},{"lineBreak":true},{"text":"The faces of elders were not honored.","poem":1},{"lineBreak":true}]},{"type":"verse","number":13,"content":[{"text":"The young men bare the mill;","poem":1},{"lineBreak":true},{"text":"And the children stumbled under the wood.","poem":1},{"lineBreak":true}]},{"type":"verse","number":14,"content":[{"text":"The elders have ceased from the gate,","poem":1},{"lineBreak":true},{"text":"The young men from their music.","poem":1},{"lineBreak":true}]},{"type":"verse","number":15,"content":[{"text":"The joy of our heart is ceased;","poem":1},{"lineBreak":true},{"text":"Our dance is turned into mourning.","poem":1},{"lineBreak":true}]},{"type":"verse","number":16,"content":[{"text":"The crown is fallen from our head:","poem":1},{"lineBreak":true},{"text":"Woe unto us! for we have sinned.","poem":1},{"lineBreak":true}]},{"type":"verse","number":17,"content":[{"text":"For this our heart is faint;","poem":1},{"lineBreak":true},{"text":"For these things our eyes are dim;","poem":1},{"lineBreak":true}]},{"type":"verse","number":18,"content":[{"text":"For the mountain of Zion, which is desolate:","poem":1},{"lineBreak":true},{"text":"The foxes walk upon it.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Thou, O Jehovah, abidest for ever;","poem":1},{"lineBreak":true},{"text":"Thy throne is from generation to generation.","poem":1},{"lineBreak":true}]},{"type":"verse","number":20,"content":[{"text":"Wherefore dost thou forget us for ever,","poem":1},{"lineBreak":true},{"text":"And forsake us so long time?","poem":1},{"lineBreak":true}]},{"type":"verse","number":21,"content":[{"text":"Turn thou us unto thee, O Jehovah, and we shall be turned;","poem":1},{"lineBreak":true},{"text":"Renew our days as of old.","poem":1},{"lineBreak":true}]},{"type":"verse","number":22,"content":[{"text":"But thou hast utterly rejected us;","poem":1},{"lineBreak":true},{"text":"Thou art very wroth against us.","poem":1}]}],"footnotes":[]}}]}
