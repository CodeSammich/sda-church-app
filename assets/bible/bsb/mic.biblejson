{"translation":{"id":"BSB","name":"Berean Standard Bible","website":"https://berean.bible/","licenseUrl":"https://berean.bible/","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"BSB","englishName":"Berean Standard Bible","language":"eng","textDirection":"ltr","sha256":"6cc5238e442b4204b0f617cc5c932bc04f3bae4a0658e6393b0e319653ebe37f","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","completeTranslationApiLink":"/api/BSB/complete.json","simpleCompleteTranslationApiLink":"/api/BSB/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31086,"languageName":"English","languageEnglishName":"English"},"book":{"id":"MIC","name":"Micah","commonName":"Micah","title":"Micah","numberOfChapters":7,"totalNumberOfVerses":105},"chapters":[null,{"numberOfVerses":16,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/MIC/1/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_33_Mic_001_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/MIC/1/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/MIC/1/audio/souer.mp3"},"chapter":{"number":1,"content":[{"type":"heading","content":["Judgment to Come"]},{"type":"verse","number":1,"content":["This is the word of the LORD that came to Micah the Moreshite in the days of Jotham, Ahaz, and Hezekiah, kings of Judah—what he saw regarding Samaria and Jerusalem:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hear, O peoples, all of you;","poem":1},{"text":"listen, O earth, and everyone in it!","poem":2},{"text":"May the Lord GOD bear witness against you,","poem":1},{"text":"the Lord from His holy temple.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For behold, the LORD comes forth","poem":1},{"text":"from His dwelling place;","poem":2},{"text":"He will come down and tread","poem":1},{"text":"on the high places of the earth.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The mountains will melt beneath Him,","poem":1},{"text":"and the valleys will split apart,","poem":2},{"text":"like wax before the fire,","poem":1},{"text":"like water rushing down a slope.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"All this is for the transgression of Jacob","poem":1},{"text":"and the sins of the house of Israel.","poem":2},{"text":"What is the transgression of Jacob?","poem":1},{"text":"Is it not Samaria?","poem":2},{"text":"And what is the high place of Judah?","poem":1},{"text":"Is it not Jerusalem?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Therefore I will make Samaria","poem":1},{"text":"a heap of rubble in the open field,","poem":2},{"lineBreak":true},{"text":"a planting area for a vineyard.","poem":2},{"text":"I will pour her stones into the valley","poem":1},{"text":"and expose her foundations.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"All her carved images will be smashed to pieces;","poem":1},{"text":"all her wages will be burned in the fire,","poem":2},{"lineBreak":true},{"text":"and I will destroy all her idols.","poem":2},{"text":"Since she collected the wages of a prostitute,","poem":1},{"text":"they will be used again on a prostitute.","poem":2}]},{"type":"heading","content":["Weeping and Mourning"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Because of this I will lament and wail;","poem":1},{"text":"I will walk barefoot and naked.","poem":2},{"text":"I will howl like a jackal","poem":1},{"noteId":0},{"text":"and mourn like an ostrich.","poem":2},{"noteId":1}]},{"type":"verse","number":9,"content":[{"text":"For her wound is incurable;","poem":1},{"text":"it has reached even Judah;","poem":2},{"text":"it has approached the gate of my people,","poem":1},{"text":"as far as Jerusalem itself.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Do not tell it in Gath;","poem":1},{"noteId":2},{"text":"do not weep at all.","poem":1},{"text":"Roll in the dust in Beth-leaphrah.","poem":2},{"noteId":3}]},{"type":"verse","number":11,"content":[{"text":"Depart in shameful nakedness,","poem":1},{"text":"O dwellers of Shaphir.","poem":2},{"noteId":4},{"text":"The dwellers of Zaanan","poem":1},{"noteId":5},{"text":"will not come out.","poem":2},{"text":"Beth-ezel","poem":1},{"noteId":6},{"text":"is in mourning;","poem":1},{"text":"its support is taken from you.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"For the dwellers of Maroth","poem":1},{"noteId":7},{"text":"pined for good,","poem":1},{"text":"but calamity came down from the LORD,","poem":2},{"lineBreak":true},{"text":"even to the gate of Jerusalem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Harness your chariot horses,","poem":1},{"text":"O dweller of Lachish.","poem":2},{"noteId":8},{"text":"You were the beginning of sin to the Daughter of Zion,","poem":1},{"text":"for the transgressions of Israel were found in you.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Therefore, send farewell gifts","poem":1},{"noteId":9},{"text":"to Moresheth-gath;","poem":1},{"noteId":10},{"text":"the houses of Achzib","poem":2},{"noteId":11},{"text":"will prove deceptive","poem":2},{"lineBreak":true},{"text":"to the kings of Israel.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I will again bring a conqueror against you,","poem":1},{"text":"O dweller of Mareshah.","poem":2},{"noteId":12},{"lineBreak":true},{"text":"The glory of Israel will come to Adullam.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shave yourselves bald and cut off your hair","poem":1},{"text":"in mourning for your precious children;","poem":2},{"text":"make yourselves as bald as an eagle,","poem":1},{"text":"for they will go from you into exile.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Or a serpent or a dragon","reference":{"chapter":1,"verse":8}},{"noteId":1,"caller":"+","text":"Literally like daughters of an ostrich or like daughters of an owl","reference":{"chapter":1,"verse":8}},{"noteId":2,"caller":"+","text":"Gath sounds like the Hebrew for tell.","reference":{"chapter":1,"verse":10}},{"noteId":3,"caller":"+","text":"Beth-leaphrah means house of dust.","reference":{"chapter":1,"verse":10}},{"noteId":4,"caller":"+","text":"Shaphir means pleasant.","reference":{"chapter":1,"verse":11}},{"noteId":5,"caller":"+","text":"Zaanan sounds like the Hebrew for come out.","reference":{"chapter":1,"verse":11}},{"noteId":6,"caller":"+","text":"Beth-ezel means adjoining house.","reference":{"chapter":1,"verse":11}},{"noteId":7,"caller":"+","text":"Maroth sounds like the Hebrew for bitter.","reference":{"chapter":1,"verse":12}},{"noteId":8,"caller":"+","text":"Lachish sounds like the Hebrew term for team of horses.","reference":{"chapter":1,"verse":13}},{"noteId":9,"caller":"+","text":"Or give dowry","reference":{"chapter":1,"verse":14}},{"noteId":10,"caller":"+","text":"Moresheth sounds like the Hebrew for gift or dowry.","reference":{"chapter":1,"verse":14}},{"noteId":11,"caller":"+","text":"Achzib means deception.","reference":{"chapter":1,"verse":14}},{"noteId":12,"caller":"+","text":"Mareshah sounds like the Hebrew for conqueror.","reference":{"chapter":1,"verse":15}}]}},{"numberOfVerses":13,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/MIC/2/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_33_Mic_002_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/MIC/2/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/MIC/2/audio/souer.mp3"},"chapter":{"number":2,"content":[{"type":"heading","content":["Woe to Oppressors"]},{"type":"verse","number":1,"content":[{"text":"Woe to those who devise iniquity","poem":1},{"text":"and plot evil on their beds!","poem":2},{"text":"At morning’s light they accomplish it","poem":1},{"text":"because the power is in their hands.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"They covet fields and seize them;","poem":1},{"text":"they take away houses.","poem":2},{"text":"They deprive a man of his home,","poem":1},{"text":"a fellow man of his inheritance.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Therefore this is what the LORD says:",{"lineBreak":true},{"text":"“I am planning against this nation a disaster","poem":1},{"text":"from which you cannot free your necks.","poem":2},{"text":"Then you will not walk so proudly,","poem":1},{"text":"for it will be a time of calamity.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"In that day they will take up a proverb against you","poem":1},{"text":"and taunt you with this bitter lamentation:","poem":2},{"text":"‘We are utterly ruined!","poem":1},{"text":"He has changed the portion of my people.","poem":2},{"text":"How He has removed it from me!","poem":1},{"text":"He has allotted our fields to traitors.’”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Therefore, you will have no one in the assembly of the LORD","poem":1},{"text":"to divide the land by lot.","poem":2}]},{"type":"heading","content":["Reproof of False Prophets"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Do not preach,” they preach.","poem":1},{"text":"“Do not preach these things;","poem":2},{"lineBreak":true},{"text":"disgrace will not overtake us.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Should it be said, O house of Jacob,","poem":1},{"text":"“Is the Spirit of the LORD impatient?","poem":2},{"lineBreak":true},{"text":"Are these the things He does?”","poem":2},{"lineBreak":true},{"text":"Do not My words bring good","poem":1},{"text":"to him who walks uprightly?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"But of late My people have risen up","poem":1},{"text":"like an enemy:","poem":2},{"text":"You strip off the splendid robe","poem":1},{"text":"from unsuspecting passersby","poem":2},{"lineBreak":true},{"text":"like men returning from battle.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"You drive the women of My people","poem":1},{"text":"from their pleasant homes.","poem":2},{"text":"You take away My blessing","poem":1},{"text":"from their children forever.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Arise and depart,","poem":1},{"text":"for this is not your place of rest,","poem":2},{"text":"because its defilement brings destruction—","poem":1},{"text":"a grievous destruction!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"If a man of wind were to come","poem":1},{"text":"and say falsely,","poem":2},{"text":"“I will preach to you of wine and strong drink,”","poem":1},{"noteId":13},{"text":"he would be just the preacher for this people!","poem":2}]},{"type":"heading","content":["The Remnant of Israel"]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"I will surely gather all of you, O Jacob;","poem":1},{"text":"I will collect the remnant of Israel.","poem":2},{"text":"I will bring them together like sheep in a pen,","poem":1},{"text":"like a flock in the midst of its pasture—","poem":2},{"lineBreak":true},{"text":"a noisy throng.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"One who breaks open the way","poem":1},{"text":"will go up before them;","poem":2},{"text":"they will break through the gate,","poem":1},{"text":"and go out by it.","poem":2},{"text":"Their King will pass through before them,","poem":1},{"text":"the LORD as their leader.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Or “I will prophesy to you for wine and strong drink”","reference":{"chapter":2,"verse":11}}]}},{"numberOfVerses":12,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/MIC/3/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_33_Mic_003_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/MIC/3/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/MIC/3/audio/souer.mp3"},"chapter":{"number":3,"content":[{"type":"heading","content":["Rulers and Prophets Condemned"]},{"type":"verse","number":1,"content":["Then I said:",{"lineBreak":true},{"text":"“Hear now, O leaders of Jacob,","poem":1},{"text":"you rulers of the house of Israel.","poem":2},{"lineBreak":true},{"text":"Should you not know justice?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"You hate good and love evil.","poem":1},{"text":"You tear the skin from my people","poem":2},{"lineBreak":true},{"text":"and strip the flesh from their bones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"You eat the flesh of my people","poem":1},{"text":"after stripping off their skin","poem":2},{"lineBreak":true},{"text":"and breaking their bones.","poem":2},{"text":"You chop them up like flesh for the cooking pot,","poem":1},{"text":"like meat in a cauldron.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Then they will cry out to the LORD,","poem":1},{"text":"but He will not answer them.","poem":2},{"text":"At that time He will hide His face from them","poem":1},{"text":"because of the evil they have done.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":["This is what the LORD says:",{"lineBreak":true},{"text":"“As for the prophets","poem":1},{"text":"who lead My people astray,","poem":2},{"text":"who proclaim peace","poem":1},{"text":"while they chew with their teeth,","poem":2},{"text":"but declare war against one","poem":1},{"text":"who puts nothing in their mouths:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Therefore night will come over you without visions,","poem":1},{"text":"and darkness without divination.","poem":2},{"text":"The sun will set on these prophets,","poem":1},{"text":"and the daylight will turn black over them.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Then the seers will be ashamed","poem":1},{"text":"and the diviners will be disgraced.","poem":2},{"text":"They will all cover their mouths","poem":1},{"text":"because there is no answer from God.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"As for me, however, I am filled with power","poem":1},{"text":"by the Spirit of the LORD,","poem":2},{"text":"with justice and courage,","poem":1},{"text":"to declare to Jacob his transgression","poem":2},{"lineBreak":true},{"text":"and to Israel his sin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Now hear this, O leaders of the house of Jacob","poem":1},{"text":"and rulers of the house of Israel,","poem":2},{"text":"who despise justice","poem":1},{"text":"and pervert all that is right,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"who build Zion with bloodshed","poem":1},{"text":"and Jerusalem with iniquity.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Her leaders judge for a bribe,","poem":1},{"text":"her priests teach for a price,","poem":2},{"lineBreak":true},{"text":"and her prophets practice divination for money.","poem":2},{"text":"Yet they lean upon the LORD, saying,","poem":1},{"text":"“Is not the LORD among us?","poem":2},{"lineBreak":true},{"text":"No disaster can come upon us.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Therefore, because of you,","poem":1},{"text":"Zion will be plowed like a field,","poem":2},{"text":"Jerusalem will become a heap of rubble,","poem":1},{"text":"and the temple mount a wooded ridge.","poem":2}]}],"footnotes":[]}},{"numberOfVerses":13,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/MIC/4/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_33_Mic_004_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/MIC/4/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/MIC/4/audio/souer.mp3"},"chapter":{"number":4,"content":[{"type":"heading","content":["The Mountain of the House of the LORD"]},{"type":"verse","number":1,"content":[{"text":"In the last days the mountain of the house of the LORD","poem":1},{"text":"will be established as the chief of the mountains;","poem":2},{"text":"it will be raised above the hills,","poem":1},{"text":"and the peoples will stream to it.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"And many nations will come and say:","poem":1},{"lineBreak":true},{"text":"“Come, let us go up to the mountain of the LORD,","poem":1},{"text":"to the house of the God of Jacob.","poem":2},{"text":"He will teach us His ways,","poem":1},{"text":"so that we may walk in His paths.”","poem":2},{"lineBreak":true},{"text":"For the law will go forth from Zion","poem":1},{"text":"and the word of the LORD from Jerusalem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Then He will judge between many peoples","poem":1},{"text":"and arbitrate for strong nations far and wide.","poem":2},{"text":"Then they will beat their swords into plowshares","poem":1},{"text":"and their spears into pruning hooks.","poem":2},{"text":"Nation will no longer take up the sword against nation,","poem":1},{"text":"nor will they train anymore for war.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"And each man will sit under his own vine","poem":1},{"text":"and under his own fig tree,","poem":2},{"text":"with no one to frighten him.","poem":1},{"text":"For the mouth of the LORD of Hosts has spoken.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Though all the nations","poem":1},{"text":"may walk in the name of their gods,","poem":2},{"text":"yet we will walk in the name of the LORD our God","poem":1},{"text":"forever and ever.","poem":2}]},{"type":"heading","content":["The Restoration of Zion"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“On that day,” declares the LORD,","poem":1},{"text":"“I will gather the lame;","poem":2},{"text":"I will assemble the outcast,","poem":1},{"text":"even those whom I have afflicted.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"And I will make the lame into a remnant,","poem":1},{"text":"the outcast into a strong nation.","poem":2},{"text":"Then the LORD will rule over them in Mount Zion","poem":1},{"text":"from that day and forever.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"And you, O watchtower of the flock,","poem":1},{"text":"O stronghold","poem":2},{"noteId":14},{"text":"of the Daughter of Zion—","poem":2},{"text":"the former dominion will be restored to you;","poem":1},{"text":"sovereignty will come to the Daughter of Jerusalem.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Why do you now cry aloud?","poem":1},{"text":"Is there no king among you?","poem":2},{"text":"Has your counselor perished","poem":1},{"text":"so that anguish grips you like a woman in labor?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Writhe in agony, O Daughter of Zion,","poem":1},{"text":"like a woman in labor.","poem":2},{"text":"For now you will leave the city","poem":1},{"text":"and camp in the open fields.","poem":2},{"text":"You will go to Babylon;","poem":1},{"text":"there you will be rescued;","poem":2},{"text":"there the LORD will redeem you","poem":1},{"text":"from the hand of your enemies!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"But now many nations","poem":1},{"text":"have assembled against you,","poem":2},{"text":"saying, “Let her be defiled,","poem":1},{"text":"and let us feast our eyes on Zion.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"But they do not know the thoughts of the LORD","poem":1},{"text":"or understand His plan,","poem":2},{"text":"for He has gathered them","poem":1},{"text":"like sheaves to the threshing floor.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Rise and thresh, O Daughter of Zion,","poem":1},{"text":"for I will give you horns of iron","poem":2},{"text":"and hooves of bronze","poem":1},{"text":"to break to pieces many peoples.","poem":2},{"text":"Then you will devote","poem":1},{"noteId":15},{"text":"their gain to the LORD,","poem":1},{"text":"their wealth to the Lord of all the earth.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Or hill; Hebrew And you, Migdal-eder, the Ophel","reference":{"chapter":4,"verse":8}},{"noteId":15,"caller":"+","text":"Or devote to destruction","reference":{"chapter":4,"verse":13}}]}},{"numberOfVerses":15,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/MIC/5/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_33_Mic_005_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/MIC/5/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/MIC/5/audio/souer.mp3"},"chapter":{"number":5,"content":[{"type":"heading","content":["A Ruler from Bethlehem"]},{"type":"verse","number":1,"content":[{"text":"Now, O daughter of troops,","poem":1},{"text":"mobilize your troops;","poem":2},{"lineBreak":true},{"text":"for a siege is laid against us!","poem":2},{"text":"With a rod they will strike the cheek","poem":1},{"text":"of the judge of Israel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"But you, Bethlehem Ephrathah,","poem":1},{"text":"who are small among the clans","poem":2},{"noteId":16},{"text":"of Judah,","poem":2},{"text":"out of you will come forth for Me","poem":1},{"text":"One to be ruler over Israel","poem":2},{"noteId":17},{"text":"—","poem":2},{"text":"One whose origins are of old,","poem":1},{"text":"from the days of eternity.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Therefore Israel will be abandoned","poem":1},{"text":"until she who is in labor has given birth;","poem":2},{"text":"then the rest of His brothers will return","poem":1},{"text":"to the children of Israel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"He will stand and shepherd His flock","poem":1},{"text":"in the strength of the LORD,","poem":2},{"lineBreak":true},{"text":"in the majestic name of the LORD His God.","poem":2},{"text":"And they will dwell securely,","poem":1},{"text":"for then His greatness will extend","poem":2},{"lineBreak":true},{"text":"to the ends of the earth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"And He will be our peace","poem":1},{"noteId":18},{"text":"when Assyria invades our land","poem":2},{"lineBreak":true},{"text":"and tramples our citadels.","poem":2},{"text":"We will raise against it seven shepherds,","poem":1},{"text":"even eight leaders of men.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"And they will rule the land of Assyria with the sword,","poem":1},{"text":"and the land of Nimrod with the blade drawn.","poem":2},{"text":"So He will deliver us","poem":1},{"text":"when Assyria invades our land","poem":2},{"lineBreak":true},{"text":"and marches into our borders.","poem":2}]},{"type":"heading","content":["The Remnant of Jacob"]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Then the remnant of Jacob will be","poem":1},{"text":"in the midst of many peoples","poem":2},{"text":"like dew from the LORD,","poem":1},{"text":"like showers on the grass,","poem":2},{"text":"which do not wait for man","poem":1},{"text":"or linger for mankind.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Then the remnant of Jacob will be among the nations,","poem":1},{"text":"in the midst of many peoples,","poem":2},{"text":"like a lion among the beasts of the forest,","poem":1},{"text":"like a young lion among flocks of sheep,","poem":2},{"text":"which tramples and tears as it passes through,","poem":1},{"text":"with no one to rescue them.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Your hand will be lifted over your foes,","poem":1},{"text":"and all your enemies will be cut off.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“In that day,”","poem":1},{"text":"declares the LORD,","poem":2},{"text":"“I will remove your horses from among you","poem":1},{"text":"and wreck your chariots.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I will remove the cities of your land","poem":1},{"text":"and tear down all your strongholds.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I will cut the sorceries from your hand,","poem":1},{"text":"and you will have no fortune-tellers.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I will also cut off the carved images","poem":1},{"text":"and sacred pillars from among you,","poem":2},{"text":"so that you will no longer bow down","poem":1},{"text":"to the work of your own hands.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I will root out the Asherah poles from your midst","poem":1},{"text":"and demolish your cities.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I will take vengeance in anger and wrath","poem":1},{"text":"upon the nations that have not obeyed Me.”","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Or thousands","reference":{"chapter":5,"verse":2}},{"noteId":17,"caller":"+","text":"Cited in Matthew 2:6","reference":{"chapter":5,"verse":2}},{"noteId":18,"caller":"+","text":"Or their peace","reference":{"chapter":5,"verse":5}}]}},{"numberOfVerses":16,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/MIC/6/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_33_Mic_006_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/MIC/6/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/MIC/6/audio/souer.mp3"},"chapter":{"number":6,"content":[{"type":"heading","content":["The Case against Israel"]},{"type":"verse","number":1,"content":["Hear now what the LORD says:",{"lineBreak":true},{"text":"“Arise, plead your case before the mountains,","poem":1},{"text":"and let the hills hear your voice.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hear, O mountains, the LORD’s indictment,","poem":1},{"text":"you enduring foundations of the earth.","poem":2},{"text":"For the LORD has a case against His people,","poem":1},{"text":"and He will argue it against Israel:","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"‘My people, what have I done to you?","poem":1},{"text":"Testify against Me how I have wearied you!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"For I brought you up from the land of Egypt","poem":1},{"text":"and redeemed you from the house of slavery.","poem":2},{"text":"I sent Moses before you,","poem":1},{"text":"as well as Aaron and Miriam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"My people, remember what Balak king of Moab counseled","poem":1},{"text":"and what Balaam son of Beor answered.","poem":2},{"text":"Remember your journey from Shittim","poem":1},{"noteId":19},{"text":"to Gilgal,","poem":1},{"text":"so that you may acknowledge the righteousness of the LORD.’”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"With what shall I come before the LORD","poem":1},{"text":"when I bow before the God on high?","poem":2},{"text":"Should I come to Him with burnt offerings,","poem":1},{"text":"with year-old calves?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Would the LORD be pleased with thousands of rams,","poem":1},{"text":"with ten thousand rivers of oil?","poem":2},{"text":"Shall I present my firstborn for my transgression,","poem":1},{"text":"the fruit of my body for the sin of my soul?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"He has shown you, O man, what is good.","poem":1},{"text":"And what does the LORD require of you","poem":2},{"text":"but to act justly, to love mercy,","poem":1},{"text":"and to walk humbly with your God?","poem":2}]},{"type":"heading","content":["The Punishment of Israel"]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"The voice of the LORD calls out to the city","poem":1},{"text":"(and it is sound wisdom to fear Your name):","poem":2},{"text":"“Heed the rod","poem":1},{"text":"and the One who ordained it.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Can I forget any longer,","poem":1},{"text":"O house of the wicked,","poem":2},{"text":"the treasures of wickedness","poem":1},{"text":"and the short ephah, which is accursed?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Can I excuse dishonest scales","poem":1},{"text":"or bags of false weights?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"For the wealthy of the city","poem":1},{"text":"are full of violence,","poem":2},{"text":"and its residents speak lies;","poem":1},{"text":"their tongues are deceitful in their mouths.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Therefore I am striking you severely,","poem":1},{"text":"to ruin you because of your sins.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"You will eat but not be satisfied,","poem":1},{"text":"and your hunger will remain with you.","poem":2},{"text":"What you acquire, you will not preserve;","poem":1},{"text":"and what you save, I will give to the sword.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"You will sow but not reap;","poem":1},{"text":"you will press olives but not anoint yourselves with oil;","poem":2},{"lineBreak":true},{"text":"you will tread grapes but not drink the wine.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"You have kept the statutes of Omri","poem":1},{"text":"and all the practices of Ahab’s house;","poem":2},{"lineBreak":true},{"text":"you have followed their counsel.","poem":2},{"text":"Therefore I will make you a desolation,","poem":1},{"text":"and your inhabitants an object of contempt;","poem":2},{"lineBreak":true},{"text":"you will bear the scorn of the nations.","poem":2},{"noteId":20},{"text":"”","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"Or Acacia Grove","reference":{"chapter":6,"verse":5}},{"noteId":20,"caller":"+","text":"LXX; Hebrew scorn of My people","reference":{"chapter":6,"verse":16}}]}},{"numberOfVerses":20,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/MIC/7/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_33_Mic_007_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/MIC/7/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/MIC/7/audio/souer.mp3"},"chapter":{"number":7,"content":[{"type":"heading","content":["Israel’s Great Misery"]},{"type":"verse","number":1,"content":[{"text":"Woe is me!","poem":1},{"lineBreak":true},{"text":"For I am like one gathering summer fruit","poem":1},{"text":"at the gleaning of the vineyard;","poem":2},{"text":"there is no cluster to eat,","poem":1},{"text":"no early fig that I crave.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The godly man has perished from the earth;","poem":1},{"text":"there is no one upright among men.","poem":2},{"text":"They all lie in wait for blood;","poem":1},{"text":"they hunt one another with a net.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Both hands are skilled at evil;","poem":1},{"text":"the prince and the judge demand a bribe.","poem":2},{"text":"When the powerful utters his evil desire,","poem":1},{"text":"they all conspire together.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The best of them is like a brier;","poem":1},{"text":"the most upright is sharper than a hedge of thorns.","poem":2},{"text":"The day for your watchmen has come,","poem":1},{"text":"the day of your visitation.","poem":2},{"noteId":21},{"lineBreak":true},{"text":"Now is the time of their confusion.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Do not rely on a friend;","poem":1},{"text":"do not trust in a companion.","poem":2},{"text":"Seal the doors of your mouth","poem":1},{"text":"from her who lies in your arms.","poem":2},{"noteId":22}]},{"type":"verse","number":6,"content":[{"text":"For a son dishonors his father,","poem":1},{"text":"a daughter rises against her mother,","poem":2},{"lineBreak":true},{"text":"and a daughter-in-law against her mother-in-law.","poem":2},{"text":"A man’s enemies are the members","poem":1},{"text":"of his own household.","poem":2},{"noteId":23}]},{"type":"heading","content":["Israel’s Confession and Comfort"]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"But as for me, I will look to the LORD;","poem":1},{"text":"I will wait for the God of my salvation.","poem":2},{"lineBreak":true},{"text":"My God will hear me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Do not gloat over me, my enemy!","poem":1},{"text":"Though I have fallen, I will arise;","poem":2},{"text":"though I sit in darkness,","poem":1},{"text":"the LORD will be my light.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Because I have sinned against Him,","poem":1},{"text":"I must endure the rage of the LORD,","poem":2},{"text":"until He argues my case","poem":1},{"text":"and executes justice for me.","poem":2},{"text":"He will bring me into the light;","poem":1},{"text":"I will see His righteousness.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Then my enemy will see","poem":1},{"text":"and will be covered with shame—","poem":2},{"text":"she who said to me,","poem":1},{"text":"“Where is the LORD your God?”","poem":2},{"text":"My eyes will see her;","poem":1},{"text":"at that time she will be trampled","poem":2},{"lineBreak":true},{"text":"like mud in the streets.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"The day for rebuilding your walls will come—","poem":1},{"text":"the day for extending your boundary.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"On that day they will come to you","poem":1},{"text":"from Assyria and the cities of Egypt,","poem":2},{"text":"even from Egypt to the Euphrates,","poem":1},{"noteId":24},{"text":"from sea to sea and mountain to mountain.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Then the earth will become desolate","poem":1},{"text":"because of its inhabitants,","poem":2},{"lineBreak":true},{"text":"as the fruit of their deeds.","poem":2}]},{"type":"heading","content":["God’s Compassion on Israel"]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Shepherd with Your staff Your people,","poem":1},{"text":"the flock of Your inheritance.","poem":2},{"text":"They live alone in a woodland,","poem":1},{"text":"surrounded by pastures.","poem":2},{"noteId":25},{"text":"Let them graze in Bashan and Gilead,","poem":1},{"text":"as in the days of old.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"As in the days when you came out of Egypt,","poem":1},{"text":"I will show My wonders.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nations will see and be ashamed,","poem":1},{"text":"deprived of all their might.","poem":2},{"text":"They will put their hands over their mouths,","poem":1},{"text":"and their ears will become deaf.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"They will lick the dust like a snake,","poem":1},{"text":"like reptiles slithering on the ground.","poem":2},{"text":"They will come trembling from their strongholds","poem":1},{"text":"in the presence of the LORD our God;","poem":2},{"lineBreak":true},{"text":"they will tremble in fear of You.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Who is a God like You,","poem":1},{"text":"who pardons iniquity","poem":2},{"text":"and passes over the transgression","poem":1},{"text":"of the remnant of His inheritance—","poem":2},{"text":"who does not retain His anger forever,","poem":1},{"text":"because He delights in loving devotion?","poem":2},{"noteId":26}]},{"type":"verse","number":19,"content":[{"text":"He will again have compassion on us;","poem":1},{"text":"He will vanquish our iniquities.","poem":2},{"text":"You will cast out all our sins","poem":1},{"text":"into the depths of the sea.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"You will show faithfulness to Jacob","poem":1},{"text":"and loving devotion to Abraham,","poem":2},{"text":"as You swore to our fathers","poem":1},{"text":"from the days of old.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Or your punishment","reference":{"chapter":7,"verse":4}},{"noteId":22,"caller":"+","text":"Hebrew in your bosom","reference":{"chapter":7,"verse":5}},{"noteId":23,"caller":"+","text":"Cited in Matthew 10:35–36; see also Luke 12:53.","reference":{"chapter":7,"verse":6}},{"noteId":24,"caller":"+","text":"Hebrew the River","reference":{"chapter":7,"verse":12}},{"noteId":25,"caller":"+","text":"Or in a woodland, in the midst of Carmel","reference":{"chapter":7,"verse":14}},{"noteId":26,"caller":"+","text":"Forms of the Hebrew chesed are translated here and in most cases throughout the Scriptures as loving devotion; the range of meaning includes love, goodness, kindness, faithfulness, and mercy, as well as loyalty to a covenant.","reference":{"chapter":7,"verse":18}}]}}]}
