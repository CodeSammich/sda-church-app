{"translation":{"id":"BSB","name":"Berean Standard Bible","website":"https://berean.bible/","licenseUrl":"https://berean.bible/","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"BSB","englishName":"Berean Standard Bible","language":"eng","textDirection":"ltr","sha256":"6cc5238e442b4204b0f617cc5c932bc04f3bae4a0658e6393b0e319653ebe37f","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","completeTranslationApiLink":"/api/BSB/complete.json","simpleCompleteTranslationApiLink":"/api/BSB/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31086,"languageName":"English","languageEnglishName":"English"},"book":{"id":"JOL","name":"Joel","commonName":"Joel","title":"Joel","numberOfChapters":3,"totalNumberOfVerses":73},"chapters":[null,{"numberOfVerses":20,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/JOL/1/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_29_Jol_001_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/JOL/1/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOL/1/audio/souer.mp3"},"chapter":{"number":1,"content":[{"type":"heading","content":["The Invasion of Locusts"]},{"type":"verse","number":1,"content":["This is the word of the LORD that came to Joel son of Pethuel:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hear this, O elders;","poem":1},{"text":"and give ear, all who dwell in the land.","poem":2},{"text":"Has anything like this ever happened in your days","poem":1},{"text":"or in the days of your fathers?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tell it to your children;","poem":1},{"text":"let your children tell it to their children,","poem":2},{"lineBreak":true},{"text":"and their children to the next generation.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"What the devouring locust has left,","poem":1},{"text":"the swarming locust has eaten;","poem":2},{"text":"what the swarming locust has left,","poem":1},{"text":"the young locust has eaten;","poem":2},{"text":"and what the young locust has left,","poem":1},{"text":"the destroying locust has eaten.","poem":2},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wake up, you drunkards, and weep;","poem":1},{"text":"wail, all you drinkers of wine,","poem":2},{"text":"because of the sweet wine,","poem":1},{"text":"for it has been cut off from your mouth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"For a nation has invaded My land,","poem":1},{"text":"powerful and without number;","poem":2},{"text":"its teeth are the teeth of a lion,","poem":1},{"text":"and its fangs are the fangs of a lioness.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"It has laid waste My grapevine","poem":1},{"text":"and splintered My fig tree.","poem":2},{"text":"It has stripped off the bark and thrown it away;","poem":1},{"text":"the branches have turned white.","poem":2}]},{"type":"heading","content":["A Call to Mourning"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wail like a virgin dressed in sackcloth,","poem":1},{"text":"grieving for the husband of her youth.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Grain and drink offerings have been cut off","poem":1},{"text":"from the house of the LORD;","poem":2},{"text":"the priests are in mourning,","poem":1},{"text":"those who minister before the LORD.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The field is ruined;","poem":1},{"text":"the land mourns.","poem":2},{"text":"For the grain is destroyed,","poem":1},{"text":"the new wine is dried up, and the oil fails.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be dismayed, O farmers,","poem":1},{"text":"wail, O vinedressers,","poem":2},{"text":"over the wheat and barley,","poem":1},{"text":"because the harvest of the field has perished.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"The grapevine is dried up,","poem":1},{"text":"and the fig tree is withered;","poem":2},{"text":"the pomegranate, palm, and apple—","poem":1},{"text":"all the trees of the orchard—are withered.","poem":2},{"lineBreak":true},{"text":"Surely the joy of mankind has dried up.","poem":2}]},{"type":"heading","content":["A Call to Repentance"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Put on sackcloth and lament, O priests;","poem":1},{"text":"wail, O ministers of the altar.","poem":2},{"text":"Come, spend the night in sackcloth,","poem":1},{"text":"O ministers of my God,","poem":2},{"text":"because the grain and drink offerings","poem":1},{"text":"are withheld from the house of your God.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Consecrate a fast;","poem":1},{"text":"proclaim a solemn assembly!","poem":2},{"text":"Gather the elders","poem":1},{"text":"and all the residents of the land","poem":2},{"text":"to the house of the LORD your God,","poem":1},{"text":"and cry out to the LORD.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Alas for the day!","poem":1},{"text":"For the Day of the LORD is near,","poem":2},{"text":"and it will come","poem":1},{"text":"as destruction from the Almighty.","poem":2},{"noteId":1}]},{"type":"verse","number":16,"content":[{"text":"Has not the food been cut off","poem":1},{"text":"before our very eyes—","poem":2},{"text":"joy and gladness","poem":1},{"text":"from the house of our God?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"The seeds lie shriveled beneath the clods;","poem":1},{"text":"the storehouses are in ruins;","poem":2},{"text":"the granaries are broken down,","poem":1},{"text":"for the grain has withered away.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"How the cattle groan!","poem":1},{"text":"The herds wander in confusion","poem":2},{"text":"because they have no pasture.","poem":1},{"text":"Even the flocks of sheep are suffering.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"To You, O LORD, I call,","poem":1},{"text":"for fire has consumed the open pastures","poem":2},{"lineBreak":true},{"text":"and flames have scorched all the trees of the field.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Even the beasts of the field pant for You,","poem":1},{"text":"for the streams of water have dried up,","poem":2},{"lineBreak":true},{"text":"and fire has consumed the open pastures.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"The precise identification of the four kinds of locusts mentioned here is uncertain.","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"Hebrew Shaddai","reference":{"chapter":1,"verse":15}}]}},{"numberOfVerses":32,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/JOL/2/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_29_Jol_002_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/JOL/2/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOL/2/audio/souer.mp3"},"chapter":{"number":2,"content":[{"type":"heading","content":["The Army of Locusts"]},{"type":"verse","number":1,"content":[{"text":"Blow the ram’s horn in Zion;","poem":1},{"text":"sound the alarm on My holy mountain!","poem":2},{"text":"Let all who dwell in the land tremble,","poem":1},{"text":"for the Day of the LORD is coming;","poem":2},{"lineBreak":true},{"text":"indeed, it is near—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"a day of darkness and gloom,","poem":1},{"text":"a day of clouds and blackness.","poem":2},{"text":"Like the dawn overspreading the mountains","poem":1},{"text":"a great and strong army appears,","poem":2},{"text":"such as never was of old,","poem":1},{"text":"nor will ever be in ages to come.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Before them a fire devours,","poem":1},{"text":"and behind them a flame scorches.","poem":2},{"text":"The land before them is like the Garden of Eden,","poem":1},{"text":"but behind them, it is like a desert wasteland—","poem":2},{"lineBreak":true},{"text":"surely nothing will escape them.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Their appearance is like that of horses,","poem":1},{"text":"and they gallop like swift steeds.","poem":2},{"noteId":2}]},{"type":"verse","number":5,"content":[{"text":"With a sound like that of chariots","poem":1},{"text":"they bound over the mountaintops,","poem":2},{"text":"like the crackling of fire consuming stubble,","poem":1},{"text":"like a mighty army deployed for battle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nations writhe in horror before them;","poem":1},{"text":"every face turns pale.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"They charge like mighty men;","poem":1},{"text":"they scale the walls like men of war.","poem":2},{"text":"Each one marches in formation,","poem":1},{"text":"not swerving from the course.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"They do not jostle one another;","poem":1},{"text":"each proceeds in his path.","poem":2},{"text":"They burst through the defenses,","poem":1},{"text":"never breaking ranks.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"They storm the city;","poem":1},{"text":"they run along the wall;","poem":2},{"text":"they climb into houses,","poem":1},{"text":"entering through windows like thieves.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Before them the earth quakes;","poem":1},{"text":"the heavens tremble.","poem":2},{"text":"The sun and moon grow dark,","poem":1},{"text":"and the stars lose their brightness.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"The LORD raises His voice","poem":1},{"text":"in the presence of His army.","poem":2},{"text":"Indeed, His camp is very large,","poem":1},{"text":"for mighty are those who obey His command.","poem":2},{"text":"For the Day of the LORD is great and very dreadful.","poem":1},{"text":"Who can endure it?","poem":2}]},{"type":"heading","content":["Return with All Your Heart"]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Yet even now,”","poem":1},{"text":"declares the LORD,","poem":2},{"text":"“return to Me with all your heart,","poem":1},{"text":"with fasting, weeping, and mourning.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"So rend your hearts and not your garments,","poem":1},{"text":"and return to the LORD your God.","poem":2},{"text":"For He is gracious and compassionate,","poem":1},{"text":"slow to anger, abounding in loving devotion.","poem":2},{"noteId":3},{"lineBreak":true},{"text":"And He relents from sending disaster.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Who knows? He may turn and relent","poem":1},{"text":"and leave a blessing behind Him—","poem":2},{"text":"grain and drink offerings","poem":1},{"text":"for the LORD your God.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Blow the ram’s horn in Zion,","poem":1},{"text":"consecrate a fast,","poem":2},{"lineBreak":true},{"text":"proclaim a sacred assembly.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gather the people, sanctify the congregation,","poem":1},{"text":"assemble the aged, gather the children,","poem":2},{"lineBreak":true},{"text":"even those nursing at the breast.","poem":2},{"text":"Let the bridegroom leave his room,","poem":1},{"text":"and the bride her chamber.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Let the priests who minister before the LORD","poem":1},{"text":"weep between the portico and the altar,","poem":2},{"text":"saying, “Spare Your people, O LORD,","poem":1},{"text":"and do not make Your heritage a reproach,","poem":2},{"lineBreak":true},{"text":"an object of scorn among the nations.","poem":2},{"text":"Why should they say among the peoples,","poem":1},{"text":"‘Where is their God?’”","poem":2}]},{"type":"heading","content":["Restoration Promised"]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Then the LORD became jealous for His land,","poem":1},{"text":"and He spared His people.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"And the LORD answered His people:","poem":1},{"lineBreak":true},{"text":"“Behold, I will send you","poem":1},{"text":"grain, new wine, and oil,","poem":2},{"lineBreak":true},{"text":"and by them you will be satisfied.","poem":2},{"text":"I will never again make you","poem":1},{"text":"a reproach among the nations.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"The northern army I will drive away from you,","poem":1},{"text":"banishing it to a barren and desolate land,","poem":2},{"text":"its front ranks into the Eastern Sea,","poem":1},{"noteId":4},{"text":"and its rear guard into the Western Sea.","poem":2},{"noteId":5},{"text":"And its stench will rise;","poem":1},{"text":"its foul odor will ascend.","poem":2},{"lineBreak":true},{"text":"For He has done great things.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Do not be afraid, O land;","poem":1},{"text":"rejoice and be glad,","poem":2},{"lineBreak":true},{"text":"for the LORD has done great things.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Do not be afraid, O beasts of the field,","poem":1},{"text":"for the open pastures have turned green,","poem":2},{"text":"the trees bear their fruit,","poem":1},{"text":"and the fig tree and vine yield their best.","poem":2},{"noteId":6}]},{"type":"verse","number":23,"content":[{"text":"Be glad, O children of Zion,","poem":1},{"text":"and rejoice in the LORD your God,","poem":2},{"text":"for He has given you the autumn rains","poem":1},{"text":"for your vindication.","poem":2},{"text":"He sends you showers,","poem":1},{"text":"both autumn and spring rains, as before.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"The threshing floors will be full of grain,","poem":1},{"text":"and the vats will overflow with new wine and oil.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"I will repay you for the years eaten by locusts—","poem":1},{"text":"the swarming locust, the young locust,","poem":2},{"text":"the destroying locust, and the devouring locust","poem":1},{"noteId":7},{"text":"—","poem":1},{"text":"My great army that I sent against you.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"You will have plenty to eat,","poem":1},{"text":"until you are satisfied.","poem":2},{"text":"You will praise the name of the LORD your God,","poem":1},{"text":"who has worked wonders for you.","poem":2},{"text":"My people will never again","poem":1},{"text":"be put to shame.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Then you will know that I am present in Israel","poem":1},{"text":"and that I am the LORD your God,","poem":2},{"lineBreak":true},{"text":"and there is no other.","poem":2},{"text":"My people will never again","poem":1},{"text":"be put to shame.","poem":2}]},{"type":"heading","content":["I Will Pour Out My Spirit"]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"And afterward, I will pour out My Spirit on all people.","poem":1},{"text":"Your sons and daughters will prophesy,","poem":2},{"text":"your old men will dream dreams,","poem":1},{"text":"your young men will see visions.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Even on My menservants and maidservants,","poem":1},{"text":"I will pour out My Spirit in those days.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"I will show wonders in the heavens and on the earth,","poem":1},{"text":"blood and fire and columns","poem":2},{"noteId":8},{"text":"of smoke.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"The sun will be turned to darkness","poem":1},{"text":"and the moon to blood","poem":2},{"lineBreak":true},{"text":"before the coming of the great and awesome","poem":2},{"noteId":9},{"text":"Day of the LORD.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"And everyone who calls on the name of the LORD","poem":1},{"text":"will be saved;","poem":2},{"noteId":10},{"text":"for on Mount Zion and in Jerusalem","poem":1},{"text":"there will be deliverance, as the LORD has promised,","poem":2},{"lineBreak":true},{"text":"among the remnant called by the LORD.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Or like charioteers or like cavalry","reference":{"chapter":2,"verse":4}},{"noteId":3,"caller":"+","text":"Forms of the Hebrew chesed are translated here and in most cases throughout the Scriptures as loving devotion; the range of meaning includes love, goodness, kindness, faithfulness, and mercy, as well as loyalty to a covenant.","reference":{"chapter":2,"verse":13}},{"noteId":4,"caller":"+","text":"That is, the Dead Sea","reference":{"chapter":2,"verse":20}},{"noteId":5,"caller":"+","text":"That is, the Mediterranean Sea, also called the Great Sea","reference":{"chapter":2,"verse":20}},{"noteId":6,"caller":"+","text":"Literally their strength","reference":{"chapter":2,"verse":22}},{"noteId":7,"caller":"+","text":"The precise identification of the four kinds of insects mentioned here is uncertain.","reference":{"chapter":2,"verse":25}},{"noteId":8,"caller":"+","text":"LXX clouds or billows","reference":{"chapter":2,"verse":30}},{"noteId":9,"caller":"+","text":"Or dreadful; LXX glorious","reference":{"chapter":2,"verse":31}},{"noteId":10,"caller":"+","text":"Cited in Acts 2:17–21 and Romans 10:13","reference":{"chapter":2,"verse":32}}]}},{"numberOfVerses":21,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/JOL/3/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_29_Jol_003_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/JOL/3/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/JOL/3/audio/souer.mp3"},"chapter":{"number":3,"content":[{"type":"heading","content":["The LORD Judges the Nations"]},{"type":"verse","number":1,"content":[{"text":"“Yes, in those days and at that time,","poem":1},{"text":"when I restore Judah and Jerusalem from captivity,","poem":2},{"noteId":11}]},{"type":"verse","number":2,"content":[{"text":"I will gather all the nations","poem":1},{"text":"and bring them down to the Valley of Jehoshaphat.","poem":2},{"noteId":12},{"text":"There I will enter into judgment against them","poem":1},{"text":"concerning My people, My inheritance, Israel,","poem":2},{"text":"whom they have scattered among the nations","poem":1},{"text":"as they divided up My land.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"They cast lots for My people;","poem":1},{"text":"they bartered a boy for a prostitute","poem":2},{"lineBreak":true},{"text":"and sold a girl for wine to drink.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Now what do you have against Me, O Tyre, Sidon, and all the regions of Philistia? Are you rendering against Me a recompense? If you retaliate against Me, I will swiftly and speedily return your recompense upon your heads."]},{"type":"verse","number":5,"content":["For you took My silver and gold and carried off My finest treasures to your temples.",{"noteId":13}]},{"type":"verse","number":6,"content":["You sold the people of Judah and Jerusalem to the Greeks,",{"noteId":14},"to send them far from their homeland."]},{"type":"line_break"},{"type":"verse","number":7,"content":["Behold, I will rouse them from the places to which you sold them; I will return your recompense upon your heads."]},{"type":"verse","number":8,"content":["I will sell your sons and daughters into the hands of the people of Judah, and they will sell them to the Sabeans—to a distant nation.”",{"lineBreak":true},"Indeed, the LORD has spoken."]},{"type":"line_break"},{"type":"verse","number":9,"content":["Proclaim this among the nations:",{"lineBreak":true},{"text":"“Prepare for war;","poem":1},{"text":"rouse the mighty men;","poem":2},{"text":"let all the men of war","poem":1},{"text":"advance and attack!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Beat your plowshares into swords","poem":1},{"text":"and your pruning hooks into spears.","poem":2},{"lineBreak":true},{"text":"Let the weak say, ‘I am strong!’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Come quickly, all you surrounding nations,","poem":1},{"text":"and gather yourselves.","poem":2},{"text":"Bring down Your mighty ones,","poem":1},{"text":"O LORD.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Let the nations be roused","poem":1},{"text":"and advance to the Valley of Jehoshaphat,","poem":2},{"text":"for there I will sit down","poem":1},{"text":"to judge all the nations on every side.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Swing the sickle,","poem":1},{"text":"for the harvest is ripe.","poem":2},{"noteId":15},{"text":"Come, trample the grapes,","poem":1},{"text":"for the winepress is full;","poem":2},{"text":"the wine vats overflow","poem":1},{"text":"because their wickedness is great.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Multitudes, multitudes","poem":1},{"text":"in the valley of decision!","poem":2},{"text":"For the Day of the LORD is near","poem":1},{"text":"in the valley of decision.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"The sun and moon will grow dark,","poem":1},{"text":"and the stars will no longer shine.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"The LORD will roar from Zion","poem":1},{"text":"and raise His voice from Jerusalem;","poem":2},{"lineBreak":true},{"text":"heaven and earth will tremble.","poem":2},{"text":"But the LORD will be a refuge for His people,","poem":1},{"text":"a stronghold for the people of Israel.","poem":2}]},{"type":"heading","content":["Blessings for God’s People"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Then you will know that I am the LORD your God,","poem":1},{"text":"who dwells in Zion, My holy mountain.","poem":2},{"text":"Jerusalem will be holy,","poem":1},{"text":"never again to be overrun by foreigners.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"And in that day the mountains will drip with sweet wine,","poem":1},{"text":"and the hills will flow with milk.","poem":2},{"text":"All the streams of Judah will run with water,","poem":1},{"text":"and a spring will flow from the house of the LORD","poem":2},{"lineBreak":true},{"text":"to water the Valley of Acacias.","poem":2},{"noteId":16}]},{"type":"verse","number":19,"content":[{"text":"Egypt will become desolate,","poem":1},{"text":"and Edom a desert wasteland,","poem":2},{"text":"because of the violence done to the people of Judah,","poem":1},{"text":"in whose land they shed innocent blood.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"But Judah will be inhabited forever,","poem":1},{"text":"and Jerusalem from generation to generation.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"For I will avenge their blood,","poem":1},{"text":"which I have not yet avenged.","poem":2},{"noteId":17},{"text":"”","poem":2},"For the LORD dwells in Zion."]}],"footnotes":[{"noteId":11,"caller":"+","text":"Or restore the fortunes of Judah and Jerusalem","reference":{"chapter":3,"verse":1}},{"noteId":12,"caller":"+","text":"Jehoshaphat means the LORD judges; also in verse 12.","reference":{"chapter":3,"verse":2}},{"noteId":13,"caller":"+","text":"Or palaces","reference":{"chapter":3,"verse":5}},{"noteId":14,"caller":"+","text":"Or to the peoples of Javan","reference":{"chapter":3,"verse":6}},{"noteId":15,"caller":"+","text":"LXX the harvest has come; see also Mark 4:29.","reference":{"chapter":3,"verse":13}},{"noteId":16,"caller":"+","text":"Or Valley of Shittim","reference":{"chapter":3,"verse":18}},{"noteId":17,"caller":"+","text":"Or For I will pardon their bloodguilt, which I have not yet pardoned.","reference":{"chapter":3,"verse":21}}]}}]}
