{"translation":{"id":"BSB","name":"Berean Standard Bible","website":"https://berean.bible/","licenseUrl":"https://berean.bible/","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"BSB","englishName":"Berean Standard Bible","language":"eng","textDirection":"ltr","sha256":"6cc5238e442b4204b0f617cc5c932bc04f3bae4a0658e6393b0e319653ebe37f","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","completeTranslationApiLink":"/api/BSB/complete.json","simpleCompleteTranslationApiLink":"/api/BSB/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31086,"languageName":"English","languageEnglishName":"English"},"book":{"id":"HAB","name":"Habakkuk","commonName":"Habakkuk","title":"Habakkuk","numberOfChapters":3,"totalNumberOfVerses":56},"chapters":[null,{"numberOfVerses":17,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/HAB/1/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_35_Hab_001_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/HAB/1/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HAB/1/audio/souer.mp3"},"chapter":{"number":1,"content":[{"type":"heading","content":["Habakkuk’s First Complaint"]},{"type":"verse","number":1,"content":["This is the burden that Habakkuk the prophet received in a vision:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"How long, O LORD, must I call for help","poem":1},{"text":"but You do not hear,","poem":2},{"text":"or cry out to You, “Violence!”","poem":1},{"text":"but You do not save?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Why do You make me see iniquity?","poem":1},{"text":"Why do You tolerate wrongdoing?","poem":2},{"text":"Destruction and violence are before me.","poem":1},{"text":"Strife is ongoing, and conflict abounds.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Therefore the law is paralyzed,","poem":1},{"text":"and justice never goes forth.","poem":2},{"text":"For the wicked hem in the righteous,","poem":1},{"text":"so that justice is perverted.","poem":2}]},{"type":"heading","content":["The LORD’s Answer"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Look at the nations and observe—","poem":1},{"text":"be utterly astounded!","poem":2},{"noteId":0},{"text":"For I am doing a work in your days","poem":1},{"text":"that you would never believe","poem":2},{"lineBreak":true},{"text":"even if someone told you.","poem":2},{"noteId":1}]},{"type":"verse","number":6,"content":[{"text":"For behold, I am raising up the Chaldeans","poem":1},{"noteId":2},{"text":"—","poem":1},{"text":"that ruthless and impetuous nation","poem":2},{"text":"which marches through the breadth of the earth","poem":1},{"text":"to seize dwellings not their own.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"They are dreaded and feared;","poem":1},{"text":"from themselves they derive justice and sovereignty.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Their horses are swifter than leopards,","poem":1},{"text":"fiercer than wolves of the night.","poem":2},{"text":"Their horsemen charge ahead,","poem":1},{"text":"and their cavalry comes from afar.","poem":2},{"text":"They fly like a vulture,","poem":1},{"text":"swooping down to devour.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"All of them come bent on violence;","poem":1},{"text":"their hordes advance like the east wind;","poem":2},{"lineBreak":true},{"text":"they gather prisoners like sand.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"They scoff at kings","poem":1},{"text":"and make rulers an object of scorn.","poem":2},{"text":"They laugh at every fortress","poem":1},{"text":"and build up siege ramps to seize it.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Then they sweep by like the wind","poem":1},{"text":"and pass through.","poem":2},{"text":"They are guilty;","poem":1},{"text":"their own strength is their god.”","poem":2}]},{"type":"heading","content":["Habakkuk’s Second Complaint"]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Are You not from everlasting,","poem":1},{"text":"O LORD, my God, my Holy One?","poem":2},{"lineBreak":true},{"text":"We will not die.","poem":2},{"text":"O LORD, You have appointed them","poem":1},{"text":"to execute judgment;","poem":2},{"text":"O Rock, You have established them","poem":1},{"text":"for correction.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Your eyes are too pure to look upon evil,","poem":1},{"text":"and You cannot tolerate wrongdoing.","poem":2},{"text":"So why do You tolerate the faithless?","poem":1},{"text":"Why are You silent","poem":2},{"text":"while the wicked swallow up","poem":1},{"text":"those more righteous than themselves?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"You have made men like the fish of the sea,","poem":1},{"text":"like creeping things that have no ruler.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"The foe pulls all of them up","poem":1},{"noteId":3},{"text":"with a hook;","poem":1},{"text":"he catches them in his dragnet,","poem":2},{"text":"and gathers them in his fishing net;","poem":1},{"text":"so he rejoices gladly.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Therefore he sacrifices to his dragnet","poem":1},{"text":"and burns incense to his fishing net,","poem":2},{"text":"for by these things his portion is sumptuous","poem":1},{"text":"and his food is rich.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Will he, therefore, empty his net","poem":1},{"text":"and continue to slay nations without mercy?","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"LXX Look, you scoffers, wonder and perish!","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"Cited in Acts 13:41","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"That is, the Babylonians","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Literally He pulls all of them up","reference":{"chapter":1,"verse":15}}]}},{"numberOfVerses":20,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/HAB/2/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_35_Hab_002_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/HAB/2/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HAB/2/audio/souer.mp3"},"chapter":{"number":2,"content":[{"type":"heading","content":["The LORD Answers Again"]},{"type":"verse","number":1,"content":[{"text":"I will stand at my guard post","poem":1},{"text":"and station myself on the ramparts.","poem":2},{"text":"I will watch to see what He will say to me,","poem":1},{"text":"and how I should answer when corrected.","poem":2}]},{"type":"verse","number":2,"content":["Then the LORD answered me:",{"lineBreak":true},{"text":"“Write down this vision","poem":1},{"text":"and clearly inscribe it on tablets,","poem":2},{"lineBreak":true},{"text":"so that a herald may run with it.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For the vision awaits an appointed time;","poem":1},{"text":"it testifies of the end and does not lie.","poem":2},{"text":"Though it lingers, wait for it,","poem":1},{"text":"since it will surely come and will not delay.","poem":2},{"noteId":4}]},{"type":"verse","number":4,"content":[{"text":"Look at the proud one; his soul is not upright","poem":1},{"noteId":5},{"text":"—","poem":1},{"text":"but the righteous will live by faith","poem":2},{"noteId":6},{"text":"—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"and wealth","poem":1},{"noteId":7},{"text":"indeed betrays him.","poem":1},{"text":"He is an arrogant man never at rest.","poem":2},{"text":"He enlarges his appetite like Sheol,","poem":1},{"text":"and like Death, he is never satisfied.","poem":2},{"text":"He gathers all the nations to himself","poem":1},{"text":"and collects all the peoples as his own.","poem":2}]},{"type":"heading","content":["Woe to the Chaldeans"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Will not all of these take up a taunt against him,","poem":1},{"text":"speaking with mockery and derision:","poem":2},{"lineBreak":true},{"text":"‘Woe to him who amasses what is not his","poem":1},{"text":"and makes himself rich with many loans!","poem":2},{"lineBreak":true},{"text":"How long will this go on?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Will not your creditors suddenly arise","poem":1},{"text":"and those who disturb you awaken?","poem":2},{"lineBreak":true},{"text":"Then you will become their prey.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Because you have plundered many nations,","poem":1},{"text":"the remnant of the people will plunder you—","poem":2},{"text":"because of your bloodshed against man","poem":1},{"text":"and your violence against the land, the city,","poem":2},{"lineBreak":true},{"text":"and all their dwellers.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Woe to him who builds his house","poem":1},{"text":"by unjust gain,","poem":2},{"text":"to place his nest on high","poem":1},{"text":"and escape the hand of disaster!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"You have plotted shame for your house","poem":1},{"text":"by cutting off many peoples","poem":2},{"lineBreak":true},{"text":"and forfeiting your life.","poem":2},{"noteId":8}]},{"type":"verse","number":11,"content":[{"text":"For the stones will cry out from the wall,","poem":1},{"text":"and the rafters will echo it from the woodwork.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Woe to him who builds a city with bloodshed","poem":1},{"text":"and establishes a town by iniquity!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Is it not indeed from the LORD of Hosts","poem":1},{"text":"that the labor of the people only feeds the fire,","poem":2},{"lineBreak":true},{"text":"and the nations weary themselves in vain?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"For the earth will be filled","poem":1},{"text":"with the knowledge of the glory of the LORD","poem":2},{"lineBreak":true},{"text":"as the waters cover the sea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Woe to him who gives drink to his neighbors,","poem":1},{"text":"pouring it from the wineskin until they are drunk,","poem":2},{"lineBreak":true},{"text":"in order to gaze at their nakedness!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"You will be filled with shame instead of glory.","poem":1},{"text":"You too must drink","poem":2},{"lineBreak":true},{"text":"and expose your uncircumcision!","poem":2},{"noteId":9},{"text":"The cup in the LORD’s right hand","poem":1},{"text":"will come around to you,","poem":2},{"lineBreak":true},{"text":"and utter disgrace will cover your glory.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"For your violence against Lebanon will overwhelm you,","poem":1},{"text":"and the destruction of animals will terrify you,","poem":2},{"text":"because of your bloodshed against men","poem":1},{"text":"and your violence against the land, the city,","poem":2},{"lineBreak":true},{"text":"and all their dwellers.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"What use is an idol,","poem":1},{"text":"that a craftsman should carve it—","poem":2},{"text":"or an image,","poem":1},{"text":"a teacher of lies?","poem":2},{"text":"For its maker trusts in his own creation;","poem":1},{"text":"he makes idols that cannot speak.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Woe to him who says to wood, ‘Awake!’","poem":1},{"text":"or to silent stone, ‘Arise!’","poem":2},{"lineBreak":true},{"text":"Can it give guidance?","poem":2},{"text":"Behold, it is overlaid with gold and silver,","poem":1},{"text":"yet there is no breath in it at all.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"But the LORD is in His holy temple;","poem":1},{"text":"let all the earth be silent before Him.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Or Though He lingers, wait for Him, since He will surely come and will not delay; see also LXX; cited in Hebrews 10:37.","reference":{"chapter":2,"verse":3}},{"noteId":5,"caller":"+","text":"LXX If he should draw back, My soul has no pleasure in him","reference":{"chapter":2,"verse":4}},{"noteId":6,"caller":"+","text":"Or faithfulness; cited in Romans 1:17, Galatians 3:11, and Hebrews 10:38","reference":{"chapter":2,"verse":4}},{"noteId":7,"caller":"+","text":"DSS; MT wine","reference":{"chapter":2,"verse":5}},{"noteId":8,"caller":"+","text":"Literally sinning against your soul","reference":{"chapter":2,"verse":10}},{"noteId":9,"caller":"+","text":"DSS, LXX, and Syriac and stagger","reference":{"chapter":2,"verse":16}}]}},{"numberOfVerses":19,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/HAB/3/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_35_Hab_003_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/HAB/3/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/HAB/3/audio/souer.mp3"},"chapter":{"number":3,"content":[{"type":"heading","content":["Habakkuk’s Prayer"]},{"type":"verse","number":1,"content":["This is a prayer of Habakkuk the prophet, according to Shigionoth:",{"noteId":10}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O LORD, I have heard the report of You;","poem":1},{"text":"I stand in awe, O LORD, of Your deeds.","poem":2},{"text":"Revive them in these years;","poem":1},{"text":"make them known in these years.","poem":2},{"lineBreak":true},{"text":"In Your wrath, remember mercy!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"God came from Teman,","poem":1},{"text":"and the Holy One from Mount Paran.","poem":2},"Selah",{"noteId":11},{"text":"His glory covered the heavens,","poem":1},{"text":"and His praise filled the earth.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"His radiance was like the sunlight;","poem":1},{"text":"rays flashed from His hand,","poem":2},{"lineBreak":true},{"text":"where His power is hidden.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Plague went before Him,","poem":1},{"text":"and fever followed in His steps.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He stood and measured the earth;","poem":1},{"text":"He looked and startled the nations;","poem":2},{"text":"the ancient mountains crumbled;","poem":1},{"text":"the perpetual hills collapsed.","poem":2},{"lineBreak":true},{"text":"His ways are everlasting.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I saw the tents of Cushan in distress;","poem":1},{"text":"the curtains of Midian were trembling.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Were You angry at the rivers, O LORD?","poem":1},{"text":"Was Your wrath against the streams?","poem":2},{"text":"Did You rage against the sea","poem":1},{"text":"when You rode on Your horses,","poem":2},{"lineBreak":true},{"text":"on Your chariots of salvation?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"You brandished Your bow;","poem":1},{"text":"You called for many arrows.","poem":2},"Selah",{"text":"You split the earth with rivers.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"The mountains saw You and quaked;","poem":1},{"text":"torrents of water swept by.","poem":2},{"text":"The deep roared with its voice","poem":1},{"text":"and lifted its hands on high.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sun and moon stood still","poem":1},{"text":"in their places","poem":2},{"text":"at the flash of Your flying arrows,","poem":1},{"text":"at the brightness of Your shining spear.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"You marched across the earth with fury;","poem":1},{"text":"You threshed the nations in wrath.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"You went forth for the salvation of Your people,","poem":1},{"text":"to save Your anointed.","poem":2},{"text":"You crushed the head of the house of the wicked","poem":1},{"text":"and stripped him from head to toe.","poem":2},"Selah"]},{"type":"verse","number":14,"content":[{"text":"With his own spear You pierced his head,","poem":1},{"text":"when his warriors stormed out to scatter us,","poem":2},{"text":"gloating as though ready","poem":1},{"text":"to secretly devour the weak.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"You trampled the sea with Your horses,","poem":1},{"text":"churning the great waters.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"I heard and trembled within;","poem":1},{"text":"my lips quivered at the sound.","poem":2},{"text":"Decay entered my bones;","poem":1},{"text":"I trembled where I stood.","poem":2},{"text":"Yet I must wait patiently for the day of distress","poem":1},{"text":"to come upon the people who invade us.","poem":2}]},{"type":"heading","content":["Habakkuk Rejoices"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Though the fig tree does not bud","poem":1},{"text":"and no fruit is on the vines,","poem":2},{"text":"though the olive crop fails","poem":1},{"text":"and the fields produce no food,","poem":2},{"text":"though the sheep are cut off from the fold","poem":1},{"text":"and no cattle are in the stalls,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"yet I will exult in the LORD;","poem":1},{"text":"I will rejoice in the God of my salvation!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"GOD the Lord is my strength;","poem":1},{"text":"He makes my feet like those of a deer;","poem":2},{"lineBreak":true},{"text":"He makes me walk upon the heights!","poem":2},"For the choirmaster. With stringed instruments."]}],"footnotes":[{"noteId":10,"caller":"+","text":"Shigionoth is probably a musical term indicating the setting for the prayer.","reference":{"chapter":3,"verse":1}},{"noteId":11,"caller":"+","text":"Selah or Interlude is probably a musical or literary term; also in verses 9 and 13.","reference":{"chapter":3,"verse":3}}]}}]}
