{"translation":{"id":"BSB","name":"Berean Standard Bible","website":"https://berean.bible/","licenseUrl":"https://berean.bible/","license":{"attribution":"not-required","commercialUse":"allowed","derivatives":"allowed","copyleft":false,"publicDomain":true},"shortName":"BSB","englishName":"Berean Standard Bible","language":"eng","textDirection":"ltr","sha256":"6cc5238e442b4204b0f617cc5c932bc04f3bae4a0658e6393b0e319653ebe37f","availableFormats":["json"],"listOfBooksApiLink":"/api/BSB/books.json","completeTranslationApiLink":"/api/BSB/complete.json","simpleCompleteTranslationApiLink":"/api/BSB/complete.simple.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31086,"languageName":"English","languageEnglishName":"English"},"book":{"id":"NAM","name":"Nahum","commonName":"Nahum","title":"Nahum","numberOfChapters":3,"totalNumberOfVerses":47},"chapters":[null,{"numberOfVerses":15,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/NAM/1/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_34_Nam_001_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/NAM/1/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/NAM/1/audio/souer.mp3"},"chapter":{"number":1,"content":[{"type":"heading","content":["The Burden against Nineveh"]},{"type":"verse","number":1,"content":["This is the burden against Nineveh, the book of the vision of Nahum the Elkoshite:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"The LORD is a jealous and avenging God;","poem":1},{"text":"the LORD is avenging and full of wrath.","poem":2},{"text":"The LORD takes vengeance on His foes","poem":1},{"text":"and reserves wrath for His enemies.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The LORD is slow to anger","poem":1},{"text":"and great in power;","poem":2},{"text":"the LORD will by no means","poem":1},{"text":"leave the guilty unpunished.","poem":2},{"text":"His path is in the whirlwind and storm,","poem":1},{"text":"and clouds are the dust beneath His feet.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He rebukes the sea and dries it up;","poem":1},{"text":"He makes all the rivers run dry.","poem":2},{"text":"Bashan and Carmel wither,","poem":1},{"text":"and the flower of Lebanon wilts.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The mountains quake before Him,","poem":1},{"text":"and the hills melt away;","poem":2},{"text":"the earth trembles at His presence—","poem":1},{"text":"the world and all its dwellers.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Who can withstand His indignation?","poem":1},{"text":"Who can endure His burning anger?","poem":2},{"text":"His wrath is poured out like fire;","poem":1},{"text":"even rocks are shattered before Him.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"The LORD is good,","poem":1},{"text":"a stronghold in the day of distress;","poem":2},{"lineBreak":true},{"text":"He cares for those who trust in Him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"But with an overwhelming flood","poem":1},{"text":"He will make an end of Nineveh","poem":2},{"noteId":0},{"lineBreak":true},{"text":"and pursue His enemies into darkness.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Whatever you plot against the LORD,","poem":1},{"text":"He will bring to an end.","poem":2},{"text":"Affliction will not rise up","poem":1},{"text":"a second time.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"For they will be entangled as with thorns","poem":1},{"text":"and consumed like the drink of a drunkard—","poem":2},{"lineBreak":true},{"text":"like stubble that is fully dry.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"From you, O Nineveh, comes forth","poem":1},{"text":"a plotter of evil against the LORD,","poem":2},{"lineBreak":true},{"text":"a counselor of wickedness.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["This is what the LORD says:",{"lineBreak":true},{"text":"“Though they are allied and numerous,","poem":1},{"text":"yet they will be cut down and pass away.","poem":2},{"text":"Though I have afflicted you, O Judah,","poem":1},{"text":"I will afflict you no longer.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"For I will now break their yoke from your neck","poem":1},{"text":"and tear away your shackles.”","poem":2}]},{"type":"verse","number":14,"content":["The LORD has issued a command concerning you, O Nineveh:",{"lineBreak":true},{"text":"“There will be no descendants","poem":1},{"text":"to carry on your name.","poem":2},{"text":"I will cut off the carved image and cast idol","poem":1},{"text":"from the house of your gods;","poem":2},{"text":"I will prepare your grave,","poem":1},{"text":"for you are contemptible.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Look to the mountains—","poem":1},{"text":"the feet of one who brings good news,","poem":2},{"lineBreak":true},{"text":"who proclaims peace!","poem":2},{"text":"Celebrate your feasts, O Judah;","poem":1},{"text":"fulfill your vows.","poem":2},{"text":"For the wicked will never again march through you;","poem":1},{"text":"they will be utterly cut off.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Literally of her place","reference":{"chapter":1,"verse":8}}]}},{"numberOfVerses":13,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/NAM/2/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_34_Nam_002_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/NAM/2/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/NAM/2/audio/souer.mp3"},"chapter":{"number":2,"content":[{"type":"heading","content":["The Overthrow of Nineveh"]},{"type":"verse","number":1,"content":[{"text":"One who scatters advances","poem":1},{"text":"against you, O Nineveh.","poem":2},{"text":"Guard the fortress!","poem":1},{"text":"Watch the road!","poem":2},{"text":"Brace yourselves!","poem":1},{"noteId":1},{"text":"Summon all your strength!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"For the LORD will restore the splendor of Jacob","poem":1},{"text":"like the splendor of Israel,","poem":2},{"text":"though destroyers have laid them waste","poem":1},{"text":"and ruined the branches of their vine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"The shields of his mighty men are red;","poem":1},{"text":"the valiant warriors are dressed in scarlet.","poem":2},{"text":"The fittings of the chariots flash like fire","poem":1},{"text":"on the day they are prepared,","poem":2},{"text":"and the spears of cypress","poem":1},{"text":"have been brandished.","poem":2},{"noteId":2}]},{"type":"verse","number":4,"content":[{"text":"The chariots dash through the streets;","poem":1},{"text":"they rush around the plazas,","poem":2},{"text":"appearing like torches,","poem":1},{"text":"darting about like lightning.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He summons his nobles;","poem":1},{"text":"they stumble as they advance.","poem":2},{"text":"They race to its wall;","poem":1},{"text":"the protective shield is set in place.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The river gates are thrown open","poem":1},{"text":"and the palace collapses.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"It is decreed that the city be exiled","poem":1},{"text":"and carried away;","poem":2},{"text":"her maidservants moan like doves,","poem":1},{"text":"and beat upon their breasts.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nineveh has been like a pool of water","poem":1},{"text":"throughout her days,","poem":2},{"lineBreak":true},{"text":"but now it is draining away.","poem":2},{"text":"“Stop! Stop!” they cry,","poem":1},{"text":"but no one turns back.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Plunder the silver!","poem":1},{"text":"Plunder the gold!”","poem":2},{"text":"There is no end to the treasure,","poem":1},{"text":"an abundance of every precious thing.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"She is emptied!","poem":1},{"text":"Yes, she is desolate and laid waste!","poem":2},{"text":"Hearts melt, knees knock,","poem":1},{"text":"bodies tremble, and every face grows pale!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Where is the lions’ lair","poem":1},{"text":"or the feeding ground of the young lions,","poem":2},{"text":"where the lion and lioness prowled with their cubs,","poem":1},{"text":"with nothing to frighten them away?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"The lion mauled enough for its cubs","poem":1},{"text":"and strangled prey for the lioness.","poem":2},{"text":"It filled its dens with the kill,","poem":1},{"text":"and its lairs with mauled prey.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Behold, I am against you,”","poem":1},{"text":"declares the LORD of Hosts.","poem":2},{"text":"“I will reduce your chariots to cinders,","poem":1},{"text":"and the sword will devour your young lions.","poem":2},{"text":"I will cut off your prey from the earth,","poem":1},{"text":"and the voices of your messengers","poem":2},{"lineBreak":true},{"text":"will no longer be heard.”","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Hebrew Strengthen your loins!","reference":{"chapter":2,"verse":1}},{"noteId":2,"caller":"+","text":"Hebrew; alternately, the spears may be of pine or juniper or fir; LXX and Syriac they are prepared, and the horsemen rush to and fro.","reference":{"chapter":2,"verse":3}}]}},{"numberOfVerses":19,"thisChapterAudioLinks":{"david":"https://audio.bible.helloao.org/api/BSB/NAM/3/audio/david.mp3","gilbert":"https://openbible.com/audio/gilbert/BSB_34_Nam_003_G.mp3","hays":"https://audio.bible.helloao.org/api/BSB/NAM/3/audio/hays.mp3","souer":"https://audio.bible.helloao.org/api/BSB/NAM/3/audio/souer.mp3"},"chapter":{"number":3,"content":[{"type":"heading","content":["Judgment on Nineveh"]},{"type":"verse","number":1,"content":[{"text":"Woe to the city of blood,","poem":1},{"text":"full of lies,","poem":2},{"text":"full of plunder,","poem":1},{"text":"never without prey.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"The crack of the whip,","poem":1},{"text":"the rumble of the wheel,","poem":2},{"text":"galloping horse","poem":1},{"text":"and bounding chariot!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Charging horseman,","poem":1},{"text":"flashing sword,","poem":2},{"lineBreak":true},{"text":"shining spear;","poem":2},{"text":"heaps of slain,","poem":1},{"text":"mounds of corpses,","poem":2},{"text":"dead bodies without end—","poem":1},{"text":"they stumble over their dead—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"because of the many harlotries of the harlot,","poem":1},{"text":"the seductive mistress of sorcery,","poem":2},{"text":"who betrays nations by her prostitution","poem":1},{"text":"and clans by her witchcraft.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Behold, I am against you,”","poem":1},{"text":"declares the LORD of Hosts.","poem":2},{"text":"“I will lift your skirts over your face.","poem":1},{"text":"I will show your nakedness to the nations","poem":2},{"lineBreak":true},{"text":"and your shame to the kingdoms.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I will pelt you with filth","poem":1},{"text":"and treat you with contempt;","poem":2},{"lineBreak":true},{"text":"I will make a spectacle of you.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Then all who see you","poem":1},{"text":"will recoil from you and say,","poem":2},{"text":"‘Nineveh is devastated;","poem":1},{"text":"who will grieve for her?’","poem":2},{"text":"Where can I find","poem":1},{"text":"comforters for you?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Are you better than Thebes,","poem":1},{"noteId":3},{"text":"stationed by the Nile with water around her,","poem":2},{"text":"whose rampart was the sea,","poem":1},{"text":"whose wall was the water?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Cush","poem":1},{"noteId":4},{"text":"and Egypt were her boundless strength;","poem":1},{"text":"Put and Libya were her allies.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yet she became an exile;","poem":1},{"text":"she went into captivity.","poem":2},{"text":"Her infants were dashed to pieces","poem":1},{"text":"at the head of every street.","poem":2},{"text":"They cast lots for her dignitaries,","poem":1},{"text":"and all her nobles were bound in chains.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"You too will become drunk;","poem":1},{"text":"you will go into hiding","poem":2},{"lineBreak":true},{"text":"and seek refuge from the enemy.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"All your fortresses are fig trees","poem":1},{"text":"with the first ripe figs;","poem":2},{"text":"when shaken, they fall","poem":1},{"text":"into the mouth of the eater!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Look at your troops—","poem":1},{"text":"they are like your women!","poem":2},{"text":"The gates of your land","poem":1},{"text":"are wide open to your enemies;","poem":2},{"lineBreak":true},{"text":"fire consumes their bars.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Draw your water for the siege;","poem":1},{"text":"strengthen your fortresses.","poem":2},{"text":"Work the clay and tread the mortar;","poem":1},{"text":"repair the brick kiln!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"There the fire will devour you;","poem":1},{"text":"the sword will cut you down","poem":2},{"lineBreak":true},{"text":"and consume you like a young locust.","poem":2},{"text":"Make yourself many like the young locust;","poem":1},{"text":"make yourself many like the swarming locust!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"You have multiplied your merchants","poem":1},{"text":"more than the stars of the sky.","poem":2},{"text":"The young locust strips the land","poem":1},{"text":"and flies away.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Your guards","poem":1},{"noteId":5},{"text":"are like the swarming locust,","poem":1},{"text":"and your scribes","poem":2},{"noteId":6},{"text":"like clouds of locusts","poem":2},{"lineBreak":true},{"text":"that settle on the walls on a cold day.","poem":2},{"text":"When the sun rises, they fly away,","poem":1},{"text":"and no one knows where.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O king of Assyria, your shepherds slumber;","poem":1},{"text":"your officers sleep.","poem":2},{"text":"Your people are scattered on the mountains","poem":1},{"text":"with no one to gather them.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"There is no healing for your injury;","poem":1},{"text":"your wound is severe.","poem":2},{"text":"All who hear the news of you","poem":1},{"text":"applaud your downfall,","poem":2},{"text":"for who has not experienced","poem":1},{"text":"your constant cruelty?","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Hebrew No-amon","reference":{"chapter":3,"verse":8}},{"noteId":4,"caller":"+","text":"That is, the upper Nile region","reference":{"chapter":3,"verse":9}},{"noteId":5,"caller":"+","text":"Or princes","reference":{"chapter":3,"verse":17}},{"noteId":6,"caller":"+","text":"Or marshals","reference":{"chapter":3,"verse":17}}]}}]}
