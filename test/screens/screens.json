      "path": "home/discover",
      "variants": ["default", "zh"]
    },
    {
      "name": "about-sda",
      "path": "home/about-sda",
      "variants": ["default", "es"]
    },
    {
      "name": "about-my-church",
      "path": "home/about-my-church",
      "variants": ["default", "zh"]
    },
    {
      "name": "give",
      "path": "home/give",
      "variants": ["default", "zh", "es"]
    },
    {
      "name": "you",
      "path": "you",
      "variants": ["default", "dark", "large", "zh"]
    },
    {
      "name": "privacy",
      "path": "you/privacy",
      "variants": ["default"]
    },
    {
