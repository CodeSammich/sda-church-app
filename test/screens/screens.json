      "path": "explore/library",
      "variants": ["default", "dark", "zh", "zh-cn", "es"]
    },
    {
      "name": "library-egw",
      "path": "explore/library/egw",
      "variants": ["default", "zh"]
    },
    {
      "name": "library-classics",
      "path": "explore/library/christian-classics",
      "variants": ["default"]
    },
    {
      "name": "sabbath-school",
      "path": "sabbath-school",
      "variants": ["default", "zh", "es"]
    },
    {
