{
  "$comment": "The app's key screens, captured from each platform's preview build (#331). Each screen opens by deep link (sdachurchapp://<path>) after its settings are saved; each variant adds the settings listed under variants. Screenshots are named <platform>/<screen>-<variant>.png. checks lists automatic image checks for a screen, mustShowLines regular expressions that some line of its text must match, and tabs false for a screen without the tab bar, such as the Bible while reading (scripts/check-screens.cjs); appStore lists, per App Store language, the shots to upload, in order. Leave out screens that show members' names or photos, such as the bulletin, the team page, the fellowship page, and the worship schedule. See docs/operations/native-builds.md.",
  "ios": {
    "device": "iPhone 17 Pro Max"
  },
  "variants": {
    "default": {},
    "dark": { "theme": "dark" },
    "large": { "textScale": 1.5 },
    "xl": { "textScale": 2 },
    "ios-large-text": { "iosTextSize": "accessibility-large" },
    "zh": { "language": "zh" },
    "zh-cn": { "language": "zh-cn" },
    "es": { "language": "es" },
    "zh-dark": { "language": "zh", "theme": "dark" }
  },
  "screens": [
    {
      "name": "home",
      "path": "",
      "variants": ["default", "dark", "large", "ios-large-text", "zh", "zh-cn", "es"],
      "changesDaily": true
    },
    {
      "name": "bible",
      "path": "bible?bookId=PSA&chapter=23&translationId=BSB",
      "settings": { "dualLanguage": false, "pinyin": false },
      "variants": ["default", "dark", "large"]
    },
    {
      "name": "bible-dual",
      "path": "bible?bookId=PSA&chapter=23&translationId=BSB",
      "settings": { "dualLanguage": true, "supportingTranslation": "cmn_cuv", "pinyin": false },
      "variants": ["default", "dark", "large", "xl", "ios-large-text"]
    },
    {
      "name": "bible-dual-back",
      "$comment": "Opened from Home, so the header also has a back arrow and stacks sooner.",
      "path": "bible?bookId=PSA&chapter=23&translationId=BSB&backTo=%2F",
      "settings": { "dualLanguage": true, "supportingTranslation": "cmn_cuv", "pinyin": false },
      "variants": ["default", "large", "xl"]
    },
    {
      "name": "bible-cuv",
      "$comment": "Mandarin is the default narrator, so the audio button shows 國語.",
      "path": "bible?bookId=PSA&chapter=23&translationId=cmn_cuv",
      "settings": { "dualLanguage": true, "supportingTranslation": "BSB", "pinyin": false },
      "variants": ["zh", "zh-dark"],
      "mustShowLines": ["國語"]
    },
    {
      "name": "bible-cuv-cantonese",
      "$comment": "With the Cantonese narrator chosen, the audio button shows 粵語.",
      "path": "bible?bookId=PSA&chapter=23&translationId=cmn_cuv",
      "settings": {
        "dualLanguage": true,
        "supportingTranslation": "BSB",
        "pinyin": false,
        "audioReaders": { "cuv": "粵語 (WordProject)" }
      },
      "variants": ["zh"],
      "mustShowLines": ["粵語"]
    },
    {
      "name": "bible-cuvs",
      "$comment": "Simplified characters, so the audio button shows 国语.",
      "path": "bible?bookId=PSA&chapter=23&translationId=cmn_cu1",
      "settings": { "dualLanguage": true, "supportingTranslation": "BSB", "pinyin": false },
      "variants": ["zh-cn"],
      "mustShowLines": ["国语"]
    },
    {
      "name": "bible-pinyin",
      "path": "bible?bookId=JHN&chapter=3&translationId=cmn_cuv",
      "settings": { "dualLanguage": true, "supportingTranslation": "BSB", "pinyin": true },
      "variants": ["default", "zh", "large"]
    },
    {
      "name": "bible-scrolled",
      "tabs": false,
      "$comment": "Opens at John 3:14, so earlier verses sit under the status bar; checks it stays clear.",
      "path": "bible?bookId=JHN&chapter=3&translationId=BSB&verseStart=14&verseEnd=16",
      "settings": { "dualLanguage": true, "supportingTranslation": "cmn_cuv", "pinyin": true },
      "variants": ["default", "large", "dark"],
      "checks": ["statusBarClear"],
      "mustShowLines": ["^14\\b", "^15\\b", "^16\\b"]
    },
    {
      "name": "bible-long-chapter",
      "tabs": false,
      "$comment": "Psalm 119 from verse 100, for three-digit verse numbers at large text sizes.",
      "path": "bible?bookId=PSA&chapter=119&translationId=BSB&verseStart=100&verseEnd=100",
      "settings": { "dualLanguage": false, "pinyin": false },
      "variants": ["default", "xl", "ios-large-text"],
      "checks": ["statusBarClear"],
      "mustShowLines": ["^100\\b", "^101\\b", "^102\\b"]
    },
    {
      "name": "bible-spanish",
      "path": "bible?bookId=JHN&chapter=3&translationId=spa_r09",
      "settings": { "dualLanguage": false, "pinyin": false },
      "variants": ["es"]
    },
    {
